{
  "name": "botang-website",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "format": "prettier --write . && node scripts/code-style.mjs --write",
    "format:check": "node scripts/code-style.mjs && prettier --check .",
    "verify": "npm run format:check && npm run check:type && npm run check && npm run check:content && npm test && npm run build && npm run check:output && npm run check:budget",
    "check:content": "node scripts/check-content.mjs",
    "check:type": "node scripts/type-system.mjs",
    "check:output": "node scripts/check-output.mjs",
    "check:budget": "node scripts/performance-budget.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "portrait": "node scripts/portrait-pixels.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "linkedom": "0.18.13",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  }
}
