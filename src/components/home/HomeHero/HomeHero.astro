---
import { Image } from 'astro:assets';
import '@fontsource-variable/bodoni-moda/opsz.css';
import ArrowLink from '../../ui/ArrowLink.astro';
import ResearchNavigator from '../ResearchNavigator/ResearchNavigator.astro';
import ContactLinks from '../../ui/ContactLinks.astro';
import { routes } from '../../../data/navigation';
import { profile } from '../../../data/profile';
import { blueInk } from './blue-ink';
import portrait from '../../../assets/bo-tang.jpg';
import portraitPixels from '../../../assets/portrait-pixels.png';

// The blue ink's range for each colour channel, as the SVG filter's lookup tables.
const [inkRed, inkGreen, inkBlue] = blueInk.dark.map((dark, i) => `${dark} ${blueInk.light[i]}`);
---

<section class="hero shell page-grid" aria-labelledby="hero-name" data-home-motion>
  {/* The pixel picture is named only in a data attribute, which the browser would find only once the
      opening's script reads it; fetched from the start, it is in hand as the portrait is. */}
  <link rel="preload" as="image" href={portraitPixels.src} fetchpriority="high" />
  <div class="identity">
    <div class="portrait-block">
      <Image
        src={portrait}
        widths={[256, 480, 640]}
        sizes="(max-width: 720px) 240px, 280px"
        width={640}
        alt="Bo Tang, seated at a table against a dark background."
        loading="eager"
        fetchpriority="high"
        class="portrait"
      />
      <Image
        src={portrait}
        widths={[256, 480, 640]}
        sizes="(max-width: 720px) 240px, 280px"
        width={640}
        alt=""
        aria-hidden="true"
        loading="eager"
        class="portrait-ink"
      />
      <canvas class="portrait-signal" data-portrait-signal aria-hidden="true"></canvas>
      <canvas
        class="portrait-develop"
        data-portrait-develop
        data-portrait-pixels={portraitPixels.src}
        aria-hidden="true"
      ></canvas>
      <h1 id="hero-name" class="signal-slices" aria-label="Bo Tang" data-signal-text="Bo Tang">
        <span class="name-base">Bo Tang</span>
      </h1>
      <div class="name-marks" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
    <ContactLinks />
    <svg class="ink-filter" aria-hidden="true" width="0" height="0">
      <defs>
        <filter id="portrait-blue-ink" color-interpolation-filters="sRGB">
          <feColorMatrix
            type="matrix"
            values=".2126 .7152 .0722 0 0 .2126 .7152 .0722 0 0 .2126 .7152 .0722 0 0 0 0 0 1 0"
          />
          <feComponentTransfer>
            <feFuncR type="table" tableValues={inkRed} />
            <feFuncG type="table" tableValues={inkGreen} />
            <feFuncB type="table" tableValues={inkBlue} />
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>
  </div>
  <div class="hero-copy">
    <div class="affiliation">
      <p class="label-text">{profile.role}</p>
      <a class="text-link" href={profile.institutionUrl}>
        <span class="link-label">{profile.institution}</span>
      </a>
    </div>
    <ResearchNavigator />
    <p class="hero-intro">
      <span class="intro-copy">
        I develop machine learning methods and scalable algorithms for mathematical optimization.
      </span>
      <span class="intro-typing" aria-hidden="true">
        <span data-intro-typed></span>
        <span class="intro-cursor"></span>
      </span>
    </p>
    <div class="hero-actions">
      <ArrowLink href={routes.research}>View research</ArrowLink>
    </div>
  </div>
</section>

<script>
  import './hero-motion';
</script>

<style>
  /* The portrait fills columns 2 to 4 and splits two thirds of the way down: the photograph
     above, and below it the blue third, shifted right by --ink-shift. The name starts on column 1,
     reaching across the portrait; ContactLinks sits under the blue third. The copy starts on
     column 6, level with the portrait's top. */
  .hero {
    --contact-links-offset: var(--ink-shift);
    --contact-links-width: 100%;
    --ink-height: 33.334%;
    --ink-shift: 18px;
    --ink-top: 66.666%;
    align-items: start;
    padding-top: var(--step-64);
  }
  .identity {
    display: grid;
    grid-column: var(--zone-side);
    grid-template-columns: subgrid;
    min-width: 0;
  }
  /* The name and its marks start one column and one gap left of the portrait: column 1's edge. */
  .portrait-block {
    --name-offset: calc((100% - 2 * var(--column-gap)) / 3 + var(--column-gap));
    isolation: isolate;
    position: relative;
    grid-column: var(--zone-portrait);
    aspect-ratio: 2 / 3;
  }
  .identity :global(.contact-links) {
    grid-column: var(--zone-portrait);
  }
  .portrait-block :global(.portrait) {
    clip-path: inset(0 0 var(--ink-height));
  }
  .portrait-block :global(.portrait),
  .portrait-block :global(.portrait-ink) {
    display: block;
    height: 100%;
    object-fit: contain;
    width: 100%;
  }
  .portrait-block :global(.portrait-ink) {
    inset: 0;
    position: absolute;
    clip-path: inset(var(--ink-top) 0 0);
    filter: url('#portrait-blue-ink');
    transform: translateX(var(--ink-shift));
    pointer-events: none;
  }
  .ink-filter {
    position: absolute;
    pointer-events: none;
  }
  .portrait-signal {
    inset: var(--ink-top) 0 0;
    position: absolute;
    height: var(--ink-height);
    width: 100%;
    opacity: 0;
    transform: translateX(var(--ink-shift));
  }
  .portrait-develop {
    inset: 0;
    position: absolute;
    height: 100%;
    width: 100%;
    pointer-events: none;
  }
  [data-motion-ready] .portrait-signal[data-image-ready] {
    opacity: 1;
  }
  h1 {
    left: calc(-1 * var(--name-offset));
    position: absolute;
    top: var(--ink-top);
    z-index: 1;
    margin: -0.04em 0 0; /* optical: the capitals' tops on the split */
    font-family: var(--font-serif);
    font-optical-sizing: none;
    font-size: var(--type-name);
    font-variation-settings: 'opsz' 96;
    letter-spacing: var(--tracking-display);
    line-height: var(--line-name);
    white-space: nowrap;
    color: var(--paper);
  }
  /* The opening's scrambled letters, laid over the name by name-scramble.ts. */
  h1 :global(.name-scramble) {
    inset: 0;
    position: absolute;
    pointer-events: none;
  }
  h1 :global(.name-scramble-glyph) {
    position: absolute;
    top: 0;
    color: var(--paper);
  }
  h1 :global(.name-scramble-glyph[data-light]) {
    color: var(--signal-light);
  }
  h1 :global(.name-scramble-glyph[data-echo]) {
    text-shadow: -2px 0 var(--blue);
  }
  h1 :global(.name-scramble-block) {
    position: absolute;
    background: var(--blue);
  }
  h1 :global(.name-scramble-block[data-tone='light']) {
    background: var(--signal-light);
  }
  h1 :global(.name-scramble-block[data-tone='ink']) {
    background: var(--ink);
  }
  .name-marks {
    left: calc(-1 * var(--name-offset));
    position: absolute;
    top: calc(var(--ink-top) + var(--line-name));
    z-index: 2;
    align-items: center;
    display: flex;
    gap: 5px; /* optical: the marks' own spacing, part of the signal */
    height: 12px;
    pointer-events: none;
  }
  .name-marks span {
    display: block;
    height: 6px;
    width: 6px;
    background: var(--blue);
    opacity: 0.65;
  }
  h1::before {
    text-shadow: -2px 0 var(--blue);
    clip-path: inset(30% 0 55%);
    color: var(--paper);
  }
  h1::after {
    clip-path: inset(61% 0 27%);
    color: var(--signal-light);
  }
  /* The copy runs from column 6 to 11, leaving column 12 empty; only the drifting research
     lanes reach across it. */
  .hero-copy {
    align-content: start;
    display: grid;
    grid-column: var(--zone-main-wide);
    grid-template-columns: subgrid;
    min-width: 0;
  }
  .hero-copy > * {
    grid-column: 1 / -2;
  }
  .hero-copy > :global(.research-navigator) {
    grid-column: 1 / -1;
  }
  .affiliation {
    margin-bottom: var(--step-64);
  }
  .affiliation p {
    margin: 0 0 var(--step-8);
    color: var(--muted);
  }
  .hero-intro {
    position: relative;
    margin: var(--step-64) 0 0;
    color: var(--muted);
  }
  .intro-typing {
    display: none;
  }
  [data-typing-ready] .intro-copy {
    color: transparent;
  }
  /* The typed letters lie over the sentence, which carries its text for reading and copying; the
     letters are not selectable, so a copy holds the sentence once. */
  [data-typing-ready] .intro-typing {
    inset: 0;
    position: absolute;
    display: block;
    user-select: none;
  }
  .intro-cursor {
    left: 100%;
    position: absolute;
    top: 0.12em;
    display: inline-block;
    height: 1em;
    margin-left: 3px; /* optical: the cursor just clear of the last letter */
    width: 2px;
    vertical-align: -0.14em;
    background: var(--blue);
  }
  [data-intro-waiting] .intro-cursor {
    visibility: hidden;
  }
  .intro-cursor[data-at-start] {
    left: 0;
  }
  /* Letters laid out by intro-typing.ts, revealed one by one. */
  .intro-typing :global(.intro-word) {
    white-space: nowrap;
  }
  .intro-typing :global(.intro-letter) {
    position: relative;
  }
  .intro-typing :global(.intro-letter[data-unseen]) {
    visibility: hidden;
  }
  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--step-8) var(--step-32);
    justify-content: space-between;
    margin-top: var(--step-32);
  }
  @media (prefers-reduced-motion: no-preference) {
    .name-marks span {
      animation: signal-marks-hop 2.7s steps(1, end) infinite;
    }
    .name-marks span:nth-child(2) {
      animation-delay: -1.1s;
      animation-duration: 3.1s;
    }
    .name-marks span:nth-child(3) {
      animation-delay: -0.6s;
      animation-duration: 2.3s;
    }
    [data-motion-suspended] .name-marks span {
      animation-play-state: paused;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-slip] h1 {
      animation: signal-name-distort var(--signal-burst) steps(1, end) both;
    }
    [data-slip] h1::before {
      animation: signal-name-slip-upper var(--signal-burst) steps(1, end) both;
    }
    [data-slip] h1::after {
      animation: signal-name-slip-lower var(--signal-burst) steps(1, end) both;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .intro-cursor {
      animation: intro-cursor-blink 1.1s step-end infinite;
    }
    [data-motion-suspended] .intro-cursor {
      animation-play-state: paused;
    }
    [data-typing] .intro-cursor {
      animation: none;
    }
  }
  @keyframes intro-cursor-blink {
    0%,
    55%,
    100% {
      opacity: 1;
    }
    56%,
    99% {
      opacity: 0;
    }
  }
  /* Between tablet and desktop the portrait's three columns are too narrow for four labels in a
     row, so the links take two rows. */
  @media (max-width: 900px) and (min-width: 721px) {
    .identity :global(.contact-links) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    /* In one column the portrait stands in the middle: the photograph with its shifted blue third
       is centred as one, the name still reaching out past its left edge, and the contact links
       below follow the blue third. */
    .hero {
      --contact-links-offset: calc(var(--portrait-inset) + var(--ink-shift));
      --contact-links-width: var(--portrait-width);
      --portrait-inset: calc((100cqw - var(--portrait-width) - var(--ink-shift)) / 2);
      --portrait-width: 15rem;
      row-gap: var(--step-32);
      padding-top: var(--step-24);
    }
    /* The column is the container, so the inset reads the same wherever it is used. */
    .identity {
      display: block;
      container-type: inline-size;
    }
    /* The name reaches out to the text's left edge, whatever the phone's width. */
    .portrait-block {
      --name-offset: var(--portrait-inset);
      margin-left: var(--portrait-inset);
      width: var(--portrait-width);
    }
    .hero-copy {
      display: block;
    }
    .affiliation {
      margin-bottom: var(--step-48);
    }
    .hero-intro {
      margin-top: var(--step-48);
    }
    .hero-actions {
      margin-top: var(--step-24);
    }
  }
</style>
