---
import ArrowLink from '../ArrowLink.astro';
import { routes } from '../../data/navigation';
import { profile } from '../../data/profile';
---

<section class="about shell" id="about" aria-labelledby="about-title">
  <h2 class="section-label" id="about-title">
    About
  </h2>
  <div class="about-copy">
    <p>
      I am a postdoctoral associate at MIT Sloan, working with{' '}
      <a class="text-link text-link--inline" href={profile.supervisor.url}>
        <span class="link-label">{profile.supervisor.name}</span>
      </a>
      .
    </p>
    <p>
      My research lies at the intersection of machine learning and mathematical optimization, with a
      focus on learning for decision-making and scalable optimization algorithms.
    </p>
    <div class="about-action">
      <ArrowLink href={routes.about}>More about me</ArrowLink>
    </div>
  </div>
</section>

<style>
  .about {
    column-gap: var(--reading-column-gap);
    display: grid;
    grid-template-columns: var(--reading-label-column) minmax(0, 1fr);
    margin-top: 6rem;
    scroll-margin-top: 2rem;
  }
  .about-copy {
    max-width: 57ch;
  }
  .about-copy p {
    margin: 0 0 1rem;
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: var(--leading-prose);
    color: var(--muted);
  }
  .about-copy .text-link--inline {
    color: var(--paper);
  }
  .about-copy .text-link--inline:is(:hover, :focus-visible) {
    color: var(--blue);
  }
  .about-action {
    margin-top: 1.25rem;
  }
  @media (max-width: 720px) {
    .about {
      gap: 1.5rem;
      grid-template-columns: 1fr;
      margin-top: 4.5rem;
    }
  }
</style>
