---
import ArrowLink from '../ArrowLink.astro';
import ResourceLinks from '../ResourceLinks.astro';
import { routes } from '../../data/navigation';
import { selectedWork } from '../../data/selected-work';
---

<section class="selected-work shell" id="selected-work" aria-labelledby="work-title">
  <h2 class="section-label" id="work-title">
    Selected work
  </h2>
  <div class="work-list">
    {selectedWork.map((work) => (
      <article class="work-entry" aria-labelledby={`selected-${work.project.id}`}>
        <h3 class="work-name" id={`selected-${work.project.id}`}>
          {work.project.name}
        </h3>
        <div class="work-details">
          <p class="work-title">
            <a class="text-link" href={work.href}>
              <span class="link-label">{work.title}</span>
            </a>
          </p>
          <p class="work-note">{work.note}</p>
          <p class="work-description">{work.description}</p>
          <ResourceLinks links={work.links} context={work.title} />
        </div>
      </article>
    ))}
  </div>
  <div class="work-navigation">
    <ArrowLink href={routes.research}>All publications</ArrowLink>
    <ArrowLink href={routes.software}>All software</ArrowLink>
  </div>
</section>

<style>
  .selected-work {
    margin-top: 6.5rem;
    scroll-margin-top: 2rem;
  }
  h2 {
    padding-bottom: 1.5rem;
  }
  .work-entry {
    column-gap: var(--reading-column-gap);
    display: grid;
    grid-template-columns: var(--reading-label-column) minmax(0, 1fr);
    border-top: var(--rule-line);
    padding-block: 1.75rem 2rem;
  }
  .work-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 450;
    letter-spacing: -0.035em;
    line-height: 1.15;
    color: var(--blue);
  }
  .work-title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: var(--leading-compact);
    text-wrap: pretty;
  }
  .work-note {
    margin: 0.65rem 0 0;
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: var(--leading-body);
    color: var(--muted);
  }
  .work-description {
    margin: 1rem 0 0.85rem;
    max-width: 60ch;
    font-size: var(--text-sm);
    line-height: var(--leading-prose);
    color: var(--body-copy);
  }
  .work-navigation {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    justify-content: space-between;
    border-top: var(--rule-line);
    padding-top: 1rem;
  }
  @media (max-width: 720px) {
    .selected-work {
      margin-top: 4.5rem;
    }
    h2 {
      padding-bottom: 1.1rem;
    }
    .work-entry {
      gap: 1.2rem;
      grid-template-columns: 1fr;
      padding-block: 1.5rem 1.75rem;
    }
    .work-name {
      font-size: 1.75rem;
    }
    .work-title {
      font-size: var(--text-base);
    }
  }
</style>
