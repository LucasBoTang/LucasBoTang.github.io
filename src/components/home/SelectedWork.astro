---
import ProjectWordmark from '../catalogue/ProjectWordmark/ProjectWordmark.astro';
import WorkPreview from './WorkPreview/WorkPreview.astro';
import ResourceLinks from '../ui/ResourceLinks.astro';
import { selectedWork } from '../../data/selected-work';
---

<section class="selected-work shell" id="selected-work" aria-labelledby="work-heading">
  <h2 class="section-label work-heading" id="work-heading" data-opening-part="work-heading">
    Selected work
  </h2>
  <div class="work-list">
    {selectedWork.map((work) => (
      <article
        class="work-entry page-grid"
        aria-labelledby={`selected-${work.project.id}`}
        data-opening-part="work-entry"
        data-arrival="cascade"
        data-project-host
        data-paper-entry
        data-lit
      >
        <WorkPreview project={work.project.id} name={work.project.name}>
          <ProjectWordmark
            name={work.project.name}
            id={`selected-${work.project.id}`}
            wordmark={work.project.wordmark}
          />
        </WorkPreview>
        <div class="work-details">
          <p class="work-title heading-text">
            <a class="work-title-link paper-title-link" href={work.href}>
              {work.title}
            </a>
          </p>
          <p class="work-note label-text">{work.note}</p>
          <p class="work-description">{work.description}</p>
          <ResourceLinks links={work.links} context={work.title} />
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* A rule opens the section and the label sits under it. Each entry sets its wordmark like a
     plate in the middle of columns 1 to 5, and its details from column 6. */
  .selected-work {
    margin-top: var(--section-space);
    scroll-margin-top: var(--anchor-item-offset);
  }
  .work-heading {
    border-top: var(--rule-line);
    padding-top: var(--step-24);
  }
  .work-list {
    isolation: isolate;
    position: relative;
  }
  .work-entry {
    --project-align: center;
    --project-height: 0px;
    --project-origin: center;
    align-items: start;
    padding-block: var(--step-64);
  }
  .work-entry + .work-entry {
    background: var(--item-rule);
  }
  .work-entry :global(.work-preview) {
    align-self: stretch;
    grid-column: var(--zone-side);
  }
  .work-details {
    position: relative;
    grid-column: var(--zone-main);
  }
  .work-title {
    margin: 0;
    text-wrap: pretty;
  }
  /* A venue can run to two lines, so it takes the label's leading for blocks. */
  .work-note {
    margin: var(--step-16) 0 0;
    line-height: var(--line-label-block);
    color: var(--muted);
  }
  .work-description {
    margin: var(--step-24) 0;
    color: var(--body-copy);
  }
  @media (max-width: 720px) {
    /* In one column the wordmark stays a centred plate above its text, as on a wide screen. */
    .work-entry {
      row-gap: var(--step-24);
      padding-block: var(--step-32);
    }
  }
</style>
