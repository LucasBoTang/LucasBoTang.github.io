---
import ProjectWordmark from '../catalogue/ProjectWordmark/ProjectWordmark.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import ResourceLinks from '../ui/ResourceLinks.astro';
import { routes } from '../../data/navigation';
import { selectedWork } from '../../data/selected-work';
---

<section class="selected-work shell" id="selected-work" aria-labelledby="work-heading">
  <h2 class="section-label work-heading" id="work-heading" data-opening-part="work-heading">
    Selected work
  </h2>
  <div class="work-list">
    {selectedWork.map((work) => (
      <article
        class="work-entry"
        aria-labelledby={`selected-${work.project.id}`}
        data-opening-part="work-entry"
        data-arrival="cascade"
        data-project-host
        data-lit
      >
        <ProjectWordmark
          name={work.project.name}
          id={`selected-${work.project.id}`}
          wordmark={work.project.wordmark}
        />
        <div class="work-details">
          <p class="work-title">
            <a class="work-title-link" href={work.href}>
              {work.title}
            </a>
          </p>
          <p class="work-note">{work.note}</p>
          <p class="work-description">{work.description}</p>
          <ResourceLinks links={work.links} context={work.title} />
        </div>
      </article>
    ))}
  </div>
  <div class="work-navigation" data-opening-part="work-navigation">
    <ArrowLink href={routes.research}>All publications</ArrowLink>
    <ArrowLink href={routes.software}>All software</ArrowLink>
  </div>
</section>

<style>
  .selected-work {
    margin-top: 6.5rem;
    scroll-margin-top: 2rem;
  }
  .work-heading {
    padding-bottom: var(--space-6);
  }
  .work-list {
    isolation: isolate;
    position: relative;
    border-top: 1px solid var(--rule-accent);
  }
  .work-entry {
    column-gap: var(--reading-column-gap);
    display: grid;
    grid-template-columns: var(--reading-label-column) minmax(0, 1fr);
    padding-block: 2.25rem var(--space-10);
  }
  .work-details {
    position: relative;
    padding-right: clamp(1.5rem, 3vw, 3rem);
  }
  .work-entry + .work-entry .work-details::before {
    content: '';
    left: 0;
    position: absolute;
    right: 0;
    top: -2.25rem;
    height: 1px;
    background: var(--rule-accent);
  }
  .work-title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: var(--leading-compact);
    text-wrap: pretty;
  }
  .work-title-link {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .work-title-link:is(:hover, :focus-visible) {
    color: var(--blue);
  }
  .work-note {
    margin: 0.65rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-body);
    text-transform: uppercase;
    color: var(--muted);
  }
  .work-description {
    margin: var(--space-4) 0 0.85rem;
    max-width: 60ch;
    font-size: var(--text-sm);
    line-height: var(--leading-prose);
    color: var(--body-copy);
  }
  .work-navigation {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    justify-content: space-between;
    border-top: var(--rule-line);
    padding-top: var(--space-4);
  }
  @media (max-width: 720px) {
    .selected-work {
      margin-top: 3.5rem;
    }
    .work-heading {
      padding-bottom: 1.1rem;
    }
    .work-entry {
      gap: var(--space-4);
      grid-template-columns: 1fr;
      padding-block: var(--space-6) var(--space-7);
    }
    .work-entry + .work-entry {
      border-top: 1px solid var(--rule-accent);
    }
    .work-entry + .work-entry .work-details::before {
      display: none;
    }
    .work-details {
      padding-right: 0;
    }
    .work-title {
      font-size: var(--text-base);
    }
  }
</style>
