---
import { Image } from 'astro:assets';
import '@fontsource-variable/syne';
import ArrowLink from '../ArrowLink.astro';
import { routes } from '../../data/navigation';
import { profile } from '../../data/profile';
import { featuredResearchAreas, getResearchAreaHref } from '../../data/research';
import portrait from '../../assets/bo-tang.jpg';
---

<section class="hero shell" aria-labelledby="hero-name">
  <h1 id="hero-name" aria-label={profile.name}>
    <span class="name-first">Bo</span> <span class="name-last">Tang</span>
  </h1>
  <div class="portrait-block">
    <Image
      src={portrait}
      widths={[256, 480, 640]}
      sizes="(max-width: 900px) 240px, 256px"
      width={640}
      alt="Bo Tang, seated at a table against a dark background."
      loading="eager"
      fetchpriority="high"
      class="portrait"
    />
  </div>
  <div class="affiliation">
    <p>{profile.role}</p>
    <a class="text-link" href={profile.institutionUrl}>
      <span class="link-label">{profile.institution}</span>
    </a>
  </div>
  <div class="hero-copy">
    <ul class="research-topics" aria-label="Research interests">
      {featuredResearchAreas.map((area) => (
        <li>
          <a class="text-link" href={getResearchAreaHref(area)}>
            <span class="link-label">{area.title}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="hero-intro">
      I develop machine learning methods and scalable algorithms for mathematical optimization.
    </p>
    <div class="hero-action">
      <ArrowLink href={routes.research}>View research</ArrowLink>
    </div>
  </div>
</section>

<style>
  .hero {
    --name-offset: 2.75rem;
    --portrait-width: 16rem;
    align-items: start;
    column-gap: var(--reading-column-gap);
    display: grid;
    grid-template-areas: 'name affiliation' 'portrait introduction';
    grid-template-columns: var(--reading-label-column) minmax(0, 1fr);
    row-gap: 1.75rem;
    padding-top: clamp(2rem, 3vw, 3rem);
  }
  h1 {
    grid-area: name;
    margin: 0;
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.9;
    color: var(--blue);
  }
  .name-first,
  .name-last {
    display: block;
  }
  .name-last {
    margin-left: var(--name-offset);
  }
  .portrait-block {
    position: relative;
    grid-area: portrait;
    margin: 0 0 0 var(--name-offset);
    width: min(var(--portrait-width), calc(100% - var(--name-offset)));
  }
  .portrait-block::after {
    content: '';
    left: 100%;
    position: absolute;
    top: 0;
    height: 1px;
    width: 1.75rem;
    background: var(--blue);
    opacity: 0.45;
  }
  .portrait-block :global(.portrait) {
    display: block;
    height: auto;
    width: 100%;
  }
  .affiliation {
    align-self: end;
    grid-area: affiliation;
    padding-bottom: 0.2rem;
    font-size: var(--text-sm);
    line-height: var(--leading-prose);
  }
  .affiliation p {
    margin: 0 0 0.3rem;
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .hero-copy {
    grid-area: introduction;
    max-width: 32rem;
  }
  .research-topics {
    margin: -0.35rem 0 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 450;
    letter-spacing: -0.03em;
    line-height: var(--leading-compact);
    list-style: none;
  }
  .research-topics li + li {
    margin-top: 0.25rem;
  }
  .research-topics a {
    display: inline-block;
    padding-block: 0.2rem;
  }
  .hero-intro {
    margin: 1.75rem 0 0;
    max-width: 43ch;
    font-size: var(--text-base);
    line-height: var(--leading-prose);
    color: var(--muted);
  }
  .hero-action {
    margin-top: 1.75rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero {
      animation: hero-arrive 640ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .research-topics a {
      transition:
        color 180ms ease,
        transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .research-topics a:is(:hover, :focus-visible) {
      transform: translateX(3px);
    }
    .research-topics a:active {
      transform: translateX(5px);
    }
    @keyframes hero-arrive {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
  @media (max-width: 900px) {
    .hero {
      --name-offset: 2rem;
      --portrait-width: 15rem;
    }
    h1 {
      font-size: 4rem;
    }
    .research-topics {
      font-size: 1.5rem;
    }
    .hero-intro {
      font-size: var(--text-sm);
    }
  }
  @media (max-width: 720px) {
    .hero {
      grid-template-areas: 'name' 'portrait' 'affiliation' 'introduction';
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.5rem;
      padding-top: 1.75rem;
    }
    .portrait-block::after {
      display: none;
    }
    .affiliation {
      margin-top: 0.25rem;
      padding-bottom: 0;
    }
    .hero-copy {
      margin-top: 0.75rem;
    }
    .research-topics {
      font-size: clamp(1.05rem, 4.9vw, 1.4rem);
    }
    .hero-intro {
      margin-top: 1.3rem;
    }
    .hero-action {
      margin-top: 1.3rem;
    }
  }
</style>
