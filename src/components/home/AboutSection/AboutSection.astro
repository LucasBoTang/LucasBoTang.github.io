---
import DecisionSign from './DecisionSign.astro';
import ArrowLink from '../../ui/ArrowLink.astro';
import { routes } from '../../../data/navigation';
import { profile } from '../../../data/profile';
---

<section
  class="about shell page-grid"
  id="about"
  aria-labelledby="about-title"
  data-opening-part="about"
>
  <h2 class="section-label" id="about-title">
    About
  </h2>
  <div class="about-fields">
    <DecisionSign />
  </div>
  <div class="about-copy">
    <p>
      I am a postdoctoral associate at MIT Sloan, working with{' '}
      <a class="text-link text-link--inline" href={profile.supervisor.url}>
        <span class="link-label">{profile.supervisor.name}</span>
      </a>
      .
    </p>
    <p>
      I develop machine learning methods and scalable algorithms for mathematical optimization, with
      a focus on GPU-accelerated optimization, learning to optimize, and decision-focused learning.
    </p>
  </div>
  <div class="about-action">
    <ArrowLink href={routes.about}>More about me</ArrowLink>
  </div>
</section>

<style>
  /* The copy runs over columns 1 to 7 and the sign hangs in columns 9 to 11, the mirror of the
     portrait's columns, so the page ends turning the other way from the hero and the work. */
  .about {
    align-items: start;
    margin-top: var(--step-160);
    scroll-margin-top: 2rem;
  }
  .about > h2 {
    grid-column: var(--zone-full);
    border-top: var(--rule-line);
    margin-bottom: var(--step-64);
    padding-top: var(--step-24);
  }
  /* Like the wordmarks above, the sign is set in the middle of its field: here, level with the
     middle of the copy. */
  .about-fields {
    align-self: center;
    grid-column: var(--zone-plate);
    grid-row: 2;
  }
  .about-copy {
    grid-column: var(--zone-lead-wide);
    grid-row: 2;
  }
  .about-copy p {
    margin: 0;
    color: var(--muted);
  }
  .about-copy p + p {
    margin-top: var(--step-24);
  }
  .about-copy .text-link--inline {
    white-space: nowrap;
  }
  /* The link follows on a row of its own, so the sign centres on the two paragraphs alone. */
  .about-action {
    display: flex;
    grid-column: var(--zone-lead-wide);
    grid-row: 3;
    justify-content: flex-start;
    margin-top: var(--step-32);
  }
  @media (max-width: 720px) {
    .about {
      margin-top: var(--step-96);
    }
    .about > h2 {
      margin-bottom: var(--step-32);
    }
    /* In one column the sign runs the width of the text above it, edge to edge. */
    .about-fields {
      grid-row: 4;
      margin-top: var(--step-48);
    }
  }
</style>
