---
import DecisionSign from './DecisionSign.astro';
import ArrowLink from '../../ui/ArrowLink.astro';
import { routes } from '../../../data/navigation';
import { profile } from '../../../data/profile';
import { conferenceResources } from '../../../data/resources';
---

<section
  class="about shell page-grid"
  id="about"
  aria-labelledby="about-title"
  data-opening-part="about"
>
  <h2 class="section-label" id="about-title">
    About
  </h2>
  <div class="about-fields">
    <DecisionSign />
  </div>
  <div class="about-copy">
    <p>
      I currently work with{' '}
      <a class="text-link text-link--inline about-person" href={profile.supervisor.url}>
        <span class="link-label">{profile.supervisor.name}</span>
      </a>
      {
        ' at MIT Sloan. I received my PhD in Operations Research from the University of Toronto in 2025, advised by '
      }
      <a class="text-link text-link--inline about-person" href={profile.doctoralAdvisor.url}>
        <span class="link-label">{profile.doctoralAdvisor.name}</span>
      </a>
      {
        '. During my PhD, I spent summer 2023 as a research intern at Pacific Northwest National Laboratory, working with '
      }
      <a class="text-link text-link--inline about-person" href={profile.internshipCollaborator.url}>
        <span class="link-label">{profile.internshipCollaborator.name}</span>
      </a>
      {'.'}
    </p>
    <p>
      I'll be at the{' '}
      <a class="text-link text-link--inline" href={conferenceResources.informs2026.meeting}>
        <span class="link-label">2026 INFORMS Annual Meeting</span>
      </a>
      {' in San Francisco, November 1–4, presenting my work on '}
      <a
        class="text-link text-link--inline"
        href={conferenceResources.informs2026.talk}
        title="November 3, 4:15–4:27pm, San Francisco time · Moscone South, Room 215"
      >
        <span class="link-label">GPU-accelerated linear programming</span>
      </a>
      {' and joining a panel on '}
      <a
        class="text-link text-link--inline"
        href={conferenceResources.informs2026.panel}
        title="November 1, 2:45–4pm, San Francisco time · Marriott Marquis, Sierra A"
      >
        <span class="link-label">GPU-accelerated optimization</span>
      </a>
      {'.'} If you're attending, I'd be happy to connect.
    </p>
  </div>
  <div class="about-action">
    <ArrowLink href={routes.about} direction="forward">
      More about me
    </ArrowLink>
  </div>
</section>

<style>
  /* The copy spans columns 2 to 7. The sign occupies columns 9 to 11. */
  .about {
    align-items: start;
    margin-top: var(--section-space);
    scroll-margin-top: var(--anchor-item-offset);
  }
  .about > h2 {
    grid-column: var(--zone-full);
    border-top: var(--rule-line);
    margin-bottom: var(--step-64);
    padding-top: var(--step-24);
  }
  /* Like the wordmarks above, the sign is set in the middle of its field: here, level with the
     middle of the copy. */
  .about-fields {
    align-self: center;
    grid-column: var(--zone-plate);
    grid-row: 2;
  }
  .about-copy {
    grid-column: var(--zone-lead-inset);
    grid-row: 2;
  }
  .about-copy p {
    margin: 0;
    color: var(--muted);
  }
  .about-copy p + p {
    margin-top: var(--step-24);
  }
  .about-copy .about-person {
    white-space: nowrap;
  }
  /* The link follows on a row of its own, so the sign centres on the two paragraphs alone. */
  .about-action {
    display: flex;
    grid-column: var(--zone-lead-inset);
    grid-row: 3;
    justify-content: flex-start;
    margin-top: var(--step-32);
  }
  @media (max-width: 720px) {
    .about > h2 {
      margin-bottom: var(--step-32);
    }
    /* In one column the sign runs the width of the text above it, edge to edge. */
    .about-fields {
      grid-row: 4;
      margin-top: var(--step-48);
    }
  }
</style>
