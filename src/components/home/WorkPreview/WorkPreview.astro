---
import { workPreviews } from '../../../data/research/figures';
import previewSignal from './preview-signal.svg?url&no-inline';

interface Props {
  project: string;
  name: string;
}
const { project, name } = Astro.props;
const preview = workPreviews[project as keyof typeof workPreviews];
// Warm the same row-displacement filters used by the acquisition keyframe.
const pull = `url("${previewSignal}#preview-pull")`;
const catchUp = `url("${previewSignal}#preview-catch")`;
const warmFilters = [['none', pull, catchUp, 'none']];
---

<a
  class="work-preview"
  href={preview.href}
  aria-label={`Explore ${name} on Research`}
  data-figure-preview
  data-preview-src={preview.src}
  data-preview-width={preview.width}
  data-preview-height={preview.height}
  data-preview-bleed={preview.bleed}
  data-warm-filters={JSON.stringify(warmFilters)}
  style={`--preview-signal-pull:${pull};--preview-signal-catch:${catchUp}`}
>
  <slot />
  <span class="work-preview-picture" aria-hidden="true">
    <span class="work-preview-signal"></span>
  </span>
</a>

<script>
  import './work-preview';
</script>

<style>
  .work-preview {
    --project-hover-scale: 1;
    position: relative;
    display: grid;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }
  /* The station mark yields first; picture luminance settles before playback starts.
     Transitions reverse from the current frame when the pointer changes its mind. */
  .work-preview :global([data-project-wordmark]) {
    align-self: center;
    opacity: 1;
    transition: opacity 240ms 80ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .work-preview-picture {
    inset: -48px 0;
    position: absolute;
    overflow: hidden;
    filter: brightness(0.55) contrast(0.8);
    opacity: 0;
    transition:
      opacity 240ms cubic-bezier(0.4, 0, 0.25, 1),
      filter 110ms ease-out;
    pointer-events: none;
  }
  .work-preview-signal {
    inset: 0;
    position: absolute;
  }
  .work-preview-picture :global(iframe) {
    left: 50%;
    position: absolute;
    top: 50%;
    border: 0;
    color-scheme: normal;
    transform: translate(-50%, -50%) scale(var(--preview-scale, 0));
  }
  .work-preview[data-preview-visible] :global([data-project-wordmark]) {
    opacity: 0;
    transition: opacity 220ms cubic-bezier(0.4, 0, 1, 1);
  }
  .work-preview[data-preview-visible] .work-preview-picture {
    filter: brightness(1) contrast(1);
    opacity: 1;
    transition:
      opacity 300ms 40ms cubic-bezier(0.22, 0.61, 0.36, 1),
      filter 380ms 40ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .work-preview[data-preview-acquiring] :global([data-project-wordmark]),
    .work-preview[data-preview-acquiring] .work-preview-signal {
      animation: signal-preview-acquire 170ms steps(1, end);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-preview :global([data-project-wordmark]),
    .work-preview-picture {
      transition: none;
    }
  }
  @media (max-width: 720px) {
    .work-preview {
      height: 160px;
    }
    .work-preview-picture {
      inset: 0;
    }
  }
</style>
