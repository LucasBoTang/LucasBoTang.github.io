---
import { routes } from '../data/navigation';
import { profile } from '../data/profile';
---

<footer class="site-footer shell">
  <div>
    <a class="footer-name" href={routes.home}>
      {profile.name}
    </a>
    <p>{profile.location}</p>
  </div>
  <div class="footer-links">
    <a class="text-link" href={`mailto:${profile.email}`}>
      <span class="link-label">{profile.email}</span>
    </a>
    <a class="text-link" href={profile.github}>
      <span class="link-label">GitHub</span>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    align-items: flex-end;
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    border-top: var(--rule-line);
    margin-top: 6rem;
    padding-block: 2.2rem 2.6rem;
    font-size: var(--text-xs);
  }
  .footer-name {
    font-weight: 600;
    text-decoration: none;
    color: var(--paper);
  }
  p {
    margin: 0.5rem 0 0;
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .footer-links {
    display: flex;
    gap: 2rem;
  }
  .footer-links a {
    color: var(--muted);
  }
  .footer-links a:is(:hover, :focus-visible) {
    color: var(--blue);
  }
  @media (max-width: 600px) {
    .site-footer {
      align-items: flex-start;
      margin-top: 4rem;
    }
    .footer-links {
      flex-direction: column;
      gap: 0.6rem;
    }
  }
</style>
