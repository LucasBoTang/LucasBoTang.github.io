---
import '@fontsource-variable/syne';
import ResourceLinks from './ResourceLinks.astro';
import type { SoftwareEntry, SoftwareVariant } from '../data/software';

interface Props {
  entry: SoftwareEntry;
  variant: SoftwareVariant;
}
const { entry, variant } = Astro.props;
---

<article
  class:list={['software-entry', { compact: variant === 'contribution' }]}
  id={entry.id}
  aria-labelledby={`${entry.id}-title`}
>
  <div class="entry-identity">
    <h3 id={`${entry.id}-title`}>{entry.name}</h3>
    {entry.role && <p class="entry-role">{entry.role}</p>}
  </div>
  <div class="entry-details">
    <p class="entry-description">{entry.description}</p>
    <ResourceLinks links={entry.links} context={entry.name} />
  </div>
</article>

<style>
  .software-entry {
    align-items: start;
    column-gap: var(--software-gap);
    display: grid;
    grid-template-columns: var(--software-columns);
    border-top: var(--rule-line);
    padding-block: 1.75rem;
    scroll-margin-top: 2.5rem;
  }
  h3 {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 2.5rem);
    font-weight: 450;
    letter-spacing: -0.04em;
    line-height: 1.12;
    color: var(--blue);
  }
  .entry-role {
    margin: 0;
    font-size: var(--text-xs);
    line-height: var(--leading-compact);
    color: var(--muted);
  }
  .entry-description {
    margin: 0 0 1rem;
    max-width: 58ch;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--body-copy);
  }
  .software-entry.compact {
    padding-block: 1.25rem;
  }
  .compact h3 {
    margin-bottom: 0;
    font-family: var(--font);
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: var(--leading-compact);
    color: var(--paper);
  }
  .compact .entry-details {
    align-items: baseline;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .compact .entry-description {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .software-entry {
      row-gap: 1rem;
      padding-block: 1.5rem;
    }
    .software-entry.compact {
      row-gap: 0.7rem;
    }
    .compact .entry-details {
      gap: 0.65rem;
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
