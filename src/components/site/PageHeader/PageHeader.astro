---
import '@fontsource-variable/bodoni-moda/opsz.css';

interface Props {
  title: string;
  /** One short line on what the page holds, in plain words. */
  description?: string;
}
const { title, description } = Astro.props;
---

<header class="page-header page-grid">
  <h1 data-reveal="title" aria-label={title}>
    <span class="title-signal signal-slices" data-signal-text={title} aria-hidden="true">
      {title}
    </span>
  </h1>
  {/* Moving here from another page: before this page first shows, the title takes the last page's
      title, which SiteLayout kept as that page left, and title-decode.ts then rewrites it. */}
  <script is:inline>
    (() => {
      const title = document.currentScript.previousElementSibling;
      try {
        const entry = JSON.parse(sessionStorage.getItem('page-title-from') ?? 'null');
        sessionStorage.removeItem('page-title-from');
        if (!entry || entry.to !== location.href.split('#')[0] || Date.now() - entry.at > 4000)
          return;
        title.dataset.titleFrom = entry.title;
        title.firstElementChild.textContent = entry.title || ' ';
      } catch {}
    })();
  </script>
  {description?.trim() && <p data-reveal="lead">{description.trim()}</p>}
</header>

<script>
  import './title-decode';
  import './title-signal';
</script>

<style>
  /* The title in Display from column 1, and the lead right under it, free to run over seven
     columns and wrap. */
  .page-header {
    row-gap: var(--step-32);
    padding-block: var(--step-64) var(--step-96);
  }
  h1 {
    grid-column: var(--zone-full);
    margin: 0;
    font-family: var(--font-serif);
    /* A sturdier cut than the display size: its hairlines hold up through the decode and glitch. */
    font-optical-sizing: none;
    font-size: var(--type-display);
    font-variation-settings: 'opsz' 32;
    letter-spacing: var(--tracking-display);
    line-height: var(--line-display);
    color: var(--blue);
  }
  .page-header p {
    grid-column: var(--zone-lead);
    margin: 0;
    text-wrap: balance;
    color: var(--muted);
  }
  /* A title being rewritten stands through the opening gate, so it never leaves the screen. */
  h1[data-title-from] {
    visibility: visible;
  }
  /* The decoding letters (title-decode.ts). A blink only dims a letter to a trace: at this size a
     letter gone reads as a hole in the word. A block flashes over it in a tone of the signal;
     `ink` erases. */
  h1 :global(.title-decode-glyph) {
    position: relative;
    display: inline-block;
  }
  h1 :global(.title-decode-glyph[data-noise]) {
    color: var(--signal-light);
  }
  h1 :global(.title-decode-glyph[data-blink]) {
    color: color-mix(in srgb, var(--signal-light) 25%, transparent);
  }
  h1 :global(.title-decode-glyph[data-echo]) {
    text-shadow: -2px 0 var(--signal-light);
  }
  h1 :global(.title-decode-glyph[data-block])::after {
    content: '';
    left: 0;
    position: absolute;
    right: 0;
    top: var(--block-top);
    height: var(--block-height);
    background: var(--blue);
  }
  h1 :global(.title-decode-glyph[data-block='light'])::after {
    background: var(--signal-light);
  }
  h1 :global(.title-decode-glyph[data-block='ink'])::after {
    background: var(--ink);
  }
  .title-signal {
    position: relative;
    display: inline-block;
  }
  .title-signal::before {
    text-shadow: -2px 0 var(--blue);
    clip-path: inset(30% 0 55%);
    color: var(--paper);
  }
  .title-signal::after {
    clip-path: inset(61% 0 27%);
    color: var(--signal-light);
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Its own layer in transitions between pages (see motion.css). */
    h1 {
      view-transition-name: page-title;
    }
    .title-signal[data-slip] {
      animation: signal-title-distort var(--signal-burst) steps(1, end) both;
    }
    .title-signal[data-slip]::before {
      animation: signal-title-slip-upper var(--signal-burst) steps(1, end) both;
    }
    .title-signal[data-slip]::after {
      animation: signal-title-slip-lower var(--signal-burst) steps(1, end) both;
    }
  }
  @media (max-width: 720px) {
    .page-header {
      row-gap: var(--step-16);
      padding-block: var(--step-24) var(--step-48);
    }
  }
</style>
