---
import '@fontsource-variable/bodoni-moda/opsz.css';
import HeaderRoll from './HeaderRoll.astro';
import { primaryNavigation, routes, type PageId } from '../../data/navigation';
import { profile } from '../../data/profile';

interface Props {
  page?: PageId;
}
const { page } = Astro.props;
---

<header class="site-header shell page-grid">
  <a
    class="site-header-name"
    href={routes.home}
    data-astro-prefetch
    aria-label={`${profile.name} — home`}
    aria-current={page === 'home' ? 'page' : undefined}
  >
    <span class="site-header-signal signal-slices" data-signal-text={profile.name}>
      {profile.name}
    </span>
    <span class="site-header-dot" aria-hidden="true">
      .
    </span>
  </a>
  <nav aria-label="Main navigation">
    {primaryNavigation.map((item, index) => (
      <a
        href={routes[item.page]}
        aria-current={item.page === page ? 'page' : undefined}
        data-astro-prefetch
      >
        <HeaderRoll direction={index % 2 ? 'up' : 'down'}>{item.label}</HeaderRoll>
      </a>
    ))}
  </nav>
</header>

<style>
  /* The name on column 1, and the pages flush right from column 6. */
  .site-header {
    align-items: baseline;
    padding-block: var(--step-32);
  }
  .site-header-name {
    grid-column: var(--zone-side);
    justify-self: start;
    font-family: var(--font-serif);
    font-size: var(--type-heading);
    letter-spacing: var(--tracking-title);
    line-height: var(--line-heading);
    text-decoration: none;
    color: var(--paper);
  }
  /* Hovering the name tears it once, as the home name tears: the links roll, but the name is the
     signal. Its colour stays. */
  .site-header-name:is(:hover, :focus-visible) {
    color: var(--paper);
  }
  .site-header-signal {
    position: relative;
    display: inline-block;
  }
  .site-header-signal::before {
    text-shadow: -2px 0 var(--blue);
    clip-path: inset(30% 0 55%);
    color: var(--paper);
  }
  .site-header-signal::after {
    clip-path: inset(61% 0 27%);
    color: var(--signal-light);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .site-header-name:is(:hover, :focus-visible) .site-header-signal {
      animation: signal-name-distort var(--signal-burst) steps(1, end) both;
    }
    .site-header-name:is(:hover, :focus-visible) .site-header-signal::before {
      animation: signal-name-slip-upper var(--signal-burst) steps(1, end) both;
    }
    .site-header-name:is(:hover, :focus-visible) .site-header-signal::after {
      animation: signal-name-slip-lower var(--signal-burst) steps(1, end) both;
    }
  }
  .site-header-dot {
    color: var(--blue);
  }
  /* The pages read flush right, a size up from the labels: the header's one row of choices. */
  nav {
    align-items: baseline;
    display: flex;
    gap: var(--step-32);
    grid-column: var(--zone-main-wide);
    justify-content: flex-end;
    font-family: var(--font-mono);
    font-size: var(--type-body);
    line-height: var(--line-body);
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
  }
  /* Hover only rolls the label (HeaderRoll), alternately down and up from link to link; the
     colour stays, and blue marks the current page alone. */
  nav a:is(:hover, :focus-visible) {
    color: var(--muted);
  }
  nav a[aria-current='page'] {
    color: var(--blue);
  }
  @media (max-width: 720px) {
    .site-header {
      row-gap: var(--step-8);
      padding-block: var(--step-24);
    }
    nav {
      flex-wrap: wrap;
      gap: 0 var(--step-24);
      justify-content: flex-start;
    }
  }
</style>
