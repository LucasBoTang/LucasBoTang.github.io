---
import '@fontsource-variable/bodoni-moda/opsz.css';
import ContactLinks from '../ui/ContactLinks.astro';
import { routes } from '../../data/navigation';
import { profile } from '../../data/profile';

const year = new Date().getFullYear();
---

<footer class="site-footer shell">
  <div>
    <a class="site-footer-name" href={routes.home}>
      {profile.name}
    </a>
    <p>{profile.location}</p>
    <p>© {year}</p>
  </div>
  <ContactLinks placement="footer" />
</footer>

<style>
  .site-footer {
    align-items: flex-end;
    display: flex;
    gap: var(--space-8);
    justify-content: space-between;
    border-top: var(--rule-line);
    margin-top: 6rem;
    padding-block: 2.2rem 2.6rem;
    font-size: var(--text-xs);
  }
  .site-footer-name {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--paper);
  }
  p {
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .site-footer {
      align-items: flex-start;
      flex-direction: column;
      margin-top: var(--space-16);
    }
    /* In one column the links follow the name and address down the same left edge. */
    .site-footer :global(.contact-links--footer) {
      justify-content: flex-start;
    }
  }
</style>
