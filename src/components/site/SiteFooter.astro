---
import '@fontsource-variable/bodoni-moda/opsz.css';
import ContactLinks from '../ui/ContactLinks.astro';
import { routes } from '../../data/navigation';
import { profile } from '../../data/profile';

const year = new Date().getFullYear();
---

<footer class="site-footer shell page-grid" data-site-footer>
  <div class="site-footer-identity">
    <a class="site-footer-name" href={routes.home}>
      {profile.name}
    </a>
    <p class="label-text">
      {profile.location} · © {year}
    </p>
  </div>
  <ContactLinks placement="footer" />
</footer>

<style>
  /* The header's mirror: the name and place on column 1, the contact links flush right, both
     resting on the line of the place. */
  .site-footer {
    align-items: last baseline;
    border-top: var(--rule-line);
    margin-top: var(--section-space);
    padding-block: var(--step-32) var(--step-48);
  }
  .site-footer-identity {
    grid-column: var(--zone-side);
  }
  .site-footer-name {
    font-family: var(--font-serif);
    font-size: var(--type-heading);
    letter-spacing: var(--tracking-title);
    line-height: var(--line-heading);
    text-decoration: none;
    color: var(--paper);
  }
  p {
    margin: var(--step-8) 0 0;
    color: var(--muted);
  }
  .site-footer :global(.contact-links--footer) {
    grid-column: var(--zone-main-wide);
    justify-content: flex-end;
  }
  @media (max-width: 720px) {
    .site-footer {
      row-gap: var(--step-24);
      margin-top: var(--section-space);
    }
    /* Four links do not fit one phone row, so they take two even ones. */
    .site-footer :global(.contact-links--footer) {
      display: grid;
      gap: var(--step-16) var(--step-32);
      grid-template-columns: repeat(2, max-content);
      justify-content: start;
    }
  }
</style>
