---
import '@fontsource-variable/bodoni-moda/opsz.css';
import HeaderRoll from './HeaderRoll.astro';
import { primaryNavigation, routes, type PageId } from '../../../data/navigation';
import { profile } from '../../../data/profile';

interface Props {
  page?: PageId;
}
const { page } = Astro.props;
---

<div class="site-header-wrap">
  <header class="site-header shell page-grid" data-sticky-header>
    <a
      class="site-header-name"
      href={routes.home}
      data-astro-prefetch
      aria-label={`${profile.name} — home`}
      aria-current={page === 'home' ? 'page' : undefined}
    >
      <span class="site-header-signal signal-slices" data-signal-text={profile.name}>
        {profile.name}
      </span>
      <span class="site-header-dot" aria-hidden="true">
        .
      </span>
    </a>
    <nav aria-label="Main navigation" data-navigation-feedback>
      {primaryNavigation.map((item, index) => (
        <a
          href={routes[item.page]}
          aria-label={item.label}
          aria-current={item.page === page ? 'page' : undefined}
          data-astro-prefetch
        >
          <span class="site-header-choice" data-nav-label={item.label}>
            <HeaderRoll direction={index % 2 ? 'up' : 'down'}>{item.label}</HeaderRoll>
          </span>
        </a>
      ))}
    </nav>
  </header>
</div>

<style>
  /* The header stays at one position; breathing room belongs to the content below it. */
  .site-header-wrap {
    position: sticky;
    top: 0;
    z-index: 5;
    margin-bottom: var(--step-32);
    padding-top: var(--site-header-safe-area);
    background: var(--ink);
  }
  .site-header-wrap::after {
    content: '';
    inset: 100% 0 auto;
    position: absolute;
    height: var(--site-header-fade);
    background: linear-gradient(
      to bottom,
      var(--ink),
      color-mix(in srgb, var(--ink) 94%, transparent) 20%,
      color-mix(in srgb, var(--ink) 72%, transparent) 42%,
      color-mix(in srgb, var(--ink) 34%, transparent) 70%,
      color-mix(in srgb, var(--ink) 8%, transparent) 90%,
      transparent
    );
    pointer-events: none;
  }
  /* The name on column 1, and the pages flush right from column 6. */
  .site-header {
    align-items: baseline;
    padding-block: var(--step-16);
  }
  .site-header-name {
    grid-column: var(--zone-side);
    justify-self: start;
    font-family: var(--font-serif);
    font-size: var(--type-heading);
    letter-spacing: var(--tracking-title);
    line-height: var(--line-heading);
    text-decoration: none;
    color: var(--paper);
  }
  /* Hovering the name tears it once, as the home name tears: the links roll, but the name is the
     signal. Its colour stays. */
  .site-header-name:is(:hover, :focus-visible) {
    color: var(--paper);
  }
  .site-header-signal {
    position: relative;
    display: inline-block;
  }
  .site-header-signal::before {
    text-shadow: -2px 0 var(--blue);
    clip-path: inset(30% 0 55%);
    color: var(--paper);
  }
  .site-header-signal::after {
    clip-path: inset(61% 0 27%);
    color: var(--signal-light);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .site-header[data-hover-ready]
      .site-header-name:is(:hover, :focus-visible)
      .site-header-signal {
      animation: signal-name-distort var(--signal-burst) steps(1, end) both;
    }
    .site-header[data-hover-ready]
      .site-header-name:is(:hover, :focus-visible)
      .site-header-signal::before {
      animation: signal-name-slip-upper var(--signal-burst) steps(1, end) both;
    }
    .site-header[data-hover-ready]
      .site-header-name:is(:hover, :focus-visible)
      .site-header-signal::after {
      animation: signal-name-slip-lower var(--signal-burst) steps(1, end) both;
    }
  }
  .site-header-dot {
    color: var(--blue);
  }
  /* The pages read flush right, a size up from the labels: the header's one row of choices. */
  nav {
    align-items: baseline;
    display: flex;
    gap: var(--step-32);
    grid-column: var(--zone-main-wide);
    justify-content: flex-end;
    font-family: var(--font-mono);
    font-size: var(--type-body);
    line-height: var(--line-body);
  }
  /* Blue identifies the current page. Hover and focus only roll the labels, keeping their colour. */
  nav a {
    text-decoration: none;
    color: var(--muted);
  }
  nav a[aria-current='page'] {
    --nav-rest-colour: var(--blue);
    color: var(--blue);
  }
  nav:has([data-nav-connect]) a[aria-current='page']:not([data-nav-connect]) {
    color: var(--muted);
  }
  nav a[data-nav-connect] {
    color: var(--blue);
    transition: none;
  }
  .site-header-choice {
    position: relative;
    display: inline-block;
  }
  .site-header-choice::after {
    content: attr(data-nav-label);
    inset: 0;
    position: absolute;
    white-space: nowrap;
    color: var(--signal-light);
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-nav-connect] .site-header-choice {
      background: linear-gradient(
        100deg,
        var(--blue) calc(var(--signal-connect-progress) - 8%),
        var(--signal-light) calc(var(--signal-connect-progress) - 2%),
        var(--nav-rest-colour, var(--muted)) calc(var(--signal-connect-progress) + 10%)
      );
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: signal-nav-connect 240ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    [data-nav-connect] .site-header-choice::after {
      animation: signal-nav-echo 240ms steps(1, end) both;
    }
  }
  @media (max-width: 900px) {
    nav {
      gap: var(--step-24);
    }
  }
  @media (max-width: 720px) {
    /* Keep both groups intact; their intrinsic widths decide when the navigation needs its row. */
    .site-header {
      column-gap: var(--step-16);
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      row-gap: 0;
      padding-block: var(--step-8) 0;
    }
    .site-header-name {
      flex-shrink: 0;
    }
    nav {
      align-items: center;
      flex-shrink: 0;
      flex-wrap: wrap;
      gap: 0 var(--step-16);
      max-width: 100%;
    }
    nav a {
      padding-block: var(--step-8);
    }
  }
  @media (max-width: 380px) {
    nav {
      display: grid;
      grid-template-columns: repeat(2, max-content);
    }
    nav a {
      align-items: center;
      display: flex;
      min-height: var(--step-32);
      padding-block: 0;
    }
  }
</style>
