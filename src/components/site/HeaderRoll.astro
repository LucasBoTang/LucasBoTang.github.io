---
// A ready header link's label rolls while hovered or focused: the label rolls out and
// its copy rolls in behind it, `down` or `up`. The colour stays; only the label moves.
interface Props {
  direction?: 'down' | 'up';
}
const { direction = 'down' } = Astro.props;
const label = await Astro.slots.render('default');
---

<span class="roll" data-direction={direction}>
  <span class="roll-face">
    <Fragment set:html={label} />
  </span>
  <span class="roll-face" aria-hidden="true">
    <Fragment set:html={label} />
  </span>
</span>

<style>
  .roll {
    --roll-direction: 100%;
    display: inline-grid;
    overflow: hidden;
    vertical-align: bottom;
  }
  .roll-face {
    grid-area: 1 / 1;
  }
  .roll[data-direction='up'] {
    --roll-direction: -100%;
  }
  .roll-face:first-child {
    transform: var(--roll-front, none);
  }
  /* The copy waits on the side the label rolls towards it from. */
  .roll-face + .roll-face {
    transform: var(--roll-back, translateY(calc(-1 * var(--roll-direction))));
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global([data-hover-ready]) .roll-face {
      transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(
        [data-hover-ready]
          a:not([data-nav-connect]):is(:hover:not([data-hover-hold]), :focus-visible)
      )
      .roll {
      --roll-back: none;
      --roll-front: translateY(var(--roll-direction));
    }
    /* Clicking locks one clean word in place until the destination receives a fresh hover. */
    :global(a:is([data-nav-connect], [data-hover-hold]:not(:focus-visible))) .roll-face {
      transition: none;
    }
  }
</style>
