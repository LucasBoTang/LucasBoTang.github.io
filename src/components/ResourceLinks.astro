---
import type { ResourceLink } from '../data/resources';

interface Props {
  links: ResourceLink[];
  context: string;
}
const { links, context } = Astro.props;
---

<ul class="resource-links">
  {links.map((link) => (
    <li>
      <a class="text-link" href={link.href} aria-label={`${link.label}: ${context}`}>
        <span class="link-label">{link.label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .resource-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    margin: 0;
    padding: 0;
    font-size: var(--text-xs);
    list-style: none;
  }
  a {
    color: var(--blue);
  }
</style>
