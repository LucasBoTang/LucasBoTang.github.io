---
import { Image } from 'astro:assets';
import PublicationItem from './PublicationItem.astro';
import type { ResearchArea } from '../data/research';

interface Props {
  area: ResearchArea;
}
const { area } = Astro.props;
---

<section class="research-section" id={area.id} aria-labelledby={`${area.id}-title`}>
  <h2 id={`${area.id}-title`}>{area.title}</h2>
  <p class="research-question">{area.question}</p>
  <p class="research-introduction">{area.introduction}</p>
  {area.illustration && (
    <figure>
      <Image
        src={area.illustration.src}
        alt={area.illustration.alt}
        widths={[640, 960, 1280]}
        sizes="(max-width: 720px) 100vw, 60vw"
        loading="lazy"
      />
      {area.illustration.caption && <figcaption>{area.illustration.caption}</figcaption>}
    </figure>
  )}
  {area.publications.length > 0 && (
    <ul class="publication-list">
      {area.publications.map((publication) => (
        <PublicationItem publication={publication} />
      ))}
    </ul>
  )}
</section>

<style>
  .research-section {
    margin-bottom: 6.5rem;
    scroll-margin-top: 2.5rem;
  }
  h2 {
    margin: 0 0 1.5rem;
    max-width: 24ch;
    font-size: clamp(1.65rem, 2.5vw, 2.15rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.3;
    color: var(--blue);
  }
  .research-question {
    margin: 0 0 0.8rem;
    max-width: 58ch;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--paper);
  }
  .research-introduction {
    margin: 0 0 2.2rem;
    max-width: 67ch;
    font-size: var(--text-sm);
    line-height: var(--leading-prose);
    color: var(--muted);
  }
  .publication-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  figure {
    margin: 2rem 0;
  }
  img {
    height: auto;
    width: 100%;
  }
  figcaption {
    margin-top: 0.8rem;
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .research-section:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 600px) {
    .research-section {
      margin-bottom: 4rem;
    }
    .research-question {
      font-size: var(--text-base);
    }
    .research-introduction {
      font-size: var(--text-sm);
    }
  }
</style>
