---
import { primaryNavigation, routes, type PageId } from '../data/navigation';
import { profile } from '../data/profile';

interface Props {
  page?: PageId;
}
const { page } = Astro.props;
---

<header class="site-header shell">
  <a
    class="wordmark"
    href={routes.home}
    aria-label={`${profile.name} — home`}
    aria-current={page === 'home' ? 'page' : undefined}
  >
    {profile.name}
    <span class="wordmark-dot" aria-hidden="true">
      .
    </span>
  </a>
  <nav aria-label="Main navigation">
    {primaryNavigation.map((item) => (
      <a
        class="text-link"
        href={routes[item.page]}
        aria-current={item.page === page ? 'page' : undefined}
      >
        <span class="link-label">{item.label}</span>
      </a>
    ))}
    <a class="text-link" href={profile.cv} download aria-label="CV (PDF)">
      <span class="link-label">
        CV <span class="file-type">(PDF)</span>
      </span>
    </a>
  </nav>
</header>

<style>
  .site-header {
    align-items: center;
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    padding-block: 2rem;
  }
  .wordmark {
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: -0.04em;
    text-decoration: none;
    color: var(--paper);
  }
  .wordmark-dot {
    color: var(--blue);
  }
  nav {
    align-items: center;
    display: flex;
    gap: 2rem;
    font-size: var(--text-sm);
  }
  nav a {
    padding-block: 0.35rem;
    text-decoration: none;
    color: var(--muted);
  }
  nav a:is(:hover, :focus-visible),
  nav a[aria-current='page'] {
    color: var(--blue);
  }
  nav a[aria-current='page'] .link-label {
    background-size: 100% 1px;
  }
  .file-type {
    margin-left: 0.2rem;
    font-size: var(--text-xs);
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .site-header {
      align-items: flex-start;
      gap: 1rem;
      padding-block: 1.4rem;
    }
    nav {
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: flex-end;
      font-size: var(--text-xs);
    }
    .wordmark {
      flex-shrink: 0;
    }
    .file-type {
      display: none;
    }
  }
  @media (max-width: 380px) {
    .site-header {
      flex-direction: column;
      gap: 0.75rem;
    }
    nav {
      gap: 0.65rem;
      justify-content: flex-start;
    }
  }
</style>
