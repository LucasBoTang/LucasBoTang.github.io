---
import type { ResourceLink } from '../../data/resources';

interface Props {
  links: ResourceLink[];
  context: string;
}
const { links, context } = Astro.props;
---

<ul class="resource-links">
  {links.map((link) => (
    <li>
      <a class="text-link" href={link.href} aria-label={`${link.label}: ${context}`}>
        <span class="link-label">{link.label}</span>
      </a>
    </li>
  ))}
  {/* Further items in the row, such as a paper's Bib. */}
  <slot />
</ul>

<style>
  .resource-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    list-style: none;
    text-transform: uppercase;
  }
  a {
    color: var(--blue);
  }
</style>
