---
import type { ResourceLink } from '../../data/resources';

interface Props {
  links: ResourceLink[];
  context: string;
}
const { links, context } = Astro.props;
---

<ul class="resource-links label-text">
  {links.map((link) => (
    <li>
      <a class="text-link" href={link.href} aria-label={`${link.label}: ${context}`}>
        <span class="link-label">{link.label}</span>
      </a>
    </li>
  ))}
  {/* Further items in the row, such as a paper's Bib. */}
  <slot />
</ul>

<style>
  .resource-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--step-8) var(--step-24);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--blue);
  }
</style>
