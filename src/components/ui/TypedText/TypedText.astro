---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<span class="typed-text" data-typed-text>
  <span class="intro-copy">{text}</span>
  <span class="intro-typing" aria-hidden="true">
    <span data-intro-typed></span>
    <span class="intro-cursor"></span>
  </span>
</span>

<style>
  .typed-text {
    position: relative;
    display: block;
  }
  .intro-typing {
    display: none;
  }
  [data-typing-ready] .intro-copy {
    color: transparent;
  }
  /* The typed letters lie over the sentence, which carries its text for reading and copying; the
     letters are not selectable, so a copy holds the sentence once. */
  [data-typing-ready] .intro-typing {
    inset: 0;
    position: absolute;
    display: block;
    user-select: none;
  }
  .intro-cursor {
    left: 0;
    position: absolute;
    top: 0.12em;
    display: inline-block;
    height: 1em;
    margin-left: 3px; /* optical: the cursor just clear of the last letter */
    width: 2px;
    vertical-align: -0.14em;
    background: var(--blue);
  }
  [data-typing-ready]:not([data-typing-started]):not([data-typing-complete]) .intro-cursor {
    visibility: hidden;
  }
  /* Letters laid out by typed-text.ts, revealed one by one. */
  .intro-typing :global(.intro-word) {
    white-space: nowrap;
  }
  .intro-typing :global(.intro-letter) {
    position: relative;
  }
  .intro-typing :global(.intro-letter[data-unseen]) {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .intro-cursor {
      animation: intro-cursor-blink 1.1s step-end infinite;
    }
    [data-typing-suspended] .intro-cursor {
      animation-play-state: paused;
    }
    [data-typing] .intro-cursor {
      animation: none;
    }
  }
  @keyframes intro-cursor-blink {
    0%,
    55%,
    100% {
      opacity: 1;
    }
    56%,
    99% {
      opacity: 0;
    }
  }
</style>
