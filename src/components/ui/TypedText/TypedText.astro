---
interface Props {
  text: string;
  /** Start this word on a new line on mobile, keeping the sentence intact. */
  mobileBreakBefore?: string;
}
const { text, mobileBreakBefore } = Astro.props;
const sentence = text.trim();
const breakAt = mobileBreakBefore ? sentence.indexOf(` ${mobileBreakBefore} `) + 1 : 0;
---

<span class="typed-text" data-typed-text data-mobile-break-at={breakAt || undefined}>
  <span class="typed-copy">
    {breakAt ? (
      <>
        {sentence.slice(0, breakAt)}
        <span class="typed-line">{sentence.slice(breakAt)}</span>
      </>
    ) : (
      sentence
    )}
  </span>
  <span class="typed-overlay" data-typed-layer aria-hidden="true">
    <span data-typed-run></span>
    <span class="typed-cursor"></span>
  </span>
</span>

<style>
  .typed-text {
    position: relative;
    display: block;
  }
  .typed-overlay {
    display: none;
  }
  .typed-copy {
    display: block;
  }
  [data-typing-ready] .typed-copy {
    color: transparent;
  }
  /* The typed letters lie over the sentence, which carries its text for reading and copying; the
     letters are not selectable, so a copy holds the sentence once. */
  [data-typing-ready] .typed-overlay {
    inset: 0;
    position: absolute;
    display: block;
    user-select: none;
  }
  .typed-cursor {
    left: 0;
    position: absolute;
    top: 0.12em;
    display: inline-block;
    height: 1em;
    margin-left: 3px; /* optical: the cursor just clear of the last letter */
    width: 2px;
    vertical-align: -0.14em;
    background: var(--blue);
  }
  [data-typing-ready]:not([data-typing-started]):not([data-typing-complete]) .typed-cursor {
    visibility: hidden;
  }
  /* Letters laid out by typed-text.ts, revealed one by one. */
  .typed-overlay :global(.typed-word) {
    white-space: nowrap;
  }
  .typed-overlay :global(.typed-letter) {
    position: relative;
  }
  .typed-overlay :global(.typed-letter[data-unseen]) {
    visibility: hidden;
  }

  @media (max-width: 720px) {
    .typed-text :global(.typed-line) {
      display: block;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-typing-fade] .typed-overlay :global(.typed-letter) {
      transition: opacity var(--typing-letter-fade) linear;
    }
    [data-typing-fade] .typed-overlay :global(.typed-letter[data-unseen]) {
      opacity: 0;
    }
    .typed-cursor {
      animation: typed-cursor-blink 1.1s step-end infinite;
    }
    [data-typing-suspended] .typed-cursor {
      animation-play-state: paused;
    }
    [data-typing] .typed-cursor {
      animation: none;
    }
  }
  @keyframes typed-cursor-blink {
    0%,
    55%,
    100% {
      opacity: 1;
    }
    56%,
    99% {
      opacity: 0;
    }
  }
</style>
