---
import { contactLinks } from '../../data/profile';

interface Props {
  placement?: 'hero' | 'footer';
}
const { placement = 'hero' } = Astro.props;
---

<nav
  class:list={['contact-links', { 'contact-links--footer': placement === 'footer' }]}
  aria-label="Contact and profiles"
  data-opening-part={placement === 'hero' ? 'contacts' : undefined}
>
  {contactLinks.map((link, index) => (
    <a
      class:list={{ 'contact-slip-reverse': index % 2 === 1 }}
      href={link.href}
      aria-label={link.description ?? link.service}
      title={link.description ?? link.service}
    >
      <span class="contact-symbol" data-contact-icon>
        {[false, true].map((slice) => (
          <svg
            class:list={{ 'contact-face': !slice, 'contact-slice': slice }}
            viewBox="0 0 24 24"
            width="19"
            height="19"
            aria-hidden="true"
            focusable="false"
          >
            {link.icon === 'email' && (
              <>
                <rect x="3" y="5" width="18" height="14" rx="1" />
                <path d="m3 6 9 7 9-7" />
              </>
            )}
            {link.icon === 'scholar' && (
              <path d="m2 9 10-5 10 5-10 5Z M6 11v6c4 3 8 3 12 0v-6 M22 9v8" />
            )}
            {link.icon === 'github' && (
              <path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
            )}
            {link.icon === 'linkedin' && (
              <>
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z" />
                <rect x="2" y="9" width="4" height="12" />
                <circle cx="4" cy="4" r="2" />
              </>
            )}
          </svg>
        ))}
      </span>
      <span data-contact-label>{link.label}</span>
    </a>
  ))}
</nav>

<style>
  .contact-links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: var(--step-16) 0 0 var(--contact-links-offset, 0px);
    width: var(--contact-links-width, auto);
  }
  a {
    position: relative;
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--step-8);
    min-height: 44px;
    padding-block: var(--step-8);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    line-height: var(--line-label);
    text-decoration: none;
    color: var(--muted);
  }
  svg {
    color: var(--blue);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1;
  }
  /* Every line icon draws a one-pixel stroke, whatever size it is set at. */
  svg :is(path, rect, circle) {
    vector-effect: non-scaling-stroke;
  }
  .contact-slice {
    inset: 0;
    position: absolute;
    clip-path: inset(40% -3px 38%);
    opacity: 0;
    pointer-events: none;
  }
  .contact-symbol {
    isolation: isolate;
    position: relative;
    display: grid;
    place-items: center;
    height: 19px;
    width: 19px;
  }
  .contact-symbol::before {
    content: '';
    inset: -8.5px;
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    background: var(--blue);
    opacity: 0;
    transform: scale(0.85);
  }
  a:is(:hover, :focus-visible) {
    color: var(--blue);
  }
  a:is(:hover, :focus-visible) .contact-symbol::before {
    opacity: 1;
    transform: scale(1);
  }
  a:is(:hover, :focus-visible) svg {
    color: var(--ink);
  }
  a:focus-visible {
    outline: none;
  }
  a:focus-visible .contact-symbol::before {
    outline: 1px solid var(--blue);
    outline-offset: 4px;
  }
  /* In the footer the links run in one row, each icon beside its label. */
  .contact-links.contact-links--footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--step-8) var(--step-24);
    margin: 0;
    width: auto;
  }
  .contact-links--footer a {
    flex-direction: row;
    min-height: 0;
    padding-block: 0;
  }
  .contact-links--footer .contact-symbol,
  .contact-links--footer svg {
    height: 16px;
    width: 16px;
  }
  .contact-links--footer .contact-symbol::before {
    inset: -7px;
  }
  /* On touch screens the footer's small links get a fingertip's room, given back by negative
     margins so nothing around them moves. */
  @media (pointer: coarse) {
    .contact-links--footer a {
      margin-block: calc(-1 * var(--step-8));
      padding-block: var(--step-8);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .contact-symbol::before {
      transition:
        opacity 180ms ease,
        transform 240ms cubic-bezier(0.2, 0.7, 0.3, 1);
    }
    svg {
      transition: color 180ms ease;
    }
    a {
      --signal-shift: 2px;
    }
    .contact-slip-reverse {
      --signal-shift: -2px;
    }
    :global([data-slip]) .contact-links a:not(:hover, :focus-visible) .contact-face {
      animation: signal-contact-cut var(--signal-burst) steps(1, end) both;
    }
    :global([data-slip]) .contact-links a:not(:hover, :focus-visible) .contact-slice {
      animation: signal-contact-slip var(--signal-burst) steps(1, end) both;
    }
    a:focus-visible .contact-face {
      animation: signal-contact-hover-cut 1800ms steps(1, end) infinite;
    }
    a:focus-visible .contact-slice {
      animation: signal-contact-hover-slip 1800ms steps(1, end) infinite;
    }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    a:hover .contact-face {
      animation: signal-contact-hover-cut 1800ms steps(1, end) infinite;
    }
    a:hover .contact-slice {
      animation: signal-contact-hover-slip 1800ms steps(1, end) infinite;
    }
  }
</style>
