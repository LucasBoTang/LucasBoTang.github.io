---
interface Props {
  href: string;
  download?: boolean;
  /* A download points down; every other link points up and out. */
  direction?: 'out' | 'down';
}
const { href, download, direction = 'out' } = Astro.props;
const arrow =
  direction === 'down' ? 'M15 7.93v14.14M7.93 15 15 22.07 22.07 15' : 'M10 20 20 10M10 10h10v10';
---

<a href={href} download={download} class="arrow-link text-link">
  <span class="link-label">
    <slot />
  </span>
  <svg
    class="arrow-link-symbol"
    width="30"
    height="30"
    viewBox="0 0 30 30"
    aria-hidden="true"
    focusable="false"
  >
    <circle class="arrow-link-orbit" cx="15" cy="15" r="13" pathLength="1" />
    <path d={arrow} />
  </svg>
</a>

<style>
  .arrow-link {
    align-items: center;
    display: inline-flex;
    gap: var(--step-24);
    justify-content: space-between;
    min-height: 2.75rem;
    padding-block: var(--step-8);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    line-height: var(--line-label);
    color: var(--blue);
  }
  .arrow-link-symbol {
    flex-shrink: 0;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }
  .arrow-link-symbol path {
    vector-effect: non-scaling-stroke;
  }
  .arrow-link-orbit {
    opacity: 0;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transform: rotate(-90deg);
    transform-origin: center;
  }
  .arrow-link:is(:hover, :focus-visible) .arrow-link-orbit {
    opacity: 0.65;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .arrow-link-orbit {
      transition:
        stroke-dashoffset 320ms ease,
        opacity 180ms ease;
    }
    .arrow-link-symbol {
      transition: transform 180ms ease;
    }
    .arrow-link:active .arrow-link-symbol {
      transform: scale(0.9);
    }
  }
</style>
