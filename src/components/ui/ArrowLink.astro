---
interface Props {
  href: string;
  download?: boolean;
  /* Internal destinations point forward, external ones out, and downloads down. */
  direction?: 'out' | 'down' | 'forward';
}
const { href, download, direction = 'out' } = Astro.props;
const arrows = {
  out: 'M10 20 20 10M10 10h10v10',
  down: 'M15 7.93v14.14M7.93 15 15 22.07 22.07 15',
  forward: 'M7 15h16M16 8l7 7-7 7',
};
---

<a href={href} download={download} class="arrow-link text-link">
  <span class="link-label">
    <slot />
  </span>
  <svg
    class="arrow-link-symbol"
    width="30"
    height="30"
    viewBox="0 0 30 30"
    aria-hidden="true"
    focusable="false"
  >
    <circle class="arrow-link-orbit" cx="15" cy="15" r="13" pathLength="1" />
    <path d={arrows[direction]} />
  </svg>
</a>

<style>
  .arrow-link {
    align-items: center;
    display: inline-flex;
    gap: var(--arrow-link-gap, var(--step-24));
    justify-content: space-between;
    min-height: 2.75rem;
    padding-block: var(--step-8);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    line-height: var(--line-label);
    color: var(--blue);
  }
  .arrow-link-symbol {
    position: relative;
    top: var(--arrow-link-offset, 0px);
    flex-shrink: 0;
    height: var(--arrow-link-size, 30px);
    overflow: visible;
    width: var(--arrow-link-size, 30px);
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }
  .arrow-link-symbol path {
    vector-effect: non-scaling-stroke;
  }
  .arrow-link-orbit {
    opacity: 0;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transform: rotate(-90deg);
    transform-origin: center;
  }
  .arrow-link:is(:hover, :focus-visible) .arrow-link-orbit {
    opacity: 0.65;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .arrow-link-orbit {
      transition:
        stroke-dashoffset 320ms ease,
        opacity 180ms ease;
    }
    .arrow-link-symbol {
      transition: transform 180ms ease;
    }
    .arrow-link:active .arrow-link-symbol {
      transform: scale(0.9);
    }
  }
  @media (max-width: 720px) {
    .arrow-link {
      gap: var(--arrow-link-gap, var(--step-16));
    }
    .arrow-link-symbol {
      height: var(--arrow-link-size, 24px);
      width: var(--arrow-link-size, 24px);
    }
  }
</style>
