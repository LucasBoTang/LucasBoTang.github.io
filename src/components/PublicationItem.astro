---
import ResourceLinks from './ResourceLinks.astro';
import { profile } from '../data/profile';
import {
  formatPublicationMetadata,
  getPublicationHref,
  type Publication,
} from '../data/publications';

interface Props {
  publication: Publication;
}
const { publication } = Astro.props;
const resources = publication.links.filter((link) => link.label !== 'Paper');
---

<li class="publication" id={publication.id}>
  <div class="publication-year">
    {publication.year}
    {publication.status === 'Preprint' && <span>{publication.status}</span>}
  </div>
  <div class="publication-body">
    <h3>
      <a class="text-link" href={getPublicationHref(publication)}>
        <span class="link-label">{publication.title}</span>
      </a>
    </h3>
    <p class="authors">
      {publication.authors.map((author, index) => (
        <>
          {index > 0 && ', '}
          {author === profile.name ? <strong>{author}</strong> : author}
        </>
      ))}
    </p>
    <p class="venue">{formatPublicationMetadata(publication)}</p>
    {resources.length > 0 && <ResourceLinks links={resources} context={publication.title} />}
  </div>
</li>

<style>
  .publication {
    display: grid;
    gap: 1rem;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    border-top: var(--rule-line);
    padding-block: 1.6rem;
    scroll-margin-top: 2rem;
  }
  .publication-year {
    padding-top: 0.25rem;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .publication-year span {
    display: block;
    margin-top: 0.45rem;
    font-size: var(--text-xs);
  }
  h3 {
    margin: 0 0 0.7rem;
    font-size: var(--text-lg);
    font-weight: 550;
    letter-spacing: -0.025em;
    line-height: var(--leading-compact);
    text-wrap: pretty;
  }
  .authors,
  .venue {
    margin: 0;
    font-size: var(--text-xs);
    line-height: var(--leading-prose);
    color: var(--muted);
  }
  .authors strong {
    font-weight: 500;
    color: var(--paper);
  }
  .venue {
    margin: 0.1rem 0 0.75rem;
  }
  @media (max-width: 600px) {
    .publication {
      gap: 0.55rem;
      grid-template-columns: 1fr;
    }
    .publication-year {
      align-items: center;
      display: flex;
      gap: 0.7rem;
    }
    .publication-year span {
      margin: 0;
    }
    h3 {
      font-size: var(--text-base);
    }
  }
</style>
