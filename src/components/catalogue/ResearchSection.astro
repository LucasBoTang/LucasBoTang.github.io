---
import '@fontsource-variable/bodoni-moda/opsz.css';
import PublicationItem from './PublicationItem.astro';
import { publicationsByYear, type ResearchArea } from '../../data/research';

interface Props {
  area: ResearchArea;
}
const { area } = Astro.props;
const sortedPublications = publicationsByYear(area);
---

<section class="research-section" id={area.id} aria-labelledby={`${area.id}-title`}>
  <h2 id={`${area.id}-title`} data-reveal="unit" data-arrival="wipe">
    {area.title}
  </h2>
  {/* The question and its introduction read as one passage, so they arrive together. */}
  {(area.question || area.introduction) && (
    <div class="research-passage" data-reveal="unit">
      {area.question && <p class="research-question heading-text">{area.question}</p>}
      {area.introduction && <p class="research-introduction">{area.introduction}</p>}
    </div>
  )}
  {area.publications.length > 0 && (
    <ul class="publication-list">
      {sortedPublications.map((publication) => (
        <PublicationItem publication={publication} />
      ))}
    </ul>
  )}
</section>

<style>
  /* Inside Research's subgrid (columns 5 to 11): the heading and its passage hang from column 5
     with the years, a column out from the entries, and run across the whole width. */
  .research-section {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    scroll-margin-top: 2.5rem;
  }
  .research-section + .research-section {
    margin-top: var(--step-160);
  }
  h2,
  .research-passage {
    grid-column: 1 / -1;
  }
  /* The question may run the whole width; the introduction, running text, keeps six columns. */
  .research-passage {
    display: grid;
    grid-template-columns: subgrid;
  }
  .research-question {
    grid-column: 1 / -1;
    text-wrap: balance;
  }
  .research-introduction {
    grid-column: 1 / -2;
  }
  h2 {
    margin: 0 0 var(--step-24);
    font-family: var(--font-serif);
    /* The text cut: at this size the display cut's hairlines, hyphens among them, nearly vanish. */
    font-optical-sizing: none;
    font-size: var(--type-title);
    font-variation-settings: 'opsz' 11;
    letter-spacing: var(--tracking-title);
    line-height: var(--line-title);
    color: var(--blue);
  }
  .research-question {
    margin: 0;
    color: var(--paper);
  }
  .research-introduction {
    margin: var(--step-16) 0 0;
    color: var(--muted);
  }
  .publication-list {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    margin: var(--step-48) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 720px) {
    .research-section,
    .research-passage,
    .publication-list {
      display: block;
    }
    .research-section + .research-section {
      margin-top: var(--step-96);
    }
  }
</style>
