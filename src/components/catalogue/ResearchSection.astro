---
import '@fontsource-variable/bodoni-moda/opsz.css';
import PublicationItem from './PublicationItem.astro';
import ScreenReveal from './ScreenReveal/ScreenReveal.astro';
import FigureFrame from './FigureFrame/FigureFrame.astro';
import { publicationsByYear, type ResearchArea } from '../../data/research';
import { researchFigures, type FigureKind } from '../../data/research/figures';

interface Props {
  area: ResearchArea;
}
const { area } = Astro.props;
const sortedPublications = publicationsByYear(area);
const figureKind = (Object.keys(researchFigures) as FigureKind[]).find(
  (kind) => researchFigures[kind].area === area.id,
);
const figure = figureKind ? researchFigures[figureKind] : undefined;
---

<section class="research-section" id={area.id} aria-labelledby={`${area.id}-title`}>
  <h2 id={`${area.id}-title`} data-reveal="unit" data-arrival="wipe">
    {area.title}
  </h2>
  {/* The question and its introduction read as one passage, so they arrive together. */}
  {(area.question || area.introduction) && (
    <div class="research-passage" data-reveal="unit">
      {area.question && <p class="research-question heading-text">{area.question}</p>}
      {area.introduction && <p class="research-introduction">{area.introduction}</p>}
    </div>
  )}
  {figure && figureKind && (
    <figure id={figure.anchor} class="research-figure" aria-describedby={figure.captionId}>
      <ScreenReveal>
        <FigureFrame kind={figureKind} title={figure.title} />
      </ScreenReveal>
      <figcaption id={figure.captionId}>{figure.caption}</figcaption>
      <details>
        <summary>{figure.summary}</summary>
        {figure.details.map((paragraph) => (
          <p>
            {paragraph.map((part) =>
              typeof part === 'string' ? part : <a href={part.href}>{part.label}</a>,
            )}
          </p>
        ))}
      </details>
    </figure>
  )}

  {area.publications.length > 0 && (
    <ul class="publication-list">
      {sortedPublications.map((publication) => (
        <PublicationItem publication={publication} />
      ))}
    </ul>
  )}
</section>

<style>
  /* Inside Research's subgrid (columns 5 to 11): the heading and its passage hang from column 5
     with the years, a column out from the entries, and run across the whole width. */
  .research-section {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    scroll-margin-top: var(--anchor-section-offset);
  }
  .research-section + .research-section {
    margin-top: var(--section-space);
  }
  h2,
  .research-passage {
    grid-column: 1 / -1;
  }
  /* The question may run the whole width; the introduction, running text, keeps six columns. */
  .research-passage {
    display: grid;
    grid-template-columns: subgrid;
  }
  .research-question {
    grid-column: 1 / -1;
    text-wrap: balance;
  }
  .research-introduction {
    grid-column: 1 / -2;
  }
  h2 {
    margin: 0 0 var(--step-24);
    font-family: var(--font-serif);
    /* The text cut: at this size the display cut's hairlines, hyphens among them, nearly vanish. */
    font-optical-sizing: none;
    font-size: var(--type-title);
    font-variation-settings: 'opsz' 11;
    letter-spacing: var(--tracking-title);
    line-height: var(--line-title);
    color: var(--blue);
  }
  .research-question {
    margin: 0;
    color: var(--paper);
  }
  .research-introduction {
    margin: var(--step-16) 0 0;
    color: var(--muted);
  }
  .publication-list {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .research-passage + .publication-list {
    margin-top: var(--step-48);
  }
  @media (max-width: 720px) {
    .research-section,
    .research-passage,
    .publication-list {
      display: block;
    }
  }

  .research-figure {
    grid-column: 1/-2;
    margin: calc(5 * var(--step-8)) 0 0;
    min-width: 0;
    scroll-margin-top: var(--anchor-figure-offset);
  }
  .research-figure + .publication-list {
    margin-top: var(--step-48);
  }
  .research-figure figcaption {
    margin-top: var(--step-24);
    max-width: 62ch;
    font-size: var(--type-body);
    line-height: var(--line-body);
    color: var(--muted);
  }
  .research-figure details {
    margin-top: var(--step-16);
    font-size: var(--type-label);
    line-height: var(--line-label-block);
    color: var(--muted);
  }
  .research-figure summary {
    width: fit-content;
    font-family: var(--font-mono);
    cursor: pointer;
  }
  .research-figure details p {
    margin: var(--step-16) 0;
  }
  .research-figure details a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 720px) {
    .research-figure {
      grid-column: 1/-1;
      margin-top: var(--step-32);
    }
  }
</style>
