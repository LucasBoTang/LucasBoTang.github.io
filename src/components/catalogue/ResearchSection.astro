---
import '@fontsource-variable/bodoni-moda/opsz.css';
import L2oFigure from './L2oFigure/L2oFigure.astro';
import GpuFigure from './GpuFigure/GpuFigure.astro';
import DflFigure from './DflFigure/DflFigure.astro';
import PublicationItem from './PublicationItem.astro';
import { publicationsByYear, type ResearchArea } from '../../data/research';

interface Props {
  area: ResearchArea;
}
const { area } = Astro.props;
const sortedPublications = publicationsByYear(area);
---

<section class="research-section" id={area.id} aria-labelledby={`${area.id}-title`}>
  <h2 id={`${area.id}-title`} data-reveal="unit" data-arrival="wipe">
    {area.title}
  </h2>
  {/* The question and its introduction read as one passage, so they arrive together. */}
  {(area.question || area.introduction) && (
    <div class="research-passage" data-reveal="unit">
      {area.question && <p class="research-question heading-text">{area.question}</p>}
      {area.introduction && <p class="research-introduction">{area.introduction}</p>}
    </div>
  )}
  {area.id === 'learning-to-optimize' && (
    <figure
      id="bo-l2o-study"
      class="research-figure"
      data-reveal="unit"
      aria-describedby="l2o-caption"
    >
      <L2oFigure />
      <figcaption id="l2o-caption">
        Training a solution map with differentiable integer correction.
      </figcaption>
      <details>
        <summary>Figure details</summary>
        <p>
          Training predictions from a rerun of the{' '}
          <a href="https://github.com/pnnl/L2O-MINLP/blob/6dd2a901144ae9892cf545a88f54fe60caef9ebe/test/Training%20Iterations%20for%20Rosenbrock.ipynb">
            L2O-MINLP Rosenbrock example
          </a>
          . Surface height is log(1 + f).
        </p>
      </details>
    </figure>
  )}
  {area.id === 'first-order-methods' && (
    <figure
      id="bo-gpu-study"
      class="research-figure"
      data-reveal="unit"
      aria-describedby="gpu-context-caption"
    >
      <GpuFigure />
      <figcaption id="gpu-context-caption">
        Scaling optimization with GPU-accelerated sparse linear algebra.
      </figcaption>
      <details>
        <summary>Figure details &amp; credits</summary>
        <p>
          The real rail4284 standard-form matrix has 4,284 rows, 1,096,894 columns and 11,284,032
          nonzeros. It is a set-covering problem from Italian railways, contributed by Paolo Nobili
          to{' '}
          <a href="https://people.brunel.ac.uk/~mastjjb/jeb/orlib/scpinfo.html">
            Beasley’s OR-Library
          </a>
          .
        </p>
        <p>
          Photo:{' '}
          <a href="https://commons.wikimedia.org/wiki/File:Aerial_view_of_West_Oakland_rail_yards,_December_2022.JPG">
            Pi.1415926535 / Wikimedia Commons
          </a>
          , under the <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>,
          cropped and color-adjusted; the photographic adaptation remains CC BY-SA 4.0. The yard is
          illustrative, not the source location of rail4284.
        </p>
      </details>
    </figure>
  )}

  {area.id === 'decision-focused-learning' && (
    <figure id="bo-dfl-study" class="research-figure" data-reveal="unit">
      <DflFigure />
      <figcaption>Train predictions for the decisions they inform.</figcaption>
      <details>
        <summary>Figure details &amp; credits</summary>
        <p>
          Predictions are trained through downstream decision quality. Based on{' '}
          <a href="https://arxiv.org/html/2206.14234v3#S3">PyEPO, Section 3</a>.
        </p>
        <p>
          Photo:{' '}
          <a href="https://www.pexels.com/photo/a-person-using-a-calculator-8297018/">
            Mikhail Nilov / Pexels
          </a>
          . Cropped and color-adjusted.
        </p>
      </details>
    </figure>
  )}

  {area.publications.length > 0 && (
    <ul class="publication-list">
      {sortedPublications.map((publication) => (
        <PublicationItem publication={publication} />
      ))}
    </ul>
  )}
</section>

<style>
  /* Inside Research's subgrid (columns 5 to 11): the heading and its passage hang from column 5
     with the years, a column out from the entries, and run across the whole width. */
  .research-section {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    scroll-margin-top: 2.5rem;
  }
  .research-section + .research-section {
    margin-top: var(--step-160);
  }
  h2,
  .research-passage {
    grid-column: 1 / -1;
  }
  /* The question may run the whole width; the introduction, running text, keeps six columns. */
  .research-passage {
    display: grid;
    grid-template-columns: subgrid;
  }
  .research-question {
    grid-column: 1 / -1;
    text-wrap: balance;
  }
  .research-introduction {
    grid-column: 1 / -2;
  }
  h2 {
    margin: 0 0 var(--step-24);
    font-family: var(--font-serif);
    /* The text cut: at this size the display cut's hairlines, hyphens among them, nearly vanish. */
    font-optical-sizing: none;
    font-size: var(--type-title);
    font-variation-settings: 'opsz' 11;
    letter-spacing: var(--tracking-title);
    line-height: var(--line-title);
    color: var(--blue);
  }
  .research-question {
    margin: 0;
    color: var(--paper);
  }
  .research-introduction {
    margin: var(--step-16) 0 0;
    color: var(--muted);
  }
  .publication-list {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .research-passage + .publication-list {
    margin-top: var(--step-48);
  }
  @media (max-width: 720px) {
    .research-section,
    .research-passage,
    .publication-list {
      display: block;
    }
    .research-section + .research-section {
      margin-top: var(--step-96);
    }
  }

  .research-figure {
    grid-column: 1/-2;
    margin: calc(5 * var(--step-8)) 0 0;
    min-width: 0;
    scroll-margin-top: calc(var(--site-header-height) + var(--site-header-fade) + var(--step-24));
  }
  .research-figure + .publication-list {
    margin-top: var(--step-48);
  }
  .research-figure figcaption {
    margin-top: var(--step-24);
    max-width: 62ch;
    font-size: var(--type-body);
    line-height: var(--line-body);
    color: var(--muted);
  }
  .research-figure details {
    margin-top: var(--step-16);
    font-size: var(--type-label);
    line-height: var(--line-label-block);
    color: var(--muted);
  }
  .research-figure summary {
    width: fit-content;
    font-family: var(--font-mono);
    cursor: pointer;
  }
  .research-figure details p {
    margin: var(--step-16) 0;
  }
  .research-figure details a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 720px) {
    .research-figure {
      grid-column: 1/-1;
      margin-top: var(--step-32);
    }
  }
</style>
