---
import './readouts.css';
import Network from './Network.astro';
import Symbol from './MathSymbol.astro';
import recording from '../../../data/research/l2o-training-snapshots.json';
---

<div class="training-composition" data-training-composition>
  <div class="landscape">
    <slot />
  </div>
  <div class="problem" data-module="problem">
    <h1 class="problem-family">Parametric MINLP</h1>
    <math
      xmlns="http://www.w3.org/1998/Math/MathML"
      display="block"
      aria-label="Minimize (a minus x) squared plus 50 times (y minus x squared) squared, over real x and integer y, subject to y at least b over 2, x squared at most b, x at most zero and y at least zero. a and b are problem parameters."
    >
      <mtable columnalign="right left" columnspacing=".75em" rowspacing=".55em">
        <mtr>
          <mtd><munder><mo>min</mo><mrow><mi>x</mi><mo>∈</mo><mi>ℝ</mi><mo>,</mo><mi>y</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mtd>
          <mtd><msup><mrow><mo>(</mo><mpadded class="problem-parameter" width=".85em" lspace=".14em" height=".85em" depth=".2em"><mi>a</mi></mpadded><mo>−</mo><mi>x</mi><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>50</mn><msup><mrow><mo>(</mo><mi>y</mi><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup><mo>)</mo></mrow><mn>2</mn></msup></mtd>
        </mtr>
        <mtr>
          <mtd><mtext>s.t.</mtext></mtd>
          <mtd><mi>y</mi><mo>≥</mo><mfrac><mpadded class="problem-parameter" width=".85em" lspace=".14em" height=".85em" depth=".2em"><mi>b</mi></mpadded><mn>2</mn></mfrac><mo>,</mo><mspace width=".45em"/><msup><mi>x</mi><mn>2</mn></msup><mo>≤</mo><mpadded class="problem-parameter" width=".85em" lspace=".14em" height=".85em" depth=".2em"><mi>b</mi></mpadded></mtd>
        </mtr>
        <mtr>
          <mtd></mtd><mtd><mi>x</mi><mo>≤</mo><mn>0</mn><mo>,</mo><mspace width=".45em"/><mi>y</mi><mo>≥</mo><mn>0</mn></mtd>
        </mtr>
      </mtable>
    </math>
  </div>
  <div class="parameters" data-module="parameters">
    <p class="eyeline">Instance parameters</p>
    <div class="parameter-values">
      <span>
        <span class="parameter-chip">
          <Symbol base="a" readout />
        </span>
        <b>{recording.parameters.a.toFixed(3)}</b>
      </span>
      <span>
        <span class="parameter-chip">
          <Symbol base="b" readout />
        </span>
        <b>{recording.parameters.b.toFixed(3)}</b>
      </span>
    </div>
  </div>
  <section
    class="mapping instrument-panel"
    data-module="mapping"
    aria-label="Relaxed mapping instrument"
  >
    <div class="network-face">
      <h3>Relaxed mapping</h3>
      <Network id="relaxed-mapping" />
    </div>
    <div class="panel-readout" data-module="relaxed">
      <p class="eyeline">Relaxed prediction</p>
      <div class="prediction-readings">
        <span>
          <Symbol readout base="x" accent="bar" />
          <b class="instrument-value" data-reading="relaxed-x">
            —
          </b>
        </span>
        <span>
          <Symbol readout base="y" accent="bar" />
          <b class="instrument-value" data-reading="relaxed-y">
            —
          </b>
        </span>
      </div>
    </div>
  </section>
  <section
    class="correction instrument-panel"
    data-module="correction"
    aria-label="Integer correction instrument"
  >
    <div class="network-face">
      <h3>Integer correction</h3>
      <Network id="integer-correction" />
    </div>
    <div class="panel-readout" data-module="hidden">
      <p class="eyeline">Hidden state</p>
      <div class="prediction-readings">
        <span>
          <Symbol readout base="h" sub="x" />
          <b class="instrument-value" data-reading="delta-x">
            —
          </b>
        </span>
        <span>
          <Symbol readout base="h" sub="y" />
          <b class="instrument-value" data-reading="hidden-y">
            —
          </b>
        </span>
      </div>
    </div>
  </section>
  <section
    class="correction-operations instrument-panel"
    data-module="operations"
    aria-label="Differentiable Update instrument"
  >
    <div class="variable-visual">
      <h3>Differentiable Update</h3>
      <div class="operation" data-module="continuous">
        <div class="operation-heading">
          <span>Continuous</span>
        </div>
        <div class="operation-body">
          <svg viewBox="0 0 48 30" aria-hidden="true">
            <path d="M4 22H44M4 17V27M44 17V27" />
            <circle class="icon-body slider" cx="12" cy="22" r="4" />
            <circle class="icon-motion slider-light" cx="12" cy="22" r="4" />
          </svg>
          <math xmlns="http://www.w3.org/1998/Math/MathML"><mover accent="true"><mi>x</mi><mo>^</mo></mover><mo>=</mo><mover accent="true"><mi>x</mi><mo>¯</mo></mover><mo>+</mo><msub><mi>h</mi><mi>x</mi></msub></math>
        </div>
      </div>
      <div class="operation integer-operation" data-module="rounding">
        <div class="operation-heading">
          <span>Integer</span>
        </div>
        <div class="operation-body">
          <svg viewBox="0 0 48 30" aria-hidden="true">
            <path d="M3 27H16V17H29V7H44" />
            <rect class="icon-body snap" x="12" y="13" width="8" height="8" />
            <rect class="icon-motion snap-light" x="12" y="13" width="8" height="8" />
          </svg>
          <math
            xmlns="http://www.w3.org/1998/Math/MathML"
            aria-label="Integer y is floor of relaxed y plus rounded sigmoid of the hidden y state"
          ><mover accent="true"><mi>y</mi><mo>^</mo></mover><mo>=</mo><mo>⌊</mo><mover accent="true"><mi>y</mi><mo>¯</mo></mover><mo>⌋</mo><mo>+</mo><mi mathvariant="normal">round</mi><mo>(</mo><mi>σ</mi><mo>(</mo><msub><mi>h</mi><mi>y</mi></msub><mo>)</mo><mo>)</mo></math>
        </div>
      </div>
    </div>
    <div class="panel-readout integer-output" data-module="integer">
      <p class="eyeline">Integer prediction</p>
      <div class="prediction-readings">
        <span>
          <Symbol readout base="x" accent="hat" />
          <b class="instrument-value" data-reading="integer-x">
            —
          </b>
        </span>
        <span>
          <Symbol readout base="y" accent="hat" />
          <b class="instrument-value" data-reading="integer-y">
            —
          </b>
        </span>
      </div>
    </div>
  </section>
  <section
    class="training-loss instrument-panel"
    data-module="loss"
    aria-label="Loss evaluation instrument"
  >
    <div class="loss-explanation">
      <h3>Loss</h3>
      <div class="loss-terms">
        <div>
          <svg viewBox="0 0 28 22" aria-hidden="true">
            <path d="M2 2V20H27M6 5C9 5 10 17 16 17S22 10 26 6" />
            <circle class="icon-body objective-ball" cx="9.88" cy="11" r="2" />
            <circle class="icon-motion objective-ball-light" cx="9.88" cy="11" r="2" />
          </svg>
          <span>Objective</span>
        </div>
        <span class="loss-plus">+</span>
        <div>
          <svg viewBox="0 0 28 22" aria-hidden="true">
            <g>
              <path d="M11 2V20" />
              <path d="M3 3L11 7M3 9L11 13M3 15L11 19" opacity=".35" />
              <path class="icon-body constraint-distance" d="M11 11H21" stroke-dasharray="2 1.6" />
              <path d="M11 14H14V11" opacity=".65" />
            </g>
            <circle class="icon-body constraint-ball" cx="24" cy="11" r="2.1" />
            <circle class="icon-motion constraint-ball-light" cx="24" cy="11" r="2.1" />
          </svg>
          <span>penalty weight × Constraint violation</span>
        </div>
      </div>
    </div>
    <div class="loss-readings">
      <div>
        <span class="eyeline">Objective</span>
        <b class="instrument-value" data-reading="objective">
          —
        </b>
      </div>
      <div>
        <span class="eyeline">Violation</span>
        <b class="instrument-value" data-reading="violation">
          —
        </b>
      </div>
      <div>
        <span class="eyeline">Gap</span>
        <b class="instrument-value" data-reading="gap">
          —
        </b>
      </div>
    </div>
  </section>
  <svg class="training-connections" aria-hidden="true"></svg>
</div>

<style>
  .training-composition {
    --label-ink: #a2afbf;
    --module-field: #879bb2;
    --module-ink: #101b29;
    --output-field: #141b24;
    --reading: #c3cedd;
    --readout-size: 13px;
    --signal-core: #e0eafa;
    --value-ink: #d3dfef;
    isolation: isolate;
    position: relative;
    height: clamp(520px, 91.6667cqw, 539px);
    width: 100%;
    color: var(--muted);
    container-type: inline-size;
  }
  h3,
  p {
    margin: 0;
  }
  .landscape {
    left: auto;
    position: absolute;
    right: -14px;
    top: -14px;
    z-index: 0;
    max-width: 408px;
    width: 69.5%;
  }
  .problem,
  .parameters,
  .instrument-panel {
    position: absolute;
    z-index: 2;
  }
  .problem {
    left: 0;
    top: 5px;
    display: grid;
    gap: 14px; /* optical: separate the problem family from its definition. */
    width: 49%;
    color: #adb5c0;
  }
  .problem math {
    display: block;
    margin: 0;
    width: max-content;
    font-family: Georgia, serif;
    font-size: 19px;
    text-align: left;
  }
  .problem-family {
    margin: 0;
    font: 500 15px/1.2 var(--font);
    letter-spacing: -0.015em;
    color: var(--blue);
  }
  .problem-parameter {
    color: var(--blue);
  }
  .parameter-chip {
    display: inline-grid;
    place-items: center;
    height: 22px;
    width: 20px;
    color: var(--blue);
  }
  .parameter-chip :global(math) {
    color: inherit;
  }
  .problem mtd:nth-child(2) {
    text-align: left;
  }
  .parameters {
    left: 0;
    top: 33%;
    width: 40%;
  }
  .eyeline {
    font: 10px/1.3 var(--font);
    color: inherit;
  }
  .parameter-values {
    display: inline-flex;
    gap: 26px; /* optical: spacing within the illustration, independent of the page grid. */
    margin-top: 8px; /* optical: spacing within the illustration, independent of the page grid. */
    color: var(--reading);
  }
  .parameter-values > span {
    align-items: baseline;
    display: flex;
    gap: 9px; /* optical: spacing within the illustration, independent of the page grid. */
  }
  .parameter-values :global(math) {
    font-size: 17px;
  }
  .parameter-values b {
    font: 400 var(--readout-size)/1.3 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .instrument-panel {
    min-width: 0;
    width: 29%;
    background: var(--output-field);
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 0 100%);
    color: var(--reading);
  }
  .mapping,
  .correction,
  .correction-operations {
    display: grid;
    grid-template-rows: 112px 58px;
    height: 170px;
  }
  .mapping {
    left: 0;
    top: calc(48% + 14px);
  }
  .correction {
    left: 35.5%;
    top: calc(48% + 14px);
  }
  .network-face {
    position: relative;
    height: 112px;
    background: var(--module-field);
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 0 100%);
    color: var(--module-ink);
  }
  h3 {
    font: 600 12px/1.2 var(--font);
    letter-spacing: -0.015em;
  }
  .network-face h3 {
    left: 10px;
    position: absolute;
    top: 10px;
    font-weight: 500;
    color: var(--module-ink);
  }
  .network-face :global(svg) {
    left: 50%;
    position: absolute;
    top: 32px;
    height: 72px;
    max-width: 82%;
    width: 118px;
    transform: translateX(-50%);
  }
  .panel-readout {
    display: grid;
    gap: 6px; /* optical: spacing within the illustration, independent of the page grid. */
    grid-template-rows: 12px 24px;
    height: 58px;
    min-width: 0;
    outline-offset: 3px;
    padding: 8px 10px; /* optical: spacing within the illustration, independent of the page grid. */
    background: var(--output-field);
  }
  .panel-readout .eyeline {
    font-size: 10px;
    color: var(--label-ink);
    opacity: 1;
  }
  .prediction-readings {
    display: grid;
    gap: 4px; /* optical: keep the paired full-size readouts inside their shared field. */
    grid-template-columns: 1fr 1fr;
    height: 24px;
    margin: 0;
    font: 400 var(--readout-size)/24px var(--font-mono);
  }
  .prediction-readings > span {
    align-items: baseline;
    display: grid;
    gap: 2px; /* optical: align the fixed symbol and value lanes across all readouts. */
    grid-template-columns: 16px minmax(0, 1fr);
    height: 24px;
    white-space: nowrap;
  }
  .prediction-readings :global(math) {
    flex: none;
    font-size: 16px;
  }
  .instrument-value {
    position: relative;
    display: inline-block;
    height: 1.3em;
    overflow: hidden;
    font: 400 var(--readout-size)/1.3 var(--font-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    white-space: nowrap;
    color: var(--value-ink);
  }
  .instrument-value :global(.readout-current),
  .instrument-value :global(.readout-old) {
    display: block;
    white-space: nowrap;
  }
  .instrument-value :global(.readout-old) {
    inset: 0;
    position: absolute;
  }
  .correction-operations {
    right: 0;
    top: calc(48% + 14px);
    padding: 0;
  }
  .variable-visual {
    display: grid;
    gap: 4px; /* optical: spacing within the illustration, independent of the page grid. */
    grid-template-rows: 14px 40px 40px;
    height: 112px;
    padding: 10px 10px 0; /* optical: spacing within the illustration, independent of the page grid. */
    background: var(--module-field);
    color: var(--module-ink);
  }
  .variable-visual > h3 {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 14px;
    color: var(--module-ink);
  }
  .operation {
    position: relative;
    min-height: 0;
    min-width: 0;
    padding: 4px 6px; /* optical: spacing within the illustration, independent of the page grid. */
    padding-left: 0;
    padding-right: 0;
    background: none;
    color: var(--module-ink);
  }
  .integer-operation {
    margin: 0;
    background: none;
  }
  .operation-heading {
    height: 11px;
    font: 9px/11px var(--font);
    color: #1c2b3e;
  }
  .operation-body {
    align-items: center;
    display: flex;
    height: 19px;
    margin-top: 2px; /* optical: spacing within the illustration, independent of the page grid. */
  }
  .operation-body > svg {
    position: absolute;
    right: 0;
    top: 2px;
    flex: none;
    height: 17px;
    width: 28px;
    color: var(--module-ink);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
  }
  .operation-body > svg circle,
  .operation-body > svg rect {
    fill: currentColor;
    stroke: none;
  }
  .operation-body > math {
    justify-self: start;
    font:
      11.25px Georgia,
      serif;
    inline-size: max-content;
  }
  .training-loss {
    bottom: 0;
    left: 10%;
    top: auto;
    column-gap: 14px; /* optical: spacing within the illustration, independent of the page grid. */
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    height: 70px;
    padding: 10px 12px; /* optical: spacing within the illustration, independent of the page grid. */
    width: 90%;
    background: var(--output-field);
  }
  .loss-explanation {
    align-items: center;
    display: flex;
    gap: 10px; /* optical: spacing within the illustration, independent of the page grid. */
    padding: 0 8px 0 0; /* optical: centre the terms beside the loss label. */
    background: var(--module-field);
    color: var(--module-ink);
  }
  .loss-explanation h3 {
    align-self: stretch;
    display: grid;
    place-items: center;
    border-right: 1px solid #263b552b;
    min-width: 40px;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
    color: var(--module-ink);
  }
  .loss-terms {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 1px; /* optical: spacing within the illustration, independent of the page grid. */
    justify-content: center;
    font: 11.5px/1.25 var(--font);
  }
  .loss-terms > div {
    align-items: center;
    display: flex;
    gap: 7px; /* optical: spacing within the illustration, independent of the page grid. */
  }
  .loss-terms svg {
    flex: none;
    height: 18px;
    width: 22px;
    color: var(--module-ink);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .loss-terms svg circle {
    fill: currentColor;
    stroke: none;
  }
  .loss-plus {
    align-self: center;
    padding-left: 0;
    /* optical: spacing within the illustration, independent of the page grid. */
    font:
      14px/8px Georgia,
      serif;
  }
  .loss-readings {
    align-content: center;
    display: grid;
    gap: 8px; /* optical: spacing within the illustration, independent of the page grid. */
    grid-template-columns: 1.15fr 1fr 0.8fr;
    border-left: 1px solid #aebdc92b;
    border-left-color: #9aaac12b;
    padding-left: 12px; /* optical: spacing within the illustration, independent of the page grid. */
  }
  .loss-readings > div {
    display: flex;
    flex-direction: column;
    gap: 7px; /* optical: spacing within the illustration, independent of the page grid. */
  }
  .loss-readings .eyeline {
    font-size: 10px;
    color: var(--label-ink);
  }
  .training-connections {
    inset: 0;
    position: absolute;
    z-index: 1;
    height: 100%;
    overflow: visible;
    width: 100%;
    pointer-events: none;
  }
  .training-connections :global(path) {
    fill: none;
    stroke-linecap: butt;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .training-connections :global(polygon) {
    fill: #9caab9;
    stroke: none;
  }
  .training-composition :global(.signal) {
    opacity: 0;
    stroke-width: 2.5;
    filter: none;
    stroke: var(--signal-core);
  }
  @container (max-width:560px) {
    .training-composition {
      --compact-instrument-width: min(100%, 264px);
      --update-icon-lane: 34px;
      --update-label-width: 54px;
      aspect-ratio: auto;
      height: calc(517px + 83.3333cqw);
    }
    .landscape {
      left: 0;
      right: 0;
      top: 50px;
      max-width: none;
      width: 100%;
    }
    .problem {
      top: calc(83.3333cqw - 58px);
      gap: 6px; /* optical: nest the compact equation in the surface's lower-left negative space. */
      padding: 0;
      width: max-content;
      text-shadow:
        -1px -1px 0 var(--ink),
        0 -1px 0 var(--ink),
        1px -1px 0 var(--ink),
        -1px 0 0 var(--ink),
        1px 0 0 var(--ink),
        -1px 1px 0 var(--ink),
        0 1px 0 var(--ink),
        1px 1px 0 var(--ink);
    }
    .problem math {
      font-size: 12px;
    }
    .problem-family {
      font-size: 12px;
    }
    .problem-parameter {
      text-shadow: none;
    }
    .parameters {
      left: 50%;
      top: calc(50px + 83.3333cqw);
      display: block;
      height: 48px;
      padding: 0;
      width: max-content;
      transform: translateX(-50%);
    }
    .parameter-values {
      display: grid;
      gap: 36px; /* optical: compact input pairs leave a clear central signal lane. */
      grid-template-columns: max-content max-content;
      margin-top: 8px; /* optical: align the input readings under their shared label. */
      width: max-content;
    }
    .parameter-values :global(math) {
      font-size: 16px;
    }
    .parameters .eyeline {
      font-size: 9px;
    }
    .instrument-panel {
      width: 45%;
    }
    .mapping,
    .correction {
      grid-template-rows: 94px 48px;
      height: 142px;
    }
    .mapping {
      left: 0;
      top: calc(126px + 83.3333cqw);
    }
    .correction {
      left: 55%;
      top: calc(126px + 83.3333cqw);
    }
    .network-face {
      height: 94px;
    }
    .network-face h3 {
      left: 9px;
      top: 10px;
      font-size: 11px;
    }
    .network-face :global(svg) {
      top: 27px;
      height: 58px;
      width: 102px;
    }
    .panel-readout {
      gap: 4px; /* optical: spacing within the illustration, independent of the page grid. */
      grid-template-rows: 10px 20px;
      height: 48px;
      padding: 6px; /* optical: preserve room for two equal full-size readings. */
    }
    .prediction-readings {
      gap: 4px; /* optical: group two readings without shrinking their digits. */
      height: 20px;
      font: 400 var(--readout-size)/20px var(--font-mono);
    }
    .prediction-readings > span {
      gap: 2px; /* optical: a fixed symbol lane keeps every value on one baseline. */
      grid-template-columns: 16px minmax(0, 1fr);
      height: 20px;
    }
    .prediction-readings :global(math) {
      font-size: 16px;
    }
    .panel-readout .eyeline {
      font-size: 9px;
    }
    .correction-operations {
      left: 50%;
      right: auto;
      top: calc(286px + 83.3333cqw);
      display: grid;
      grid-template-rows: 76px 44px;
      height: auto;
      padding: 0;
      width: var(--compact-instrument-width);
      transform: translateX(-50%);
    }
    .variable-visual {
      display: grid;
      gap: 3px; /* optical: compact the two formulas without crowding their baselines. */
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 12px 24px 24px;
      height: 76px;
      padding: 8px 10px 2px; /* optical: a compact face leaves the results their own clear strip. */
    }
    .variable-visual > h3 {
      grid-column: 1/-1;
      margin: 0;
      font-size: 11px;
      line-height: 12px;
    }
    .operation {
      align-items: center;
      display: grid;
      grid-template-columns: var(--update-label-width) minmax(0, 1fr);
      height: 24px;
