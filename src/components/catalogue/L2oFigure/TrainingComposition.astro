---
import Network from './Network.astro';
import Symbol from './MathSymbol.astro';
import recording from '../../../data/research/l2o-training-snapshots.json';

interface Props {
  presentation?: boolean;
}
const { presentation = false } = Astro.props;
---

<div class="training-composition" data-training-composition>
  <h1 class="training-title">
    Learning to generate
    <br />
    integer solutions
  </h1>
  <div class="landscape">
    <slot />
  </div>
  <div class="problem" data-module="problem">
    <math
      xmlns="http://www.w3.org/1998/Math/MathML"
      display="block"
      aria-label="Parametric mixed-integer problem"
    ><mtable columnalign="center left" columnspacing=".55em" rowspacing=".4em"><mtr><mtd><munder><mo>min</mo><mrow><mi>x</mi><mo>∈</mo><mi>ℝ</mi><mo>,</mo><mi>y</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mtd><mtd><msup><mrow><mo>(</mo><mi>a</mi><mo>−</mo><mi>x</mi><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>50</mn><msup><mrow><mo>(</mo><mi>y</mi><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup><mo>)</mo></mrow><mn>2</mn></msup></mtd></mtr><mtr><mtd><mtext>s.t.</mtext></mtd><mtd><mi>y</mi><mo>≥</mo><mfrac><mi>b</mi><mn>2</mn></mfrac><mo>,</mo><msup><mi>x</mi><mn>2</mn></msup><mo>≤</mo><mi>b</mi><mo>,</mo><mi>x</mi><mo>≤</mo><mn>0</mn><mo>,</mo><mi>y</mi><mo>≥</mo><mn>0</mn></mtd></mtr></mtable></math>
  </div>
  <div class="parameters" data-module="parameters">
    <p class="eyeline">Input parameters</p>
    <div class="parameter-values">
      <span>
        <Symbol base="a" />
        <b>{recording.parameters.a.toFixed(3)}</b>
      </span>
      <span>
        <Symbol base="b" />
        <b>{recording.parameters.b.toFixed(3)}</b>
      </span>
    </div>
  </div>
  <section
    class="mapping instrument-panel"
    data-module="mapping"
    aria-label="Relaxed mapping instrument"
  >
    <div class="network-face">
      <h3>Relaxed mapping</h3>
      <Network id="relaxed-mapping" />
    </div>
    <div
      class="panel-readout"
      data-module="relaxed"
      data-focus-kind={presentation ? undefined : 'relaxed'}
      tabindex={presentation ? undefined : 0}
      aria-label={presentation ? undefined : 'Highlight relaxed prediction'}
    >
      <p class="eyeline">Relaxed prediction</p>
      <div class="prediction-readings">
        <span>
          <Symbol readout base="x" accent="bar" />
          <b class="instrument-value" data-reading="relaxed-x">
            —
          </b>
        </span>
        <span>
          <Symbol readout base="y" accent="bar" />
          <b class="instrument-value" data-reading="relaxed-y">
            —
          </b>
        </span>
      </div>
    </div>
  </section>
  <section
    class="correction instrument-panel"
    data-module="correction"
    aria-label="Integer correction instrument"
  >
    <div class="network-face">
      <h3>Integer correction</h3>
      <Network id="integer-correction" />
    </div>
    <div class="hidden-state panel-readout" data-module="hidden">
      <p class="eyeline">Hidden state</p>
      <div class="prediction-readings">
        <span>
          <Symbol readout base="h" sub="x" />
          <b class="instrument-value" data-reading="delta-x">
            —
          </b>
        </span>
        <span>
          <Symbol readout base="h" sub="y" />
          <b class="instrument-value" data-reading="hidden-y">
            —
          </b>
        </span>
      </div>
    </div>
  </section>
  <section
    class="correction-operations instrument-panel"
    data-module="operations"
    aria-label="Differentiable Update instrument"
  >
    <div class="variable-visual">
      <h3>Differentiable Update</h3>
      <div class="operation" data-module="continuous">
        <div class="operation-heading">
          <span>Continuous</span>
        </div>
        <div class="operation-body">
          <svg viewBox="0 0 48 30" aria-hidden="true">
            <path d="M4 22H44M4 17V27M44 17V27" />
            {!presentation && <path d="M12 6H35L30 2M35 6L30 10" />}
            <circle class="icon-body slider" cx="12" cy="22" r="4" />
            <circle class="icon-motion slider-light" cx="12" cy="22" r="4" />
          </svg>
          <math xmlns="http://www.w3.org/1998/Math/MathML"><mover accent="true"><mi>x</mi><mo>^</mo></mover><mo>=</mo><mover accent="true"><mi>x</mi><mo>¯</mo></mover><mo>+</mo><msub><mi>h</mi><mi>x</mi></msub></math>
        </div>
      </div>
      <div class="operation integer-operation" data-module="rounding">
        <div class="operation-heading">
          <span>Integer</span>
        </div>
        <div class="operation-body">
          <svg viewBox="0 0 48 30" aria-hidden="true">
            <path d="M3 27H16V17H29V7H44" />
            <rect class="icon-body snap" x="12" y="13" width="8" height="8" />
            <rect class="icon-motion snap-light" x="12" y="13" width="8" height="8" />
          </svg>
          <math
            xmlns="http://www.w3.org/1998/Math/MathML"
            aria-label="Integer y is floor of relaxed y plus rounded sigmoid of the hidden y state"
          ><mover accent="true"><mi>y</mi><mo>^</mo></mover><mo>=</mo><mo>⌊</mo><mover accent="true"><mi>y</mi><mo>¯</mo></mover><mo>⌋</mo><mo>+</mo><mi mathvariant="normal">round</mi><mo>(</mo><mi>σ</mi><mo>(</mo><msub><mi>h</mi><mi>y</mi></msub><mo>)</mo><mo>)</mo></math>
        </div>
      </div>
    </div>
    <div
      class="panel-readout integer-output"
      data-module="integer"
      data-focus-kind={presentation ? undefined : 'integer'}
      tabindex={presentation ? undefined : 0}
      aria-label={presentation ? undefined : 'Highlight integer prediction'}
    >
      <p class="eyeline">Integer prediction</p>
      <div class="prediction-readings">
        <span>
          <Symbol readout base="x" accent="hat" />
          <b class="instrument-value" data-reading="integer-x">
            —
          </b>
        </span>
        <span>
          <Symbol readout base="y" accent="hat" />
          <b class="instrument-value" data-reading="integer-y">
            —
          </b>
        </span>
      </div>
    </div>
  </section>
  <section
    class="training-loss instrument-panel"
    data-module="loss"
    aria-label="Loss evaluation instrument"
  >
    <div class="loss-explanation">
      <h3>Loss</h3>
      <div class="loss-terms">
        <div>
          <svg class="objective-icon" viewBox="0 0 28 22" aria-hidden="true">
            <path d="M2 2V20H27M6 5C9 5 10 17 16 17S22 10 26 6" />
            <circle class="icon-body objective-ball" cx="9.88" cy="11" r="2" />
            <circle class="icon-motion objective-ball-light" cx="9.88" cy="11" r="2" />
          </svg>
          <span>Objective</span>
        </div>
        <span class="loss-plus">+</span>
        <div>
          <svg class="constraint-icon" viewBox="0 0 28 22" aria-hidden="true">
            <g class="constraint-boundary">
              <path d="M11 2V20" />
              <path d="M3 3L11 7M3 9L11 13M3 15L11 19" opacity=".35" />
              <path class="icon-body constraint-distance" d="M11 11H21" stroke-dasharray="2 1.6" />
              <path d="M11 14H14V11" opacity=".65" />
            </g>
            <circle class="icon-body constraint-ball" cx="24" cy="11" r="2.1" />
            <circle class="icon-motion constraint-ball-light" cx="24" cy="11" r="2.1" />
          </svg>
          <span>penalty weight × Constraint violation</span>
        </div>
      </div>
    </div>
    <div class="loss-readings">
      <div>
        <span class="eyeline">Objective</span>
        <b class="instrument-value" data-reading="objective">
          —
        </b>
      </div>
      <div>
        <span class="eyeline">Violation</span>
        <b class="instrument-value" data-reading="violation">
          —
        </b>
      </div>
      <div>
        <span class="eyeline">Gap</span>
        <b class="instrument-value" data-reading="gap">
          —
        </b>
      </div>
    </div>
  </section>
  <svg class="training-connections" aria-hidden="true"></svg>
</div>

<style>
  .training-composition {
    --plate-blue: #7f9ab5;
    --plate-ink: #182b3d;
    --plate-light: #aebdc9;
    --reading: #c8d0d7;
    --readout-bg: #182027;
    position: relative;
    height: clamp(520px, 91.6667cqw, 539px);
    width: 100%;
    color: var(--muted);
    container-type: inline-size;
  }
  .training-title,
  h3,
  p {
    margin: 0;
  }
  .training-composition .training-title {
    left: 0;
    position: absolute;
    top: 0;
    z-index: 2;
    font: 400 clamp(26px, 5.65cqw, 35px)/1.05 var(--font-serif);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 11;
    letter-spacing: var(--tracking-title);
    color: var(--blue);
  }
  .landscape {
    left: auto;
    position: absolute;
    right: -14px;
    top: -14px;
    z-index: 0;
    max-width: 408px;
    width: 69.5%;
  }
  .problem,
  .parameters,
  .instrument-panel {
    position: absolute;
    z-index: 2;
  }
  .problem {
    left: 0;
    top: 18.5%;
    width: 43%;
    color: var(--muted);
  }
  .problem math {
    display: block;
    margin: 0;
    width: max-content;
    font-family: Georgia, serif;
    font-size: 14px;
    text-align: left;
  }
  .problem mtd:nth-child(2) {
    text-align: left;
  }
  .parameters {
    left: 0;
    top: 33%;
    width: 40%;
  }
  .eyeline {
    font: 10px/1.3 var(--font);
    color: inherit;
  }
  .parameter-values {
    display: inline-flex;
    gap: 26px; /* optical: spacing within the illustration, independent of the page grid. */
    margin-top: 8px; /* optical: spacing within the illustration, independent of the page grid. */
    color: var(--reading);
  }
  .parameter-values > span {
    align-items: baseline;
    display: flex;
    gap: 9px; /* optical: spacing within the illustration, independent of the page grid. */
  }
  .parameter-values :global(math) {
    font-size: 17px;
  }
  .parameter-values b {
    font: 400 14px/1.3 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .instrument-panel {
    min-width: 0;
    width: 29%;
    background: var(--readout-bg);
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 0 100%);
    color: var(--reading);
  }
  .mapping,
  .correction,
  .correction-operations {
    display: grid;
    grid-template-rows: 112px 58px;
    height: 170px;
  }
  .mapping {
    left: 0;
    top: calc(48% + 14px);
  }
  .correction {
    left: 35.5%;
    top: calc(48% + 14px);
  }
  .network-face {
    position: relative;
    height: 112px;
    background: var(--plate-light);
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 0 100%);
    color: var(--plate-ink);
  }
  .correction .network-face {
    background: var(--plate-blue);
  }
  h3 {
    font: 600 12px/1.2 var(--font);
    letter-spacing: -0.015em;
  }
  .network-face h3 {
    left: 10px;
    position: absolute;
    top: 10px;
  }
  .network-face :global(svg) {
    left: 50%;
    position: absolute;
    top: 32px;
    height: 72px;
    max-width: 82%;
    width: 118px;
    transform: translateX(-50%);
  }
  .panel-readout {
    display: grid;
    gap: 6px; /* optical: spacing within the illustration, independent of the page grid. */
    grid-template-rows: 12px 24px;
    height: 58px;
    min-width: 0;
    outline-offset: 3px;
    padding: 8px 10px; /* optical: spacing within the illustration, independent of the page grid. */
    transition: background 0.15s;
  }
  .panel-readout[data-focus-kind] {
    cursor: pointer;
  }
  .panel-readout[data-focus-kind]:hover,
  .panel-readout[data-focus-kind]:focus-visible {
    background: #26323d;
  }
  .panel-readout .eyeline {
    font-size: 10px;
    opacity: 0.85;
  }
  .prediction-readings {
    display: grid;
    gap: 10px; /* optical: spacing within the illustration, independent of the page grid. */
    grid-template-columns: 1fr 1fr;
    height: 24px;
    margin: 0;
    font:
      16px/24px Georgia,
      serif;
  }
  .prediction-readings > span {
    align-items: baseline;
    display: grid;
    gap: 4px; /* optical: spacing within the illustration, independent of the page grid. */
    grid-template-columns: 18px minmax(0, 1fr);
    height: 24px;
    white-space: nowrap;
  }
  .prediction-readings :global(math) {
    flex: none;
    font-size: 16px;
  }
  .instrument-value {
    position: relative;
    display: inline-block;
    height: 1.3em;
    overflow: hidden;
    font: 400 13px/1.3 var(--font-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    white-space: nowrap;
  }
  .instrument-value :global(.readout-current),
  .instrument-value :global(.readout-old) {
    display: block;
    white-space: nowrap;
  }
  .instrument-value :global(.readout-old) {
    inset: 0;
    position: absolute;
  }
  .correction-operations {
    right: 0;
    top: calc(48% + 14px);
    padding: 0;
  }
  .variable-visual {
    display: grid;
    gap: 4px; /* optical: spacing within the illustration, independent of the page grid. */
    grid-template-rows: 14px 40px 40px;
    height: 112px;
    padding: 10px 10px 0; /* optical: spacing within the illustration, independent of the page grid. */
  }
  .variable-visual > h3 {
    margin: 0;
    font-size: 12px;
    line-height: 14px;
  }
  .operation {
    position: relative;
    min-height: 0;
    min-width: 0;
    padding: 4px 6px; /* optical: spacing within the illustration, independent of the page grid. */
    background: var(--plate-light);
    color: var(--plate-ink);
  }
  .integer-operation {
    margin: 0;
    background: var(--plate-blue);
  }
  .operation-heading {
    height: 11px;
    font: 9px/11px var(--font);
  }
  .operation-body {
    align-items: center;
    display: flex;
    height: 19px;
    margin-top: 2px; /* optical: spacing within the illustration, independent of the page grid. */
  }
  .operation-body > svg {
    position: absolute;
    right: 5px;
    top: 2px;
    flex: none;
    height: 17px;
    width: 28px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
  }
  .operation-body > svg circle,
  .operation-body > svg rect {
    fill: currentColor;
    stroke: none;
  }
  .operation-body > math {
    justify-self: start;
    font:
      11.25px Georgia,
      serif;
    inline-size: max-content;
  }
  .training-loss {
    bottom: 0;
    left: 10%;
    top: auto;
    column-gap: 14px; /* optical: spacing within the illustration, independent of the page grid. */
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    height: 70px;
    padding: 10px 12px; /* optical: spacing within the illustration, independent of the page grid. */
    width: 90%;
    background: #1c252d;
  }
  .loss-explanation {
    align-items: center;
    display: flex;
    gap: 10px; /* optical: spacing within the illustration, independent of the page grid. */
  }
  .loss-explanation h3 {
    align-self: stretch;
    display: grid;
    place-items: center;
    min-width: 40px;
    font-size: 13px;
    background: var(--plate-light);
    color: var(--plate-ink);
  }
  .loss-terms {
    display: flex;
    flex-direction: column;
    gap: 1px; /* optical: spacing within the illustration, independent of the page grid. */
    font: 11.5px/1.25 var(--font);
  }
  .loss-terms > div {
    align-items: center;
    display: flex;
    gap: 7px; /* optical: spacing within the illustration, independent of the page grid. */
  }
  .loss-terms svg {
    flex: none;
    height: 18px;
    width: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .loss-terms svg circle {
    fill: currentColor;
    stroke: none;
  }
  .loss-plus {
    padding-left: 0; /* optical: spacing within the illustration, independent of the page grid. */
    font:
      14px/8px Georgia,
      serif;
  }
  .loss-readings {
    align-content: center;
    display: grid;
    gap: 8px; /* optical: spacing within the illustration, independent of the page grid. */
    grid-template-columns: 1.15fr 1fr 0.8fr;
    border-left: 1px solid #aebdc92b;
    padding-left: 12px; /* optical: spacing within the illustration, independent of the page grid. */
  }
  .loss-readings > div {
    display: flex;
    flex-direction: column;
    gap: 7px; /* optical: spacing within the illustration, independent of the page grid. */
  }
  .loss-readings .eyeline {
    font-size: 10px;
  }
  .loss-readings .instrument-value {
    font-size: 15px;
  }
  .training-connections {
    inset: 0;
    position: absolute;
    z-index: 1;
    height: 100%;
    overflow: visible;
    width: 100%;
    pointer-events: none;
  }
  .training-connections :global(path) {
    fill: none;
    stroke-linecap: butt;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .training-connections :global(polygon) {
    stroke: none;
  }
  .training-composition :global(.signal) {
    opacity: 0;
    stroke: #e9f0f6;
    stroke-width: 2.5;
  }
  @container (max-width:560px) {
    .training-composition {
      aspect-ratio: auto;
      height: calc(635px + 83.3333cqw);
    }
    .training-composition .training-title {
      font-size: 28px;
    }
    .landscape {
      left: 0;
      right: 0;
      top: 126px;
      max-width: none;
      width: 100%;
    }
    .problem {
      top: 78px;
      padding: 8px 10px; /* optical: position the corner equation against the plot. */
      width: max-content;
    }
    .problem math {
      font-size: 12px;
    }
    .parameters {
      left: 50%;
      top: calc(114px + 83.3333cqw);
      display: block;
      height: 48px;
      padding: 0;
      width: max-content;
      transform: translateX(-50%);
    }
    .parameter-values {
      display: grid;
      gap: 36px; /* optical: compact input pairs leave a clear central signal lane. */
      grid-template-columns: max-content max-content;
      margin-top: 8px; /* optical: align the input readings under their shared label. */
      width: max-content;
    }
    .parameter-values > span {
      gap: 9px; /* optical: spacing within the illustration, independent of the page grid. */
    }
    .parameter-values :global(math) {
      font-size: 16px;
    }
    .parameter-values b {
      font-size: 13px;
    }
    .parameters .eyeline {
      font-size: 9px;
    }
    .instrument-panel {
      width: 45%;
    }
    .mapping,
    .correction {
      grid-template-rows: 94px 48px;
      height: 142px;
    }
    .correction-operations {
      height: auto;
    }
    .mapping {
      left: 0;
      top: calc(190px + 83.3333cqw);
    }
    .correction {
      left: 55%;
      top: calc(190px + 83.3333cqw);
    }
    .network-face {
      height: 94px;
    }
    .network-face h3 {
      left: 9px;
      top: 10px;
      font-size: 11px;
    }
    .network-face :global(svg) {
      top: 27px;
      height: 58px;
      width: 102px;
    }
    .panel-readout {
      gap: 4px; /* optical: spacing within the illustration, independent of the page grid. */
      grid-template-rows: 10px 20px;
      height: 48px;
      padding: 6px 8px; /* optical: spacing within the illustration, independent of the page grid. */
    }
    .prediction-readings {
      gap: 7px; /* optical: spacing within the illustration, independent of the page grid. */
      height: 20px;
      line-height: 20px;
    }
    .prediction-readings > span {
      gap: 3px; /* optical: spacing within the illustration, independent of the page grid. */
      grid-template-columns: 16px minmax(0, 1fr);
      height: 20px;
    }
    .prediction-readings :global(math) {
      font-size: 14px;
    }
    .instrument-value {
      font-size: 10px;
    }
    .panel-readout .eyeline {
      font-size: 8px;
    }
    .correction-operations {
      left: 50%;
      right: auto;
      top: calc(350px + 83.3333cqw);
      display: grid;
      grid-template-rows: 96px 48px;
      padding: 0;
      width: clamp(min(100%, 288px), calc(100% - 24px), 360px);
      transform: translateX(-50%);
    }
    .variable-visual {
      display: grid;
      gap: 4px; /* optical: each mobile update occupies one clear, aligned row. */
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 14px 32px 32px;
      height: 96px;
      padding: 8px 10px 2px; /* optical: header and operation rows share one left edge. */
    }
    .variable-visual > h3 {
      grid-column: 1/-1;
      margin: 0;
      font-size: 11px;
      line-height: 14px;
    }
    .integer-operation {
      margin: 0;
    }
    .operation {
      align-items: center;
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr);
      height: 32px;
      padding: 0;
    }
    .operation-heading {
      height: auto;
      font-size: 9.5px;
      line-height: 1.2;
    }
    .operation-body {
      height: 32px;
      margin-top: 0;
      padding-right: 38px; /* optical: reserve a common lane for both update icons. */
    }
    .operation-body > math {
      font-size: 12px;
    }
    .operation-body > svg {
      right: 0;
      top: 7px;
      height: 18px;
      width: 28px;
    }
    .integer-output {
      width: 100%;
    }
    .integer-output .prediction-readings {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .training-loss {
      bottom: auto;
      left: 50%;
      top: calc(515px + 83.3333cqw);
      gap: 0;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 68px 52px;
      height: 120px;
      padding: 0;
      width: clamp(min(100%, 288px), calc(100% - 24px), 360px);
      transform: translateX(-50%);
    }
    .loss-explanation {
      display: grid;
      gap: 8px; /* optical: give the equation its own full-width plate beside the title. */
