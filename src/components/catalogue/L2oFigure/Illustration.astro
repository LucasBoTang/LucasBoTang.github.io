---
import TrainingComposition from './TrainingComposition.astro';
---

<section class="l2o-material" data-l2o-material aria-label="Learning to generate integer solutions">
  <TrainingComposition>
    <div class="surface-study" data-l2o-surface>
      <div class="surface-stage">
        <canvas
          class="surface-gl"
          role="img"
          aria-label="Three-dimensional objective surface. Gray denotes inequality-infeasible regions; blue-green-gold regions satisfy the continuous constraints. Highlighted integer slices and four recorded relaxed–integer prediction pairs lie on the surface."
        ></canvas>
        <canvas class="surface-annotations" aria-hidden="true"></canvas>
        <div class="surface-hud" aria-label="Latest completed integer prediction">
          <div class="surface-legend">
            <span data-kind="relaxed">
              <i class="relaxed"></i>Relaxed
            </span>
            <span data-kind="integer">
              <i class="integer"></i>Integer
            </span>
          </div>
          <div class="hud-readouts">
            <div class="hud-row">
              <span class="hud-label">Step</span>
              <span class="hud-value" data-training-step>
                —
              </span>
            </div>

            <div class="hud-state" data-feasibility aria-label="Feasibility status">
              —
            </div>
          </div>
        </div>
        <p class="surface-fallback" hidden>
          The relaxed prediction is corrected to an integer solution.
        </p>
      </div>
    </div>
  </TrainingComposition>
  <noscript>
    <p class="static-description">
      A learned relaxed prediction is corrected to an integer solution. Training minimizes the
      objective and constraint violations.
    </p>
  </noscript>
</section>

<style>
  .l2o-material {
    width: 100%;
    container-type: inline-size;
  }
  .static-description {
    font: var(--type-body)/var(--line-body) var(--font);
    color: var(--muted);
  }
  .surface-study {
    position: relative;
    margin-top: 0;
  }
  .surface-stage {
    position: relative;
    aspect-ratio: 600/500;
    width: 100%;
  }
  .surface-stage canvas {
    position: absolute;
    display: block;
    height: 100%;
    width: 100%;
  }
  .surface-annotations {
    pointer-events: none;
  }
  .surface-fallback {
    inset: 35% 10%;
    position: absolute;
    font: 13px/1.8 var(--font);
    color: var(--muted);
  }
  .surface-hud {
    position: absolute;
    right: 8%;
    top: 52%;
    display: grid;
    gap: 7px; /* optical: spacing within the illustration, independent of the page grid. */
    width: 114px;
    pointer-events: auto;
  }
  .surface-legend {
    align-items: flex-end;
    display: flex;
    flex-direction: column;
    gap: 6px; /* optical: separate the two vertically stacked point keys. */
    font: 10px/1.2 var(--font-mono);
    color: var(--muted);
  }
  .surface-legend [data-kind] {
    align-items: center;
    display: flex;
    gap: 5px; /* optical: spacing within the illustration, independent of the page grid. */
    border: 0;
    padding: 0;
    font: inherit;
  }
  .surface-legend [data-kind].is-arriving {
    animation: legend-arrival 480ms ease-out;
  }
  @keyframes legend-arrival {
    0%,
    100% {
      text-shadow: none;
      color: var(--muted);
    }
    22% {
      text-shadow: 0 0 3px rgba(237, 244, 247, 0.55);
      color: #edf4f7;
    }
  }
  .surface-legend i {
    flex: none;
    border-radius: 50%;
    height: 6px;
    width: 6px;
  }
  .relaxed {
    background: #edf4f7;
  }
  .integer {
    background: #d3ad87;
  }
  .hud-readouts {
    position: relative;
    display: grid;
    gap: 4px; /* optical: spacing within the illustration, independent of the page grid. */
    padding-top: 10px; /* optical: spacing within the illustration, independent of the page grid. */
  }
  .hud-readouts::before {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    border-top: 1px solid rgba(163, 167, 173, 0.18);
    width: 78px; /* optical: the divider follows the compact Step group. */
  }
  .hud-row {
    position: relative;
    align-items: baseline;
    display: flex;
    gap: 10px; /* optical: keep the Step label close to its fixed-width value. */
    justify-content: flex-end;
    min-height: 20px;
  }
  .hud-label {
    font: 8.5px/1.4 var(--font-mono);
    white-space: nowrap;
    color: #8e949d;
  }
  .hud-value {
    position: relative;
    height: 1.3em;
    min-width: 5ch;
    overflow: hidden;
    font: 400 var(--readout-size, 13px)/1.3 var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    letter-spacing: 0;
    text-align: right;
    color: var(--value-ink);
  }
  .hud-value :global(.readout-current),
  .hud-value :global(.readout-old) {
    display: block;
    white-space: nowrap;
  }
  .hud-value :global(.readout-old) {
    inset: 0;
    position: absolute;
  }
  .hud-state {
    position: relative;
    height: 13px;
    min-height: 13px;
    overflow: hidden;
    font: 8px/1.4 var(--font-mono);
    text-align: right;
    white-space: nowrap;
    color: #9ba0a7;
  }

  @container (max-width:560px) {
    .surface-hud {
      right: 4%;
      top: 63%;
      gap: 7px; /* optical: spacing within the illustration, independent of the page grid. */
      width: 106px;
    }
    .surface-legend {
      gap: 5px; /* optical: keep the compact stacked legend clear of the input strip. */
      font-size: 9px;
    }
    .hud-label {
      font-size: 8px;
    }
    .hud-state {
      font-size: 8.5px;
    }
    .hud-readouts::before {
      content: '';
      position: absolute;
      right: 0;
      top: 0;
      border-top: 1px solid rgba(163, 167, 173, 0.18);
      width: 78px; /* optical: the divider follows the compact Step group. */
    }
    .hud-row {
      min-height: 18px;
    }
    .hud-readouts {
      gap: 3px; /* optical: spacing within the illustration, independent of the page grid. */
      padding-top: 9px; /* optical: spacing within the illustration, independent of the page grid. */
    }
  }
  .hud-state :global(:is(.hud-status-old, .hud-status-current)) {
    inset: 0;
    position: absolute;
    display: block;
    text-align: right;
    white-space: nowrap;
  }
</style>
<script>
  import './surface';
</script>
