---
import FigureEmbed from '../FigureEmbed.astro';
import { figurePaths } from '../../../data/research/figures';
---

<div class="l2o-figure-frame" data-l2o-frame>
  <FigureEmbed
    class="l2o-figure-canvas"
    src={figurePaths.l2o}
    title="Learning to generate integer solutions: recorded relaxed and integer predictions"
  />
</div>

<style>
  .l2o-figure-frame {
    width: 100%;
    container-type: inline-size;
  }
  :global(.l2o-figure-canvas) {
    display: block;
    border: 0;
    height: clamp(520px, 91.6667cqw, 539px);
    width: 100%;
    pointer-events: none;
  }
  .l2o-figure-frame[data-scaled] {
    height: calc(var(--l2o-canvas-height) * var(--l2o-scale));
  }
  .l2o-figure-frame[data-scaled] :global(.l2o-figure-canvas) {
    height: var(--l2o-canvas-height);
    width: var(--l2o-canvas-width);
    transform: scale(var(--l2o-scale));
    transform-origin: top left;
  }
  @container (max-width:560px) {
    :global(.l2o-figure-canvas) {
      height: calc(635px + 83.3333cqw);
    }
  }
</style>

<script>
  import './frame';
</script>
