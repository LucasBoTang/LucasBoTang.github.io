<div class="screen-reveal" data-screen-reveal>
  <span class="screen-trigger" data-reveal="unit"></span>
  <div class="screen-picture">
    <slot />
  </div>
</div>

<script>
  import { enhance } from '../../../lib/lifecycle';
  import { screenArrival } from './arrival';

  enhance('[data-screen-reveal]', (screen) => {
    const trigger = screen.querySelector('[data-reveal="unit"]');
    trigger?.addEventListener('arrival:prepare', (event) => {
      const group = (event as CustomEvent<Animation[]>).detail;
      const replacement = screenArrival(screen.closest('figure')!);
      if (!replacement) return;
      group.forEach((animation) => animation.cancel());
      group.splice(0, group.length, ...replacement);
    });
  });
</script>

<style>
  .screen-reveal {
    position: relative;
    margin-inline: calc(-1 * var(--gutter));
    overflow: clip;
    padding-inline: var(--gutter);
  }
  .screen-trigger {
    position: absolute;
    top: min(25%, 96px);
    height: 1px;
    width: 1px;
    pointer-events: none;
  }
</style>
