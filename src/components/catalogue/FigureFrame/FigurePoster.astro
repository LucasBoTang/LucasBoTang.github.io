---
import type { FigureKind } from '../../../data/research/figures';
import gpuWide from '../../../assets/figure-posters/gpu-wide.webp';
import gpuCompact from '../../../assets/figure-posters/gpu-compact.webp';
import l2oWide from '../../../assets/figure-posters/l2o-wide.webp';
import l2oCompact from '../../../assets/figure-posters/l2o-compact.webp';
import dflWide from '../../../assets/figure-posters/dfl-wide.webp';
import dflCompact from '../../../assets/figure-posters/dfl-compact.webp';

interface Props {
  kind: FigureKind;
}
const { kind } = Astro.props;
const posters = {
  gpu: { wide: gpuWide, compact: gpuCompact },
  l2o: { wide: l2oWide, compact: l2oCompact },
  dfl: { wide: dflWide, compact: dflCompact },
};
const { wide, compact } = posters[kind];
---

<!-- Real paused first frames, regenerated by npm run figures:posters; captions describe the artwork. -->
<picture data-figure-poster aria-hidden="true">
  <source data-poster-compact media="(max-width:720px)" srcset={compact.src} />
  <img
    src={wide.src}
    alt=""
    width={wide.width / 2}
    height={wide.height / 2}
    loading="lazy"
    decoding="async"
  />
</picture>
