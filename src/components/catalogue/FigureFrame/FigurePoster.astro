---
import type { ImageMetadata } from 'astro';
import phonePosters from '../../../data/research/figure-posters.json';
import type { FigureKind } from '../../../data/research/figures';
import gpuWide from '../../../assets/figure-posters/gpu-wide.webp';
import l2oWide from '../../../assets/figure-posters/l2o-wide.webp';
import dflWide from '../../../assets/figure-posters/dfl-wide.webp';

interface Props {
  kind: FigureKind;
}
const { kind } = Astro.props;
const wide = { gpu: gpuWide, l2o: l2oWide, dfl: dflWide }[kind];
const images = import.meta.glob<ImageMetadata>('../../../assets/figure-posters/*.webp', {
  eager: true,
  import: 'default',
});
const phones = phonePosters[kind].map((entry) => ({
  ...entry,
  image: images[`../../../assets/figure-posters/${entry.file}`],
}));
---

<!-- Real paused first frames, regenerated by npm run figures:posters; captions describe the artwork. -->
<picture data-figure-poster aria-hidden="true">
  {phones.map(({ maxViewport, image }) => (
    <source media={`(max-width:${maxViewport}px)`} srcset={image.src} />
  ))}
  <img
    src={wide.src}
    alt=""
    width={wide.width / 2}
    height={wide.height / 2}
    loading="lazy"
    decoding="async"
  />
</picture>
