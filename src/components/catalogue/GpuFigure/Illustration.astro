---
import { Image } from 'astro:assets';
import GpuMatrixAnimation from './Matrix.astro';
import matrix from '../../../data/research/rail4284-figure.json';
import products from '../../../data/research/rail4284-products.json';
import { gpuDieHighlights } from './gpu-hardware-layout';
import railwayPhoto from '../../../assets/research/railway-oakland.webp';
import gpuPlatform from '../../../assets/research/gpu-platform-refined.png';

interface Props {
  id?: string;
}
const { id = 'gpu-comparison' } = Astro.props;
const spillId = `${id}-spill`;
const reflectionId = `${id}-reflection`;
const polygonPoints = (points: readonly (readonly [number, number])[]) =>
  points.map((point) => point.join(',')).join(' ');
const dieHighlights = gpuDieHighlights.map(({ face, reflection }, index) => ({
  clipId: `${id}-die-${index}`,
  face: polygonPoints(face),
  reflection: polygonPoints(reflection),
}));

const variables = (matrix.columns / 1_000_000).toFixed(2);
const constraints = matrix.rows.toLocaleString('en-US');
const nonzeros = (matrix.nonzeros / 1_000_000).toFixed(2);
// This illustration animates the initial recorded vectors. Keep the full recording as source
// provenance while sending only the frame and global normalization the drawing actually uses.
const animationProducts = JSON.stringify({
  maxRms: products.maxRms,
  frames: [products.frames[0]],
}).replaceAll('<', '\\u003c');
---

<div class="gpu-container">
  <div class="gpu-composition">
    <script is:inline type="application/json" data-matrix-products set:html={animationProducts} />
    <div class="rail-scene">
      <Image
        src={railwayPhoto}
        widths={[640, 1280]}
        sizes="(max-width: 760px) 100vw, 560px"
        format="webp"
        quality={88}
        alt="Aerial view of the West Oakland rail yards."
        loading="eager"
        decoding="async"
      />
    </div>
    <h1 class="scene-title">
      <span>Large-scale optimization</span>
      <span>with GPUs</span>
    </h1>
    <div>
      <div class="matrix-artwork">
        <GpuMatrixAnimation maskId={`${id}-density`} />
        <div class="matrix-title">
          Railway Set-Covering LP <span>rail4284</span>
        </div>
      </div>
      <div class="matrix-stats">
        <span>
          {variables}M <small>variables</small>
        </span>
        <span>
          {constraints} <small>constraints</small>
        </span>
        <span>
          {nonzeros}M <small>nonzeros</small>
        </span>
      </div>
    </div>
    <div class="gpu-platform">
      <Image
        src={gpuPlatform}
        widths={[480, 960]}
        sizes="(max-width: 760px) 56vw, 315px"
        format="webp"
        quality={88}
        alt="Illustration of a multi-GPU computing platform."
        loading="lazy"
        decoding="async"
      />
      <svg
        class="gpu-lights"
        viewBox={`0 0 ${gpuPlatform.width} ${gpuPlatform.height}`}
        aria-hidden="true"
      >
        <defs>
          <radialGradient id={spillId}>
            <stop offset="0" stop-color="var(--paper)" stop-opacity=".5" />
            <stop offset=".35" stop-color="var(--signal-light)" stop-opacity=".16" />
            <stop offset="1" stop-color="var(--signal-light)" stop-opacity="0" />
          </radialGradient>
          <linearGradient id={reflectionId} x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="var(--blue)" stop-opacity=".75" />
            <stop offset=".55" stop-color="var(--signal-light)" stop-opacity=".95" />
            <stop offset="1" stop-color="var(--paper)" stop-opacity="1" />
          </linearGradient>
          {dieHighlights.map(({ clipId, face }) => (
            <clipPath id={clipId} clipPathUnits="userSpaceOnUse">
              <polygon points={face} />
            </clipPath>
          ))}
        </defs>
        {/* Matching activity on the outer PCB edge beside each exposed chip; illustrative, not a routing diagram. */}
        <g data-gpu-bus opacity="0" fill="none" stroke-linecap="round">
          {[
            { x: 0, y: 0 },
            { x: 296, y: -196 },
          ].map(({ x, y }) => (
            <g transform={`translate(${x} ${y})`}>
              <path
                d="M962 748 L1063 687"
                pathLength="100"
                stroke="var(--signal-light)"
                stroke-width="8"
                opacity=".15"
                stroke-dasharray="18 120"
                data-bus-pulse
              />
              <path
                d="M962 748 L1063 687"
                pathLength="100"
                stroke="var(--paper)"
                stroke-width="3.5"
                stroke-dasharray="18 120"
                data-bus-pulse
              />
              <path
                d="M967 756 L1068 695"
                pathLength="100"
                stroke="var(--signal-light)"
                stroke-width="2.5"
                opacity=".55"
                stroke-dasharray="12 120"
                data-bus-pulse
              />
            </g>
          ))}
        </g>
        <g data-gpu-chips opacity="0">
          {/* Both light layers share calibrated faces and remain clipped to the metal. */}
          {dieHighlights.map(({ clipId, face, reflection }) => (
            <g clip-path={`url(#${clipId})`}>
              <polygon points={face} fill="var(--signal-light)" opacity=".12" />
              <polygon points={reflection} fill={`url(#${reflectionId})`} />
            </g>
          ))}
        </g>
        <g data-gpu-lights opacity="0">
          {/* Paired indicators follow the matching dark front bevel on each module. */}
          {[
            { x: 500, y: 426 },
            { x: 796, y: 252 },
            { x: 720, y: 573 },
            { x: 1010, y: 391 },
          ].map(({ x, y }) => (
            <g transform={`translate(${x} ${y}) rotate(-29)`}>
              {[-17, 17].map((offset) => (
                <g transform={`translate(${offset} 0)`}>
                  <ellipse rx="25" ry="14" fill={`url(#${spillId})`} />
                  <rect x="-10" y="-4" width="20" height="8" rx="4" fill="var(--paper)" />
                </g>
              ))}
            </g>
          ))}
        </g>
      </svg>
    </div>
  </div>
</div>
<script>
  import { initializeGpuFigure } from './gpu-matrix-animation';
  for (const root of document.querySelectorAll<HTMLElement>('.gpu-composition')) {
    const recording = root.querySelector<HTMLScriptElement>('[data-matrix-products]');
    if (!recording?.textContent) throw new Error('GPU matrix recording is missing.');
    initializeGpuFigure(root, JSON.parse(recording.textContent));
  }
</script>

<style>
  .gpu-container {
    container-type: inline-size;
  }
  .gpu-composition {
    isolation: isolate;
    position: relative;
    aspect-ratio: 3/2;
    margin: 0;
    width: 100%;
  }
  .rail-scene {
    inset: 1% 0 auto 12%;
    position: absolute;
    height: 68%;
    overflow: hidden;
  }
  .rail-scene :global(img) {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
    width: 100%;
    filter: saturate(0.67) contrast(1.04) brightness(0.92);
    mask-image: linear-gradient(
      180deg,
      #000 6%,
      rgb(0 0 0/0.86) 25%,
      rgb(0 0 0/0.42) 58%,
      transparent 96%
    );
  }
  .rail-scene::after {
    content: '';
    inset: 0;
    position: absolute;
    background:
      linear-gradient(115deg, var(--gpu-ink-clear) 20%, var(--gpu-ink-soft) 60%),
      linear-gradient(180deg, transparent 25%, var(--gpu-ink-shade) 56%, var(--ink) 100%);
    pointer-events: none;
  }
  .scene-title {
    left: 0;
    position: absolute;
    top: 0;
    z-index: 1;
    margin: 0;
    padding: 0;
    font: 400 clamp(24px, 4.65cqw, 35px)/1.04 var(--font-serif);
    font-optical-sizing: auto;
    letter-spacing: -0.035em;
    color: var(--gpu-title);
  }
  .scene-title span {
    display: table;
    padding: 2px 17px 5px 0; /* optical: spacing within the GPU artwork */
    background: var(--ink);
  }
  .scene-title span + span {
    padding-bottom: 10px; /* optical: spacing within the GPU artwork */
    padding-top: 0;
    box-shadow: 0 -1px 0 var(--ink);
  }
  .matrix-artwork {
    left: -9.2%;
    position: absolute;
    top: 18.5%;
    width: 80%;
  }
  .matrix-title {
    bottom: 13.3%;
    left: 14.1667%;
    position: absolute;
    display: grid;
    gap: 3px; /* optical: spacing within the GPU artwork */
    max-width: none;
    padding: 5px 10px 7px 0; /* optical: spacing within the GPU artwork */
    font: 400 10px/1.35 var(--font-mono);
    background: var(--ink);
    color: var(--gpu-caption);
  }
  .matrix-title span {
    font-size: 10px;
    color: var(--gpu-instance);
  }
  .matrix-stats {
    left: 2.1%;
    position: absolute;
    top: 88%;
    align-items: baseline;
    column-gap: 16px; /* optical: spacing within the GPU artwork */
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    width: 54%;
    font: 400 14px/20px var(--font-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.025em;
    color: var(--gpu-dimension);
  }
  .matrix-stats > span {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    gap: 5px; /* optical: spacing within the GPU artwork */
    white-space: nowrap;
  }
  .matrix-stats small {
    font: 400 11px/16px var(--font);
    letter-spacing: 0;
    color: var(--gpu-dimension-label);
  }
  .gpu-platform {
    position: absolute;
    right: -1%;
    top: 47%;
    z-index: 3;
    width: 46%;
    text-align: right;
  }
  .gpu-platform :global(img) {
    display: block;
    height: auto;
    width: 100%;
    filter: saturate(0.73) brightness(0.9) contrast(1.06);
  }
  .gpu-lights {
    inset: 0;
    position: absolute;
    height: 100%;
    width: 100%;
    pointer-events: none;
  }
  @container (max-width:480px) {
    .gpu-composition {
      aspect-ratio: 1/1.13;
    }
    .rail-scene {
      left: 7%;
      height: 47%;
    }
    .rail-scene :global(img) {
      mask-image: linear-gradient(
        180deg,
        #000,
        rgba(0, 0, 0, 0.85) 27%,
        rgba(0, 0, 0, 0.24) 73%,
        transparent 100%
      );
    }
    .scene-title {
      font-size: clamp(20px, 6cqw, 26px);
    }
    .scene-title span {
      padding-right: 12px; /* optical: spacing within the GPU artwork */
    }
    .matrix-artwork {
      left: -6%;
      top: 24%;
      width: 107%;
    }
    .matrix-title {
      bottom: 13%;
      gap: 2px; /* optical: spacing within the GPU artwork */
      max-width: 57%;
      font-size: 9px;
    }
    .matrix-title span {
      font-size: 9px;
    }
    .gpu-platform {
      right: -3%;
      top: 57%;
      width: 57%;
    }
    .matrix-stats {
      left: 2.1%;
      top: 78%;
      align-items: stretch;
      display: flex;
      flex-direction: column;
      gap: 7px; /* optical: spacing within the GPU artwork */
      width: 46%;
      font-size: 12px;
      line-height: 17px;
    }
    .matrix-stats > span {
      align-items: baseline;
      flex-direction: row;
      gap: 8px; /* optical: spacing within the GPU artwork */
      justify-content: space-between;
    }
    .matrix-stats small {
      font-size: 10px;
      line-height: 17px;
    }
  }
  @container (max-width:320px) {
    .gpu-composition {
      aspect-ratio: 1/1.23;
    }
    .matrix-artwork {
      top: 26%;
    }
    .gpu-platform {
      top: 58%;
    }
    .matrix-stats {
      top: 78%;
      font-size: 11px;
    }
    .matrix-stats small {
      font-size: 9px;
    }
  }
</style>
