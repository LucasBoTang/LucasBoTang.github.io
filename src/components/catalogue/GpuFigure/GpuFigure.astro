---
import FigureEmbed from '../FigureEmbed.astro';
import { figurePaths } from '../../../data/research/figures';
---

<div class="figure-viewport">
  <div class="figure-frame">
    <FigureEmbed src={figurePaths.gpu} title="Large-scale optimization with GPUs" />
  </div>
</div>

<style>
  .figure-viewport {
    margin-inline: calc(-1 * var(--gutter));
    overflow: clip;
    padding-inline: var(--gutter);
  }

  .figure-frame {
    width: 100%;
    container-type: inline-size;
  }
  .figure-frame :global(iframe) {
    display: block;
    border: 0;
    height: 66.6667cqw;
    margin-left: -64px; /* optical: preserve the artwork's existing overhang */
    width: calc(100% + 128px);
    pointer-events: none;
  }
  @container (max-width:480px) {
    .figure-frame :global(iframe) {
      height: 113cqw;
    }
  }
  @container (max-width:320px) {
    .figure-frame :global(iframe) {
      height: 129cqw;
    }
  }
</style>
