---
import { figureVersion } from '../../../../scripts/figure-version.mjs';
import type { FigureSource } from './warmup-renderer';

// Warm figures during idle time; hover previews skip warm-up on touch screens.
interface Props {
  figures: FigureSource[];
  hover?: boolean;
}
const { figures, hover = false } = Astro.props;
---

<div
  data-figure-warmup-sources={JSON.stringify(figures)}
  data-figure-warmup-hover={hover || undefined}
  data-figure-warmup-version={figureVersion}
  hidden
></div>

<script>
  import './figure-warmup';
</script>
