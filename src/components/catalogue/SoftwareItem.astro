---
import ProjectWordmark from './ProjectWordmark/ProjectWordmark.astro';
import ResourceLinks from '../ui/ResourceLinks.astro';
import type { SoftwareEntry, SoftwareProject } from '../../data/software';

type Props = {
  /** Arrives as its own reading unit; turn off when a parent arrives as one with its siblings. */
  reveal?: boolean;
} & (
  { variant: 'project'; entry: SoftwareProject } | { variant: 'contribution'; entry: SoftwareEntry }
);
const { reveal = true, ...item } = Astro.props;
const { entry, variant } = item;
---

<article
  class:list={[
    'software-entry page-grid',
    { 'software-entry--compact': variant === 'contribution' },
  ]}
  id={entry.id}
  aria-labelledby={`${entry.id}-title`}
  data-reveal={reveal ? 'unit' : undefined}
  data-arrival={reveal ? 'cascade' : undefined}
  data-project-host={variant === 'project' || undefined}
  data-lit={variant === 'project' || undefined}
>
  <div class="entry-identity">
    {item.variant === 'project' ? (
      <ProjectWordmark name={entry.name} id={`${entry.id}-title`} wordmark={item.entry.wordmark} />
    ) : (
      <h3 class="heading-text" id={`${entry.id}-title`}>
        {entry.name}
      </h3>
    )}
    {entry.role && <p class="entry-role label-text">{entry.role}</p>}
  </div>
  <div class="entry-details">
    <p class="entry-description">{entry.description}</p>
    <ResourceLinks links={entry.links} context={entry.name} />
  </div>
</article>

<style>
  /* On Software every description starts on column 5: the name and role take columns 1 to 4,
     a project's description and links columns 5 to 11. The two start level,
     the wordmark's capitals with the description's: the tops of their line boxes, as both faces
     set their capitals the same depth below them. Rules part the entries. */
  .software-entry {
    --project-align: flex-start;
    --project-height: 0px;
    --project-origin: left center;
    --project-padding: 0px;
    align-items: start;
    padding-block: var(--step-48);
    scroll-margin-top: var(--anchor-section-offset);
  }
  /* The rule parting the entries starts with their text, on column 5. */
  .software-entry + .software-entry {
    background: linear-gradient(var(--rule-item), var(--rule-item)) right top /
      calc(100% - 4 * ((100% - 11 * var(--column-gap)) / 12 + var(--column-gap))) 1px no-repeat;
  }
  .entry-identity {
    grid-column: var(--zone-name);
  }
  .entry-role {
    margin: 0;
    padding-top: var(--step-16);
    color: var(--muted);
  }
  .entry-details {
    grid-column: var(--zone-hanging);
  }
  .entry-description {
    margin: 0 0 var(--step-24);
    color: var(--body-copy);
  }
  /* Contributions are a short list read at a glance: space parts them, not rules. */
  /* A contribution's name and description are one line each, so they share a baseline. */
  .software-entry.software-entry--compact {
    align-items: baseline;
    padding-block: var(--step-16);
  }
  .software-entry--compact + .software-entry--compact {
    background: none;
  }
  /* The group's label holds the space above its first entry (software.astro). */
  .software-entry.software-entry:first-of-type {
    padding-top: 0;
  }
  /* A contribution is a short list read at a glance: its name is set as a heading in the sans. */
  .software-entry--compact h3 {
    margin: 0;
    font-size: var(--type-heading);
    letter-spacing: var(--tracking-heading);
    line-height: var(--line-heading);
    color: var(--paper);
  }
  /* The name takes columns 1 to 4 and the one-line description columns 5 to 10; column 11 stays
     open, and the links sit at the far edge, on column 12. */
  .software-entry--compact .entry-identity {
    grid-column: var(--zone-name);
  }
  .software-entry--compact .entry-details {
    align-items: baseline;
    display: grid;
    grid-column: var(--zone-line);
    grid-template-columns: subgrid;
  }
  .software-entry--compact .entry-description {
    grid-column: 1 / -3;
  }
  .software-entry--compact .entry-details :global(.resource-links) {
    grid-column: -2 / -1;
  }
  .software-entry--compact .entry-description {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .software-entry:not(.software-entry--compact) + .software-entry {
      background: var(--item-rule);
    }
    .software-entry {
      row-gap: var(--step-24);
      padding-block: var(--step-32);
    }
    /* Short contributions read as a list: name and source share a row, the description follows. */
    .software-entry.software-entry--compact {
      grid-template-columns: minmax(0, 1fr) max-content;
      row-gap: var(--step-8);
      padding-block: var(--step-24);
    }
    .software-entry--compact .entry-identity {
      grid-column: 1;
      grid-row: 1;
    }
    .software-entry--compact .entry-details {
      display: contents;
    }
    .software-entry--compact .entry-description {
      grid-column: 1 / -1;
      grid-row: 2;
      margin: 0;
    }
    .software-entry--compact .entry-details :global(.resource-links) {
      align-self: center;
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
