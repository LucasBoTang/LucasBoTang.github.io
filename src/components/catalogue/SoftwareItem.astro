---
import ProjectWordmark from './ProjectWordmark/ProjectWordmark.astro';
import ResourceLinks from '../ui/ResourceLinks.astro';
import type { SoftwareEntry, SoftwareProject } from '../../data/software';

type Props = {
  /** Arrives as its own reading unit; turn off when a parent arrives as one with its siblings. */
  reveal?: boolean;
} & (
  { variant: 'project'; entry: SoftwareProject } | { variant: 'contribution'; entry: SoftwareEntry }
);
const { reveal = true, ...item } = Astro.props;
const { entry, variant } = item;
---

<article
  class:list={['software-entry', { 'software-entry--compact': variant === 'contribution' }]}
  id={entry.id}
  aria-labelledby={`${entry.id}-title`}
  data-reveal={reveal ? 'unit' : undefined}
  data-arrival={reveal ? 'cascade' : undefined}
  data-project-host={variant === 'project' || undefined}
  data-lit={variant === 'project' || undefined}
>
  <div class="entry-identity">
    {item.variant === 'project' ? (
      <ProjectWordmark name={entry.name} id={`${entry.id}-title`} wordmark={item.entry.wordmark} />
    ) : (
      <h3 id={`${entry.id}-title`}>{entry.name}</h3>
    )}
    {entry.role && <p class="entry-role">{entry.role}</p>}
  </div>
  <div class="entry-details">
    <p class="entry-description">{entry.description}</p>
    <ResourceLinks links={entry.links} context={entry.name} />
  </div>
</article>

<style>
  .software-entry {
    --project-align: flex-start;
    --project-height: 0px;
    --project-origin: left center;
    --project-padding: 0px;
    --project-size: clamp(2rem, 3.6vw, 2.5rem);
    align-items: start;
    column-gap: var(--software-gap);
    display: grid;
    grid-template-columns: var(--software-columns);
    border-top: var(--rule-line);
    padding-block: var(--space-7);
    scroll-margin-top: 2.5rem;
  }
  .entry-role {
    margin: 0;
    padding-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-compact);
    text-transform: uppercase;
    color: var(--muted);
  }
  .entry-description {
    margin: 0 0 var(--space-4);
    max-width: 60ch;
    font-size: var(--text-sm);
    line-height: var(--leading-prose);
    color: var(--body-copy);
  }
  .software-entry.software-entry--compact {
    padding-block: var(--space-5);
  }
  .software-entry--compact h3 {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: var(--leading-compact);
    color: var(--paper);
  }
  .software-entry--compact .entry-details {
    align-items: baseline;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .software-entry--compact .entry-description {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .software-entry {
      row-gap: var(--space-4);
      padding-block: var(--space-6);
    }
    .software-entry.software-entry--compact {
      row-gap: 0.7rem;
    }
    .software-entry--compact .entry-details {
      gap: 0.65rem;
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
