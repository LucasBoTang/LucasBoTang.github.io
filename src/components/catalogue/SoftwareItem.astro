---
import ProjectWordmark from './ProjectWordmark/ProjectWordmark.astro';
import ResourceLinks from '../ui/ResourceLinks.astro';
import type { SoftwareEntry, SoftwareProject } from '../../data/software';

type Props = {
  /** Arrives as its own reading unit; turn off when a parent arrives as one with its siblings. */
  reveal?: boolean;
} & (
  { variant: 'project'; entry: SoftwareProject } | { variant: 'contribution'; entry: SoftwareEntry }
);
const { reveal = true, ...item } = Astro.props;
const { entry, variant } = item;
---

<article
  class:list={[
    'software-entry page-grid',
    { 'software-entry--compact': variant === 'contribution' },
  ]}
  id={entry.id}
  aria-labelledby={`${entry.id}-title`}
  data-reveal={reveal ? 'unit' : undefined}
  data-arrival={reveal ? 'cascade' : undefined}
  data-project-host={variant === 'project' || undefined}
  data-lit={variant === 'project' || undefined}
>
  <div class="entry-identity">
    {item.variant === 'project' ? (
      <ProjectWordmark name={entry.name} id={`${entry.id}-title`} wordmark={item.entry.wordmark} />
    ) : (
      <h3 class="heading-text" id={`${entry.id}-title`}>
        {entry.name}
      </h3>
    )}
    {entry.role && <p class="entry-role label-text">{entry.role}</p>}
  </div>
  <div class="entry-details">
    <p class="entry-description">{entry.description}</p>
    <ResourceLinks links={entry.links} context={entry.name} />
  </div>
</article>

<style>
  /* The name and role on column 1, the description and links on column 6; the wordmark and the
     description share a first baseline. Rules part the entries, not the label from the first. */
  .software-entry {
    --project-align: flex-start;
    --project-height: 0px;
    --project-origin: left center;
    --project-padding: 0px;
    align-items: baseline;
    padding-block: var(--step-48);
    scroll-margin-top: 2.5rem;
  }
  .software-entry + .software-entry {
    background: var(--item-rule);
  }
  .entry-identity {
    grid-column: var(--zone-side);
  }
  .entry-role {
    margin: 0;
    padding-top: var(--step-16);
    color: var(--muted);
  }
  .entry-details {
    grid-column: var(--zone-main);
  }
  .entry-description {
    margin: 0 0 var(--step-24);
    color: var(--body-copy);
  }
  /* Contributions are a short list read at a glance: space parts them, not rules. */
  .software-entry.software-entry--compact {
    padding-block: var(--step-16);
  }
  .software-entry--compact + .software-entry--compact {
    background: none;
  }
  .software-entry--compact h3 {
    margin: 0;
    color: var(--paper);
  }
  .software-entry--compact .entry-details {
    align-items: baseline;
    display: grid;
    gap: var(--step-24);
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .software-entry--compact .entry-description {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .software-entry {
      row-gap: var(--step-16);
      padding-block: var(--step-32);
    }
    .software-entry.software-entry--compact {
      row-gap: var(--step-8);
    }
    .software-entry--compact .entry-details {
      gap: var(--step-8);
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
