---
import BibtexDialog from './BibtexDialog/BibtexDialog.astro';
import ResourceLinks from '../ui/ResourceLinks.astro';
import { profile } from '../../data/profile';
import { formatVenue, getPaperUrl, type Publication } from '../../data/publications';

interface Props {
  publication: Publication;
}
const { publication } = Astro.props;
const resources = publication.links.filter((link) => link.label !== 'Paper');
---

<li class="publication" id={publication.id} data-reveal="unit" data-arrival="cascade">
  <div class="publication-year">
    {publication.year}
    {publication.status === 'Preprint' && <span>{publication.status}</span>}
  </div>
  <div class="publication-body">
    <h3>
      <a class="publication-title-link" href={getPaperUrl(publication)}>
        {publication.title}
      </a>
    </h3>
    <p class="publication-authors">
      {publication.authors.map((author, index) => (
        <>
          {index > 0 && ', '}
          {author === profile.name ? <strong>{author}</strong> : author}
        </>
      ))}
    </p>
    <p class="publication-venue">{formatVenue(publication)}</p>
    <ResourceLinks links={resources} context={publication.title}>
      <BibtexDialog
        id={`${publication.id}-bibtex`}
        title={publication.title}
        bibtex={publication.bibtex}
      />
    </ResourceLinks>
  </div>
</li>

<style>
  .publication {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 4.5rem minmax(0, 1fr);
    border-top: var(--rule-line);
    padding-block: 1.6rem;
    scroll-margin-top: 2rem;
  }
  .publication-year {
    padding-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }
  .publication-year span {
    display: block;
    margin-top: 0.45rem;
  }
  h3 {
    margin: 0 0 0.7rem;
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: var(--leading-compact);
    text-wrap: pretty;
  }
  .publication-title-link {
    text-decoration: none;
  }
  .publication-authors,
  .publication-venue {
    margin: 0;
    font-size: var(--text-xs);
    line-height: var(--leading-prose);
    color: var(--muted);
  }
  .publication-authors strong {
    font-weight: 500;
    color: var(--paper);
  }
  .publication-venue {
    margin: 0.1rem 0 var(--space-3);
  }
  @media (max-width: 600px) {
    .publication {
      gap: 0.55rem;
      /* The column may not grow to the BibTeX's longest line, which scrolls instead. */
      grid-template-columns: minmax(0, 1fr);
    }
    .publication-year {
      align-items: center;
      display: flex;
      gap: 0.7rem;
    }
    .publication-year span {
      margin: 0;
    }
    h3 {
      font-size: var(--text-base);
    }
  }
</style>
