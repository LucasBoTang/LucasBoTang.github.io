---
import BibtexDialog from './BibtexDialog/BibtexDialog.astro';
import ResourceLinks from '../ui/ResourceLinks.astro';
import { profile } from '../../data/profile';
import { formatVenue, getPaperUrl, type Publication } from '../../data/publications';

interface Props {
  publication: Publication;
}
const { publication } = Astro.props;
const resources = publication.links.filter((link) => link.label !== 'Paper');
---

<li class="publication" id={publication.id} data-reveal="unit" data-arrival="cascade">
  <div class="publication-year label-text">
    {publication.year}
    {publication.status === 'Preprint' && <span>{publication.status}</span>}
  </div>
  <div class="publication-body">
    <h3 class="heading-text">
      <a class="publication-title-link" href={getPaperUrl(publication)}>
        {publication.title}
      </a>
    </h3>
    <p class="publication-authors">
      {publication.authors.map((author, index) => (
        <>
          {index > 0 && ', '}
          {author === profile.name ? <strong>{author}</strong> : author}
        </>
      ))}
    </p>
    <p class="publication-venue label-text">{formatVenue(publication)}</p>
    <ResourceLinks links={resources} context={publication.title}>
      <BibtexDialog
        id={`${publication.id}-bibtex`}
        title={publication.title}
        bibtex={publication.bibtex}
      />
    </ResourceLinks>
  </div>
</li>

<style>
  /* Spans Research's subgrid: the year hangs in column 5, the entry starts on column 6, and the
     two share a first baseline. */
  .publication {
    align-items: baseline;
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    border-top: 1px solid var(--rule-item);
    padding-block: var(--step-32);
    scroll-margin-top: 2rem;
  }
  .publication-year {
    color: var(--muted);
  }
  .publication-year span {
    display: block;
    margin-top: var(--step-8);
  }
  .publication-body {
    grid-column: 2 / -1;
    min-width: 0;
  }
  h3 {
    margin: 0;
    text-wrap: pretty;
  }
  .publication-title-link {
    text-decoration: none;
  }
  .publication-authors {
    margin: var(--step-16) 0 0;
    color: var(--muted);
  }
  .publication-authors strong {
    color: var(--paper);
  }
  /* A venue can run to two lines, so it takes the label's leading for blocks. */
  .publication-venue {
    margin: var(--step-8) 0 var(--step-24);
    line-height: var(--line-label-block);
    color: var(--muted);
  }
  /* Below 900px column 5 is narrower than "Preprint", so the year and status read as one line
     above the title instead. */
  @media (max-width: 900px) {
    .publication {
      display: block;
    }
    .publication-year {
      display: flex;
      gap: var(--step-8);
      margin-bottom: var(--step-8);
    }
    .publication-year span {
      margin: 0;
    }
  }
</style>
