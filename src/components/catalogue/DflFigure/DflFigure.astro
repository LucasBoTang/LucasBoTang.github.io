---
import FigureEmbed from '../FigureEmbed.astro';
import { figurePaths } from '../../../data/research/figures';
---

<div class="figure-viewport">
  <div class="figure-frame">
    <FigureEmbed src={figurePaths.dfl} title="Learning for better decisions" />
  </div>
</div>

<style>
  .figure-viewport {
    margin-inline: calc(-1 * var(--gutter));
    overflow: clip;
    padding-inline: var(--gutter);
  }

  .figure-frame {
    width: 100%;
    container-type: inline-size;
  }
  .figure-frame :global(iframe) {
    display: block;
    border: 0;
    height: 539px;
    margin-left: -32px; /* optical: preserve the artwork's existing overhang */
    width: calc(100% + 64px);
    pointer-events: none;
  }
  @container (max-width:420px) {
    .figure-frame :global(iframe) {
      height: 704px;
    }
  }
</style>
