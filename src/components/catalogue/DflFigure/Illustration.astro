---
import '@fontsource-variable/geist/wght-italic.css';
import { neon, neonMetrics } from './material';
---

<div
  class="dfl-composition"
  data-figure-drawn="pending"
  style={`--neon-body:${neon.body};--neon-core:${neon.core};--neon-halo:${neon.halo};--neon-line-width:${neonMetrics.structure}px;--neon-core-width:${neonMetrics.structure * neonMetrics.coreRatio}px`}
>
  <svg class="photo-clip-defs" width="0" height="0" aria-hidden="true">
    <defs>
      <clipPath id="dfl-photo-curve" clipPathUnits="objectBoundingBox">
        <path d="M0 0H1V1C.66 .96 .34 .47 0 .44Z" />
      </clipPath>
      <clipPath id="dfl-photo-curve-mobile" clipPathUnits="objectBoundingBox">
        <path d="M0 0H1V.98C.67 .91 .30 .44 0 .42Z" />
      </clipPath>
    </defs>
  </svg>
  <div class="dfl-photo">
    <img
      src="/images/research/decision-costs.webp"
      alt="Reviewing financial records with a calculator to assess costs"
      width="1400"
      height="2100"
      decoding="async"
    />
  </div>
  <div
    class="training-flow"
    role="group"
    aria-label="Decision-focused learning: input features enter a neural predictor, predicted costs define an optimization problem, the resulting decision is evaluated by a decision-focused loss, and a training signal propagates back into the predictor."
  >
    <h1 class="dfl-sign" aria-label="End-to-end Learning">
      <span class="sign-word" aria-hidden="true">
        End-to-end
      </span>
      <span class="sign-word" aria-hidden="true">
        Learning
      </span>
    </h1>
    <svg class="flow-wires" aria-hidden="true">
      <defs>
        <marker
          id="dfl-flow-arrow"
          viewBox="0 0 8 8"
          refX="7"
          refY="4"
          markerWidth="9"
          markerHeight="9"
          markerUnits="userSpaceOnUse"
          orient="auto"
        >
          <path d="M1 1 L7 4 L1 7" />
        </marker>
      </defs>
      <g data-connections></g>
    </svg>
    <p class="input-label flow-label">
      <span class="dfl-label-content">
        <span>Feature</span>
        <i>x</i>
      </span>
    </p>
    <div class="stage predict">
      <canvas
        data-module="predict"
        aria-label="Neural predictor, with forward and reverse signals"
        role="img"
      ></canvas>
      <p class="module-label">Neural network</p>
    </div>
    <p class="prediction-label flow-label">
      <span class="dfl-label-content">
        <span>Prediction</span>
        <i>
          <math xmlns="http://www.w3.org/1998/Math/MathML"><mover accent="true"><mi>c</mi><mo>^</mo></mover></math>
        </i>
      </span>
    </p>
    <div class="stage optimize">
      <canvas
        data-module="optimize-0"
        aria-label="A four-edge walk on a feasible polytope illustrates optimization"
        role="img"
      ></canvas>
      <p class="module-label">Differentiable optimization</p>
      <div class="opt-formula" role="img" aria-label="minimize c hat transpose w over w in Omega">
        <math xmlns="http://www.w3.org/1998/Math/MathML"><munder><mo>min</mo><mrow><mi>w</mi><mo>∈</mo><mi>Ω</mi></mrow></munder><mspace width=".4em"/><msup><mover accent="true"><mi>c</mi><mo>^</mo></mover><mo>⊤</mo></msup><mi>w</mi></math>
      </div>
    </div>
    <p class="decision-label flow-label">
      <span class="dfl-label-content">
        <span>Decision</span>
        <i>
          <math xmlns="http://www.w3.org/1998/Math/MathML"><mi>w</mi><mo>(</mo><mover accent="true"><mi>c</mi><mo>^</mo></mover><mo>)</mo></math>
        </i>
      </span>
    </p>
    <div class="stage evaluate">
      <canvas
        data-module="evaluate"
        aria-label="A balance weighing the costs of two decisions"
        role="img"
      ></canvas>
    </div>
    <p class="loss-node">Decision quality</p>
    <div class="dataset-module">
      <svg
        class="dataset-art"
        viewBox="0 0 140 80"
        role="img"
        aria-label="Dataset of paired features and observed costs"
      >
        <defs>
          <linearGradient id="data-glass" x1="0" y1="0" x2="1" y2="1">
            <stop stop-color={neon.body} stop-opacity=".10" />
            <stop offset="1" stop-color={neon.dim} stop-opacity=".025" />
          </linearGradient>
          <radialGradient id="data-node" cx="35%" cy="30%" r="70%">
            <stop stop-color={neon.core} />
            <stop offset=".35" stop-color={neon.body} />
            <stop offset="1" stop-color={neon.dim} />
          </radialGradient>
          <g id="data-tube-geometry">
            <path class="data-sheet-back" opacity=".48" d="M36 10H124V58" />
            <path class="data-sheet-middle" opacity=".48" d="M28 18H116V66" />
            <g class="data-sheet-front">
              <rect fill="var(--dataset-fill, none)" x="20" y="26" width="88" height="48" rx="2" />
              <path opacity=".3" d="M20 38H108 M52 38V74 M80 38V74" />
              <path
                opacity=".9"
                d="M29 32H43 M59 32H71 M88 32H99 M29 46H43 M29 56H39 M29 66H45 M60 46H71 M60 56H73 M60 66H69"
              />
              <g fill="url(#data-node)" stroke={neon.core} stroke-width={neonMetrics.nodeOutline}>
                <circle cx="94" cy="46" r={neonMetrics.nodeRadius} />
                <circle cx="94" cy="56" r={neonMetrics.nodeRadius} />
                <circle cx="94" cy="66" r={neonMetrics.nodeRadius} />
              </g>
            </g>
          </g>
        </defs>
        <use class="data-tube-halo" href="#data-tube-geometry" aria-hidden="true" />
        <use class="data-tube-body" href="#data-tube-geometry" aria-hidden="true" />
        <use class="data-tube-core" href="#data-tube-geometry" aria-hidden="true" />
      </svg>
      <p class="dataset-caption">Dataset</p>
    </div>
    <p class="truth-label flow-label">
      <span class="dfl-label-content">
        <span>Ground truth</span>
        <i>c</i>
      </span>
    </p>
  </div>
</div>

<style>
  .photo-clip-defs {
    position: absolute;
    pointer-events: none;
  }
  .dfl-composition {
    --flow-size: 13px;
    --label-leading: 20px;
    --math-size: 18px;
    --module-size: 14px;
    position: relative;
    margin: 0;
    color: var(--muted);
    container-type: inline-size;
  }
  .dfl-photo {
    isolation: isolate;
    position: relative;
    height: 202px;
    overflow: hidden;
    width: 100%;
    clip-path: url(#dfl-photo-curve);
  }
  .dfl-photo::after {
    content: '';
    inset: 0;
    position: absolute;
    background: var(--blue);
    mix-blend-mode: color;
    opacity: 0.18;
    pointer-events: none;
  }
  .dfl-photo img {
    bottom: 0;
    left: 0;
    position: absolute;
    height: 220px;
    object-fit: cover;
    object-position: 50% 40%;
    width: 100%;
    filter: saturate(0.7) brightness(0.86) contrast(0.96);
  }
  /* Keep the live sign in the open space between the network and dataset. */
  .dfl-sign {
    --sign-light: 0.2;
    left: 12%;
    position: absolute;
    top: 138px;
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 0.08em; /* optical: match the two-line sign's original visible line spacing. */
    justify-content: center;
    margin: 0;
    width: 26%;
    font: italic 200 clamp(19px, 3.7cqw, 24px)/1.14 var(--font);
    letter-spacing: -0.02em;
    pointer-events: none;
  }
  /* The thin glyph is the lit core; close blue spill gives it a tube's edge. */
  .sign-word {
    position: relative;
    display: block;
    text-shadow:
      0 0 0.5px var(--neon-body),
      0 0 3px color-mix(in srgb, var(--neon-halo) calc(28% + var(--sign-light) * 60%), transparent),
      0 0 7px color-mix(in srgb, var(--neon-halo) calc(8% + var(--sign-light) * 40%), transparent);
    -webkit-text-stroke: 0.2px var(--neon-body);
    white-space: nowrap;
    color: color-mix(in srgb, var(--neon-core) 68%, var(--neon-body));
    opacity: 0.83;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The two lines brighten out of phase while their tube shapes stay still. */
    .sign-word:first-child {
      opacity: calc(0.64 + var(--sign-light));
    }
    .sign-word:last-child {
      opacity: calc(1.04 - var(--sign-light));
    }
  }
  .training-flow {
    position: relative;
    height: 373px;
    margin-top: -36px; /* optical: spacing within the illustration */
  }
  .stage {
    position: absolute;
    min-width: 0;
    width: 34%;
  }
  .stage canvas {
    display: block;
    height: 140px;
    width: 100%;
  }
  .predict canvas {
    transform: translateY(12px);
  }
  .predict {
    left: 0;
    top: -24px;
    width: 30%;
  }
  .optimize {
    left: 38%;
    top: 4px;
    width: 44%;
  }
  .evaluate {
    right: 0;
    top: 218px;
    width: 32%;
  }
  .optimize canvas {
    height: 160px;
  }
  .opt-formula {
    left: calc(50% + 7px);
    position: absolute;
    top: 30px;
    align-items: flex-start;
    display: flex;
    gap: 7px; /* optical: spacing within the illustration */
    justify-content: center;
    width: 98px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.1;
    text-shadow:
      0 0 0.5px var(--neon-core),
      0 0 2.5px var(--neon-halo),
      0 0 6px var(--neon-halo);
    color: var(--neon-core);
    transform: translateX(-50%);
  }
  .flow-wires {
    inset: 0;
    position: absolute;
    height: 100%;
    overflow: visible;
    width: 100%;
    pointer-events: none;
  }
  .flow-wires :global(path) {
    fill: none;
  }
  /* Glows are wider, fainter strokes beneath the lines (flow-layout.ts), never blur filters,
     which the GPU would compile a shader for on the figure's first frame. */
  .flow-wires :global(.wire) {
    opacity: 0.6;
    stroke: var(--muted);
    stroke-width: 1.05px;
  }
  .flow-wires :global(.wire-halo) {
    opacity: 0.16;
    stroke: var(--muted);
    stroke-linecap: round;
    stroke-width: 3px;
  }
  .flow-wires marker path {
    opacity: 1;
    stroke: var(--muted);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.05px;
    vector-effect: non-scaling-stroke;
  }
  .flow-wires :global(.signal) {
    opacity: 0;
    stroke: var(--paper);
    stroke-linecap: round;
  }
  .flow-wires :global(.signal-core) {
    stroke-width: 2.2;
  }
  .flow-wires :global(.signal-halo) {
    opacity: 0.4;
    stroke-width: 6.5px;
  }
  .flow-label {
    position: absolute;
    z-index: 2;
    margin: 0;
    padding: 3px 6px; /* optical: backing around labels on the wires. */
    font: var(--flow-size)/18px var(--font-mono);
    text-shadow:
      0 0 0.6px color-mix(in srgb, var(--muted) 28%, transparent),
      0 0 2px color-mix(in srgb, var(--muted) 12%, transparent);
    white-space: nowrap;
    background: transparent;
    color: var(--muted);
  }
  .input-label {
    left: 8px;
    top: 60px;
  }
  .loss-node {
    position: absolute;
    right: 0;
    top: 331px;
    margin: 0;
    padding: 0;
    width: 34%;
    text-align: center;
    white-space: nowrap;
  }
  .dataset-module {
    left: 14%;
    position: absolute;
    top: 250px;
    height: 80px;
    width: 140px;
  }
  .dataset-art {
    display: block;
    height: 80px;
    overflow: visible;
    width: 100%;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* The tube's halo is a wider, fainter copy beneath it rather than a blur filter. */
  .data-tube-halo {
    --dataset-fill: none;
    opacity: 0.3;
    stroke: var(--neon-halo);
    stroke-width: calc(var(--neon-line-width) + 3.5px);
  }
  .data-tube-body {
    --dataset-fill: url(#data-glass);
    stroke: var(--neon-body);
    stroke-width: var(--neon-line-width);
  }
  .data-tube-core {
    stroke: var(--neon-core);
    stroke-width: var(--neon-core-width);
  }
  .dataset-caption {
    left: 0;
    position: absolute;
    top: -25px;
    margin: 0;
    width: 100%;
    text-align: center;
  }
  .module-label {
    left: 0;
    position: absolute;
    top: 140px;
    margin: 0;
    width: 100%;
    text-align: center;
    white-space: nowrap;
  }
  .predict .module-label {
    top: 130px;
  }
  .optimize .module-label {
    top: 160px;
    white-space: normal;
  }
  .dfl-label-content {
    align-items: center;
    display: inline-flex;
    flex-direction: column;
    gap: 1px; /* optical: labels sit just above the mathematical symbol. */
    font-family: var(--font-mono);
    font-size: var(--flow-size);
    font-weight: 400;
    letter-spacing: normal;
    white-space: nowrap;
  }
  .dfl-label-content > span {
    padding: 0;
    line-height: 15px;
    background: var(--ink);
  }
  .dfl-label-content > i {
    display: block;
    padding: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--math-size);
    font-style: italic;
    font-weight: 400;
    line-height: 18px;
    background: var(--ink);
    box-shadow: 0 0 0 4px var(--ink);
  }
  .decision-label .dfl-label-content {
    align-items: baseline;
    flex-direction: row;
    gap: 5px; /* optical: name and symbol read as one phrase. */
  }
  .prediction-label .dfl-label-content > span,
  .truth-label .dfl-label-content > span {
    background: transparent;
  }
  .flow-label :global(.label-glow) {
    inset: 3px 6px auto;
    position: absolute;
    color: var(--paper);
    mask-image: linear-gradient(
      var(--sweep-angle, 90deg),
      transparent calc(var(--sweep, -40%) - 24%),
      #000 var(--sweep, -40%),
      transparent calc(var(--sweep, -40%) + 24%)
    );
    opacity: 0;
    pointer-events: none;
  }
  .module-label,
  .dataset-caption,
  .loss-node {
    font: var(--module-size)/var(--label-leading) var(--font-mono);
    text-shadow:
      0 0 0.5px #a4b6ce55,
      0 0 3px #7d9fc950;
    color: #a4b6ce;
  }
  .training-flow :global(.module-name-glow) {
    inset: 0;
    position: absolute;
    color: var(--paper);
    mask-image: linear-gradient(
      90deg,
      transparent calc(var(--name-sweep, -25%) - 22%),
      #000 var(--name-sweep, -25%),
      transparent calc(var(--name-sweep, -25%) + 22%)
    );
    opacity: 0;
    pointer-events: none;
  }
  .opt-formula math,
  .dfl-label-content math {
    font-family: Georgia, serif;
    font-size: inherit;
    color: inherit;
    math-style: compact;
  }
  @container (max-width:420px) {
    .dfl-photo {
      height: 162px;
      clip-path: url(#dfl-photo-curve-mobile);
    }
    .dfl-photo img {
      height: 176px;
    }
    .dfl-sign {
      left: 5%;
      top: 167px;
      width: 50%;
      font-size: clamp(16px, 5.5cqw, 21px);
    }
    .training-flow {
      height: 568px;
      margin-top: -26px; /* optical: spacing within the illustration */
    }
    .stage canvas {
      height: 144px;
    }
    .predict {
      width: 54%;
    }
    .optimize {
      left: 36%;
      top: 160px;
      width: 64%;
    }
    .optimize canvas {
      height: 160px;
    }
    .evaluate {
      left: auto;
      right: 0;
      top: 412px;
      width: 50%;
    }
    .evaluate canvas {
      height: 160px;
    }
    .dataset-module {
      left: 0;
    }
    .input-label .dfl-label-content {
      gap: 2px; /* optical: separate the words from the narrow vertical wire. */
    }
    .prediction-label .dfl-label-content > span {
      transform: translate(14px, -10px);
    }
    .truth-label .dfl-label-content {
      align-items: baseline;
      flex-direction: row;
      gap: 5px; /* optical: keep Ground truth to the left of c on phones only. */
    }
    .truth-label .dfl-label-content > span {
      background: var(--ink);
    }
    .predict .module-label {
      top: 132px;
    }
    .optimize .module-label {
      top: 150px;
    }
  }
  @container (max-width:290px) {
    .module-label,
    .dataset-caption,
    .loss-node {
      font-size: 13px;
    }
    .opt-formula {
      width: 88px;
    }
  }
</style>
<script>
  import './render';
</script>
