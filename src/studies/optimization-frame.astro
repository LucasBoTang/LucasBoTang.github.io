<style>
  .frame-studies {
    padding-block: var(--step-32) var(--step-64);
  }
  .frame-study + .frame-study {
    margin-top: 5rem;
  }
  .frame-caption {
    margin: 0 0 var(--step-32);
    font-size: var(--type-label);
    color: var(--type-dim);
  }
  .frame-study h2 {
    margin-bottom: var(--step-24);
  }
  .frame-composition {
    display: grid;
    gap: clamp(1.25rem, 1.7vw, 1.75rem);
    grid-template-columns: minmax(0, 1fr) 18.75rem;
    padding-right: clamp(0.75rem, 1.5vw, 1.5rem);
  }
  .frame-copy {
    max-width: 72ch;
  }
  .frame-copy p {
    margin: 0 0 var(--step-16);
    font-size: var(--type-body);
    line-height: var(--line-body);
    color: var(--muted);
  }
  .frame-action {
    display: flex;
    margin-top: var(--step-16);
  }
  .frame-sign {
    display: block;
    height: auto;
    width: 100%;
  }
  @media (max-width: 720px) {
    .frame-composition {
      gap: var(--step-32);
      grid-template-columns: 1fr;
      padding-right: 0;
    }
    .frame-sign {
      width: 88%;
    }
    .frame-study + .frame-study {
      margin-top: var(--step-64);
    }
  }
</style>
