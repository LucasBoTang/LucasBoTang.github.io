---
// Snapshot of the About section in the variants studied before the site settled on the SVG
// DecisionSign (src/components/home/AboutSection/).
import '@fontsource-variable/roboto-flex';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import { routes } from '../../data/navigation';
import { profile } from '../../data/profile';

interface Props {
  variant?: 'type' | 'negative';
  study?: boolean;
  texture?: 'default' | 'moire' | 'pixel';
}
const { variant = 'type', study = false, texture = 'default' } = Astro.props;
const sectionId = study ? `about-${variant}-${texture}` : 'about';
---

<section
  class:list={[
    'about shell',
    {
      'about--negative': variant === 'negative',
      'about--moire': texture === 'moire',
      'about--pixel': texture === 'pixel',
    },
  ]}
  style={`--about-contour: url(#${sectionId}-contour)`}
  id={sectionId}
  aria-labelledby={`${sectionId}-title`}
  data-opening-part={study ? undefined : 'about'}
>
  <h2 class="section-label" id={`${sectionId}-title`}>
    About
  </h2>
  {variant === 'negative' && (
    <svg width="0" height="0" aria-hidden="true" class="contour-definition">
      <defs>
        <clipPath id={`${sectionId}-contour`} clipPathUnits="objectBoundingBox">
          <path d="M0 0H1V.925L.975 .975H.655L.55 .916H.045C.018 .916 .001 .873 0 .80Z" />
        </clipPath>
      </defs>
    </svg>
  )}
  <p class="about-fields">
    {texture === 'pixel' && <canvas class="pixel-sign" aria-hidden="true"></canvas>}
    {texture === 'moire' && <i class="moire-plane" aria-hidden="true"></i>}
    <span class="field-optimization">Mathematical Optimization</span>
    <span class="field-learning">Machine Learning</span>
    <span class="field-computing">GPU Computing</span>
  </p>
  <div class="about-copy">
    <p>
      I am a postdoctoral associate at MIT Sloan, working with{' '}
      <a class="text-link text-link--inline" href={profile.supervisor.url}>
        <span class="link-label">{profile.supervisor.name}</span>
      </a>
      .
    </p>
    <p>
      I develop machine learning methods and scalable algorithms for mathematical optimization, with
      a focus on decision-focused learning, learning to optimize, and GPU-accelerated optimization.
    </p>
    <div class="about-action">
      <ArrowLink href={routes.about}>More about me</ArrowLink>
    </div>
  </div>
</section>

<script>
  import './pixel-sign';
</script>

<style>
  .about {
    column-gap: clamp(1.75rem, 3.5vw, 2.75rem);
    display: grid;
    grid-template-columns: minmax(0, 34%) minmax(0, 1fr);
    margin-top: var(--step-48);
    scroll-margin-top: 2rem;
  }
  .about > h2 {
    grid-column: 1 / -1;
    margin-bottom: var(--step-24);
  }
  .about-fields {
    grid-column: 1;
    margin: 0;
    font-family: 'Roboto Flex Variable', sans-serif;
    font-weight: 460;
    letter-spacing: -0.035em;
    line-height: 1.04;
    color: var(--blue);
    container-type: inline-size;
  }
  .about-fields span {
    display: block;
    width: max-content;
    white-space: nowrap;
  }
  .field-optimization {
    font-size: 12.4cqi;
    font-variation-settings:
      'wdth' 55,
      'opsz' 72,
      'wght' 460;
  }
  .field-learning {
    margin-top: 0.4em;
    font-size: 13.32cqi;
    font-variation-settings:
      'wdth' 100,
      'opsz' 72,
      'wght' 460;
    color: var(--type-light);
  }
  .field-computing {
    margin-top: 0.4em;
    font-size: 12.025cqi;
    font-variation-settings:
      'wdth' 130,
      'opsz' 72,
      'wght' 460;
    color: var(--type-dim);
  }
  .contour-definition {
    position: absolute;
    pointer-events: none;
  }
  .about--negative {
    column-gap: 4rem;
    grid-template-columns: 18.75rem minmax(0, 1fr);
  }
  .about--negative .about-fields {
    isolation: isolate;
    position: relative;
    align-self: start;
    padding: 0 0 0.6rem;
    width: 100%;
    line-height: 0.72;
  }
  .about--negative .about-fields::before {
    content: '';
    inset: 0;
    position: absolute;
    z-index: -1;
    background: var(--blue);
    clip-path: var(--about-contour);
  }
  .about.about--moire .about-fields::before {
    display: none;
  }
  .about--pixel {
    column-gap: clamp(1.25rem, 1.7vw, 1.75rem);
    grid-template-columns: minmax(0, 1fr) 18.75rem;
    padding-right: clamp(0.75rem, 1.5vw, 1.5rem);
  }
  .about--pixel .about-fields {
    grid-column: 2;
    grid-row: 2;
  }
  .about.about--pixel .about-copy {
    grid-column: 1;
    grid-row: 2;
    max-width: 72ch;
  }
  .about.about--pixel .about-fields::before {
    display: none;
  }
  .pixel-sign {
    inset: 0;
    position: absolute;
    z-index: -1;
    height: 100%;
    width: 100%;
    clip-path: var(--about-contour);
    pointer-events: none;
  }
  .moire-plane {
    inset: 0;
    position: absolute;
    z-index: -1;
    overflow: hidden;
    background-color: var(--ink);
    background-image:
      repeating-linear-gradient(0deg, var(--grid-light) 0 1.4px, transparent 1.4px 3.6px),
      repeating-linear-gradient(90deg, var(--grid-dark) 0 1.3px, transparent 1.3px 3.6px);
    clip-path: var(--about-contour);
  }
  .moire-plane::after {
    content: '';
    inset: -35%;
    position: absolute;
    background-image:
      repeating-linear-gradient(0deg, var(--ink) 0 1.8px, transparent 1.8px 3.85px),
      repeating-linear-gradient(90deg, var(--ink) 0 1.7px, transparent 1.7px 3.85px);
    opacity: 0.42;
    animation: moire-drift 18s ease-in-out infinite alternate;
    transform: rotate(3deg);
  }
  @keyframes moire-drift {
    from {
      transform: translate(-3px, -2px) rotate(2deg);
    }
    to {
      transform: translate(3px, 2px) rotate(5deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .moire-plane::after {
      animation: none;
    }
  }
  .about--negative .about-fields span {
    left: 50%;
    position: relative;
    color: var(--ink);
    transform: translateX(-50%);
  }
  .about--negative .field-optimization {
    font-size: 11.27cqi;
    font-variation-settings:
      'wdth' 55,
      'opsz' 72,
      'wght' 680;
  }
  .about--negative .field-learning {
    font-size: 13.31cqi;
    font-variation-settings:
      'wdth' 100,
      'opsz' 72,
      'wght' 680;
  }
  .about--negative .field-computing {
    font-size: 12.59cqi;
    font-variation-settings:
      'wdth' 130,
      'opsz' 72,
      'wght' 680;
  }
  .about--negative .about-copy {
    max-width: 58ch;
    padding-top: 0;
  }
  .about--negative .about-action {
    margin-top: var(--step-16);
  }
  .about-copy {
    grid-column: 2;
    max-width: 46ch;
    padding-top: 0.35rem;
  }
  .about-copy p {
    margin: 0 0 var(--step-16);
    font-size: var(--type-body);
    font-weight: 400;
    line-height: var(--line-body);
    color: var(--muted);
  }
  .about-copy .text-link--inline {
    white-space: nowrap;
  }
  .about-action {
    display: flex;
    justify-content: flex-start;
    margin-top: var(--step-24);
  }
  @media (max-width: 720px) {
    .about,
    .about--negative {
      gap: 0;
      grid-template-columns: 1fr;
      margin-top: 2.75rem;
    }
    .about-fields {
      margin-bottom: var(--step-32);
      width: 88%;
    }
    .about--negative .about-fields {
      padding: 0 0 0.6rem;
      width: 88%;
    }
    .about-copy,
    .about--negative .about-copy {
      grid-column: 1;
      padding-top: 0;
    }
    .about--pixel {
      grid-template-columns: 1fr;
      padding-right: 0;
    }
    .about--pixel .about-fields {
      grid-column: 1;
      grid-row: 3;
      margin-bottom: 0;
      margin-top: var(--step-32);
    }
  }
</style>
