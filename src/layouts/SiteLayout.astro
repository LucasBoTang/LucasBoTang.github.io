---
import { getImage } from 'astro:assets';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import '../styles/links.css';
import '../styles/motion.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { PageId } from '../data/navigation';
import { profile } from '../data/profile';
import portrait from '../assets/bo-tang.jpg';
import { theme, themeVariables } from '../data/theme';
import displayFont from '@fontsource-variable/syne/files/syne-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  page?: PageId;
  /** Shell width shared by header, content and footer; Research keeps the wide default. */
  shell?: 'wide' | 'reading';
}
const { title, description, page, shell = 'wide' } = Astro.props;

// Absolute URLs need the public origin; without SITE_URL the build omits them.
const canonical = page && Astro.site && new URL(Astro.url.pathname, Astro.site).href;
const shareImage =
  Astro.site &&
  new URL((await getImage({ src: portrait, width: 800, format: 'jpg' })).src, Astro.site).href;
---

<!doctype html>
<html lang="en" style={themeVariables}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme.ink} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary" />
    {!page && <meta name="robots" content="noindex" />}
    {page === 'home' && (
      <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:width" content="800" />}
    {shareImage && (
      <meta
        property="og:image:height"
        content={String(Math.round((800 * portrait.height) / portrait.width))}
      />
    )}
    {shareImage && <meta property="og:image:alt" content={`Portrait of ${profile.name}`} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body data-shell={shell}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader page={page} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
