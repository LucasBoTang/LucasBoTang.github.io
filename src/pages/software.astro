---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/site/PageHeader/PageHeader.astro';
import SoftwareItem from '../components/catalogue/SoftwareItem.astro';
import { softwareGroups } from '../data/software';

const description = 'Open-source libraries for learning and optimization.';
---

<SiteLayout
  title="Software — Bo Tang"
  description={description}
  page="software"
  shell="reading"
  opening="reveal"
>
  <div class="shell software-page">
    <PageHeader title="Software" description={description} variant="editorial" />
    {softwareGroups.map((group) => (
      // Each project is lit on its own; the contributions, a short list, are lit as one.
      <section
        class="software-group"
        id={group.id}
        aria-labelledby={`${group.id}-title`}
        data-lit={group.variant !== 'project' || undefined}
      >
        <h2 class="section-label" id={`${group.id}-title`} data-reveal="unit">
          {group.title}
        </h2>
        {group.variant === 'project' ? (
          group.entries.map((entry) => <SoftwareItem entry={entry} variant={group.variant} />)
        ) : (
          // Contributions are a short list read at a glance, so they arrive together.
          <div data-reveal="unit" data-arrival="cascade">
            {group.entries.map((entry) => (
              <SoftwareItem entry={entry} variant={group.variant} reveal={false} />
            ))}
          </div>
        )}
      </section>
    ))}
  </div>
</SiteLayout>

<style>
  .software-page {
    --software-columns: var(--reading-label-column) minmax(0, 1fr);
    --software-gap: var(--reading-column-gap);
  }
  .software-group {
    scroll-margin-top: 2.5rem;
  }
  .software-group + .software-group {
    margin-top: var(--space-8);
  }
  h2 {
    margin-bottom: var(--space-3);
    line-height: var(--leading-compact);
  }
  @media (max-width: 720px) {
    .software-page {
      --software-columns: minmax(0, 1fr);
    }
    .software-group + .software-group {
      margin-top: var(--space-6);
    }
  }
</style>
