---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/site/PageHeader/PageHeader.astro';
import ResearchSection from '../components/catalogue/ResearchSection.astro';
import { researchAreas } from '../data/research';
---

<SiteLayout
  title="Research — Bo Tang"
  description="Publications on first-order methods for GPU-accelerated optimization, learning to optimize, and decision-focused learning."
  page="research"
  opening="reveal"
>
  <div class="shell research-page">
    <PageHeader
      title="Research"
      description="GPU-accelerated optimization, learning to optimize, and decision-focused learning."
    />
    <div class="research-layout page-grid">
      <div class="research-index" data-reveal="lead">
        <nav aria-label="Research themes" data-reading-index>
          {researchAreas.map((area) => (
            <a class="text-link" href={`#${area.id}`}>
              <span class="link-label" data-tear={area.title}>
                {area.title}
              </span>
            </a>
          ))}
        </nav>
      </div>
      <div class="research-content">
        {researchAreas.map((area) => (
          <ResearchSection area={area} />
        ))}
      </div>
    </div>
  </div>
</SiteLayout>

<script>
  import '../lib/reading-index';
</script>

<style>
  /* The theme index holds columns 1 to 4. The content takes columns 5 to 11 as a subgrid: each
     publication hangs its year in column 5, and everything else starts on column 6. */
  .research-index {
    position: sticky;
    top: 2rem;
    align-self: start;
    grid-column: var(--zone-index);
  }
  .research-index nav {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    gap: var(--step-16);
  }
  /* Navigation, as the header's is: mono at the Body size. */
  .research-index nav a {
    isolation: isolate;
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--type-body);
    line-height: var(--line-body);
    color: var(--muted);
  }
  .research-content {
    display: grid;
    grid-column: var(--zone-hanging);
    grid-template-columns: subgrid;
  }
  .research-index nav a:is(:hover, :focus-visible) {
    color: var(--blue);
  }
  /* The theme being read (reading-index.ts) is cut out of a blue tag: a plate with two corners
     clipped off reaches a step past the words on either side, and the words take the page's ink.
     A small square rides beside it, as the marks beside the home name do. Moving on, the plate
     wipes in from the left. The signal never quite holds: now and then a band of the tag itself,
     plate and letters together, tears loose and slides sideways, and the whole line jumps. */
  .research-index nav a::before,
  .research-index nav a::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }
  .research-index nav a::before {
    inset: 0 calc(-1 * var(--step-8));
    background: var(--blue);
    clip-path: polygon(
      0.5rem 0,
      100% 0,
      100% calc(100% - 0.5rem),
      calc(100% - 0.5rem) 100%,
      0 100%,
      0 0.5rem
    );
    transform: scaleX(0);
    transform-origin: left;
  }
  .research-index nav a::after {
    right: calc(-1 * var(--step-16) - 0.375rem);
    top: calc(50% - 0.1875rem);
    height: 0.375rem;
    width: 0.375rem;
    background: var(--blue);
    opacity: 0;
  }
  /* The torn band: a copy of the tag, shown through one strip at a time (clip-path). */
  .research-index nav a :global(.link-label)::before {
    content: attr(data-tear);
    inset: 0 calc(-1 * var(--step-8));
    position: absolute;
    padding-inline: var(--step-8);
    white-space: nowrap;
    background: var(--blue);
    color: var(--ink);
    opacity: 0;
    pointer-events: none;
  }
  .research-index nav a[aria-current='location'] {
    color: var(--ink);
  }
  .research-index nav a[aria-current='location'] :global(.link-label) {
    background-size: 0 1px;
  }
  .research-index nav a[aria-current='location']::before {
    transform: none;
  }
  .research-index nav a[aria-current='location']::after {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .research-index nav a {
      transition: color 360ms cubic-bezier(0.33, 1, 0.68, 1);
    }
    .research-index nav a::before {
      transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .research-index nav a[aria-current='location'] {
      animation: index-line-jump 3.6s steps(1, end) 1.2s infinite;
    }
    .research-index nav a[aria-current='location'] :global(.link-label)::before {
      animation: index-band-tear 3.6s steps(1, end) 1.2s infinite;
    }
    /* The square never rests, as the marks beside the home name do. */
    .research-index nav a[aria-current='location']::after {
      animation: signal-marks-hop 2.7s steps(1, end) infinite;
    }
    /* Small tears of about 50ms come at uneven moments through each 3.6s cycle (14%, 33%, 52%),
       and a fuller one ends it (85% to 88%). */
    @keyframes index-line-jump {
      0%,
      34.5%,
      86%,
      89%,
      100% {
        transform: none;
      }
      33% {
        transform: translateX(2px);
      }
      87% {
        transform: translateX(-3px);
      }
    }
    @keyframes index-band-tear {
      0%,
      15.5%,
      53.5%,
      88%,
      100% {
        opacity: 0;
        transform: none;
      }
      14% {
        clip-path: inset(44% 0 38%);
        opacity: 1;
        transform: translateX(5px);
      }
      52% {
        clip-path: inset(18% 0 64%);
        opacity: 1;
        transform: translateX(-4px);
      }
      85% {
        clip-path: inset(30% 0 42%);
        opacity: 1;
        transform: translateX(10px);
      }
      86% {
        clip-path: inset(58% 0 16%);
        opacity: 1;
        transform: translateX(-7px);
      }
      87% {
        clip-path: inset(36% 0 46%);
        opacity: 1;
        transform: translateX(4px);
      }
    }
  }
  @media (max-width: 720px) {
    .research-layout,
    .research-content {
      display: block;
    }
    .research-index {
      position: static;
      border-bottom: var(--rule-line);
      margin-bottom: var(--step-48);
      padding-bottom: var(--step-48);
    }
    .research-index nav {
      gap: var(--step-16);
    }
    .research-index nav a {
      color: var(--blue);
    }
    /* On phones the index is a plain list: no tag, every theme in blue. */
    .research-index nav a::before,
    .research-index nav a::after {
      display: none;
    }
    .research-index nav a[aria-current='location'] {
      color: var(--blue);
    }
  }
</style>
