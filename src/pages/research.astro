---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import PageHeader from '../components/site/PageHeader/PageHeader.astro';
import ResearchSection from '../components/catalogue/ResearchSection.astro';
import { profile } from '../data/profile';
import { researchAreas } from '../data/research';
---

<SiteLayout
  title="Research — Bo Tang"
  description="Publications on first-order methods for GPU-accelerated optimization, learning to optimize, and decision-focused learning."
  page="research"
  opening="reveal"
>
  <div class="shell research-page">
    <PageHeader
      title="Research"
      description="GPU-accelerated optimization, learning to optimize, and decision-focused learning."
      variant="editorial"
    />
    <div class="research-layout">
      <div class="research-index" data-reveal="lead">
        <nav aria-label="Research themes" data-reading-index>
          {researchAreas.map((area) => (
            <a class="text-link" href={`#${area.id}`}>
              <span class="link-label">{area.title}</span>
            </a>
          ))}
        </nav>
        <div class="cv-reference">
          <ArrowLink href={profile.cv} download>
            CV <span class="cv-reference-file-type">(PDF)</span>
          </ArrowLink>
        </div>
      </div>
      <div class="research-content">
        {researchAreas.map((area) => (
          <ResearchSection area={area} />
        ))}
      </div>
    </div>
  </div>
</SiteLayout>

<script>
  import '../lib/reading-index';
</script>

<style>
  /* The themes read as one line beside the wide layout; phones keep the header's own measure. */
  .research-page {
    --page-header-measure: none;
  }
  /* The same two columns as every reading page, so the content starts on one line site-wide. */
  .research-layout {
    column-gap: var(--reading-column-gap);
    display: grid;
    grid-template-columns: var(--reading-label-column) minmax(0, 1fr);
  }
  .research-index {
    position: sticky;
    top: 2rem;
    align-self: start;
  }
  .research-index nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 25ch;
  }
  .research-index nav a {
    position: relative;
    font-size: var(--text-xs);
    line-height: var(--leading-body);
    color: var(--muted);
  }
  .research-index nav a:is(:hover, :focus-visible) {
    color: var(--blue);
  }
  /* The theme being read (reading-index.ts): its link turns blue, and a short tick comes out in the
     margin beside it, as a mark beside a contents page. */
  .research-index nav a::before {
    content: '';
    left: -1.6em;
    position: absolute;
    top: 0.8em;
    height: 1px;
    width: 0.9em;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: right;
  }
  .research-index nav a[aria-current='location'] {
    color: var(--blue);
  }
  .research-index nav a[aria-current='location']::before {
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .research-index nav a {
      transition: color 360ms cubic-bezier(0.33, 1, 0.68, 1);
    }
    .research-index nav a::before {
      transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
    }
  }
  .cv-reference {
    display: inline-block;
    margin-top: 2.8rem;
    font-size: var(--text-xs);
  }
  .cv-reference-file-type {
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .research-layout {
      display: block;
    }
    .research-index {
      position: static;
      border-bottom: var(--rule-line);
      margin-bottom: var(--space-10);
      padding-bottom: var(--space-10);
    }
    .research-index nav {
      gap: var(--space-3);
      max-width: none;
    }
    .research-index nav a {
      color: var(--blue);
    }
    .research-index nav a::before {
      display: none;
    }
    .cv-reference {
      margin-top: var(--space-6);
    }
  }
</style>
