---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import PageHeader from '../components/PageHeader.astro';
import ResearchSection from '../components/ResearchSection.astro';
import { profile } from '../data/profile';
import { researchAreas } from '../data/research';
---

<SiteLayout
  title="Research — Bo Tang"
  description="Publications on decision-focused learning, learning to optimize, and first-order methods for GPU-accelerated optimization."
  page="research"
>
  <div class="shell">
    <PageHeader
      title="Research"
      description="Decision-focused learning, learning to optimize, and GPU-accelerated optimization."
    />
    <div class="research-layout">
      <div class="research-index">
        <nav aria-label="Research themes">
          {researchAreas.map((area) => (
            <a class="text-link" href={`#${area.id}`}>
              <span class="link-label">{area.title}</span>
            </a>
          ))}
        </nav>
        <div class="cv-reference">
          <ArrowLink href={profile.cv} download>
            CV <span>(PDF)</span>
          </ArrowLink>
        </div>
      </div>
      <div class="research-content">
        {researchAreas.map((area) => (
          <ResearchSection area={area} />
        ))}
      </div>
    </div>
  </div>
</SiteLayout>

<style>
  .research-layout {
    column-gap: clamp(3rem, 7vw, 7rem);
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    border-top: var(--rule-line);
    padding-top: 3.2rem;
  }
  .research-index {
    position: sticky;
    top: 2rem;
    align-self: start;
  }
  .research-index nav {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 25ch;
  }
  .research-index nav a {
    font-size: var(--text-xs);
    line-height: var(--leading-body);
    color: var(--muted);
  }
  .research-index nav a:is(:hover, :focus-visible) {
    color: var(--blue);
  }
  .cv-reference {
    display: inline-block;
    margin-top: 2.8rem;
    font-size: var(--text-xs);
    color: var(--paper);
  }
  .cv-reference span {
    font-size: var(--text-xs);
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .research-layout {
      column-gap: 2.5rem;
      grid-template-columns: 180px minmax(0, 1fr);
    }
  }
  @media (max-width: 720px) {
    .research-layout {
      display: block;
      padding-top: 1.5rem;
    }
    .research-index {
      position: static;
      border-bottom: var(--rule-line);
      margin-bottom: 2.5rem;
      padding-bottom: 2.5rem;
    }
    .research-index nav {
      gap: 0.75rem;
      max-width: none;
    }
    .research-index nav a {
      color: var(--blue);
    }
    .cv-reference {
      margin-top: 1.5rem;
    }
  }
</style>
