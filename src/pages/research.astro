---
import '../components/ui/ResearchLanes/index-signal.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/site/PageHeader/PageHeader.astro';
import ResearchSection from '../components/catalogue/ResearchSection.astro';
import ResearchLanes from '../components/ui/ResearchLanes/ResearchLanes.astro';
import FigureWarmup from '../components/catalogue/FigureWarmup/FigureWarmup.astro';
import { researchAreas } from '../data/research';
import { figureWarmups } from '../data/research/figures';
---

<SiteLayout
  title="Research — Bo Tang"
  description="Publications on first-order methods for GPU-accelerated optimization, learning to optimize, and decision-focused learning."
  page="research"
  opening="reveal"
>
  <FigureWarmup figures={figureWarmups} />
  <div class="shell">
    <PageHeader
      title="Research"
      description="The questions I study, and the papers that answer them."
      mobileBreakBefore="and"
      typing={{ thinkBefore: { questions: 100, answer: 160 } }}
    />
    <div class="research-layout page-grid">
      <div class="research-index" data-reveal="lead">
        <nav aria-label="Research themes" data-reading-index>
          <ResearchLanes areas={researchAreas} variant="index" />
        </nav>
      </div>
      <div class="research-content">
        {researchAreas.map((area) => (
          <ResearchSection area={area} />
        ))}
      </div>
    </div>
  </div>
</SiteLayout>

<script>
  import '../components/ui/ResearchLanes/research-lanes';
  import '../lib/reading-index';
</script>

<style>
  /* The theme index holds columns 1 to 4. The content takes columns 5 to 11 as a subgrid: each
     publication hangs its year in column 5, and everything else starts on column 6. */
  /* As on every page, a section rule opens the content beneath the page header. */
  .research-layout {
    border-top: var(--rule-line);
    padding-top: var(--step-64);
  }
  .research-index {
    position: sticky;
    top: calc(
      var(--site-header-height) + var(--site-header-safe-area) + var(--site-header-fade) +
        var(--step-16)
    );
    align-self: start;
    grid-column: var(--zone-index);
  }
  .research-index nav {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    gap: var(--step-16);
  }
  /* Navigation, as the header's is: mono at the Body size. */
  .research-index nav :global(a) {
    isolation: isolate;
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--type-body);
    line-height: var(--line-body);
    color: var(--muted);
  }
  .research-content {
    display: grid;
    grid-column: var(--zone-hanging);
    grid-template-columns: subgrid;
  }
  /* A theme pointed at turns blue, as every word does; the underline is for words already blue. */
  .research-index nav :global(a):is(:hover, :focus-visible) {
    color: var(--blue);
  }
  .research-index nav :global(a):is(:hover, :focus-visible) :global(.link-label) {
    background-size: 0 1px;
  }
  /* The selected theme uses a blue tag with two clipped corners. Its plate wipes in from
     the left; index-signal.css supplies the fine ink and plate disturbance. */
  .research-index nav :global(a)::before {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }
  .research-index nav :global(a)::before {
    inset: 0 calc(-1 * var(--step-8));
    background: var(--blue);
    clip-path: polygon(
      0.5rem 0,
      100% 0,
      100% calc(100% - 0.5rem),
      calc(100% - 0.5rem) 100%,
      0 100%,
      0 0.5rem
    );
    transform: scaleX(0);
    transform-origin: left;
  }
  /* The torn band: a copy of the tag, shown through one strip at a time (clip-path). */
  .research-index nav :global(a) :global(.link-label)::before {
    content: attr(data-tear);
    inset: 0 calc(-1 * var(--step-8));
    position: absolute;
    padding-inline: var(--step-8);
    white-space: nowrap;
    background: var(--blue);
    color: var(--ink);
    opacity: 0;
    pointer-events: none;
  }
  .research-index nav :global(a[aria-current='location']) {
    color: var(--ink);
  }
  .research-index nav :global(a[aria-current='location']) :global(.link-label) {
    background-size: 0 1px;
  }
  .research-index nav :global(a[aria-current='location'])::before {
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .research-index nav :global(a) {
      transition: color 360ms cubic-bezier(0.33, 1, 0.68, 1);
    }
    .research-index nav :global(a)::before {
      transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
    }
  }
  @media (max-width: 720px) {
    .research-layout,
    .research-content {
      display: block;
    }
    .research-layout {
      padding-top: var(--step-32);
    }
    .research-index {
      position: static;
      border-bottom: var(--rule-line);
      margin-bottom: var(--step-32);
      padding-bottom: var(--step-32);
    }
    .research-index nav :global(a) {
      font-size: var(--type-lane);
      line-height: var(--line-lane);
      color: var(--blue);
    }
    /* Phone lanes keep a clean light field without the desktop tag. */
    .research-index nav :global(a)::before,
    .research-index nav :global(a) :global(.link-label)::before {
      display: none;
    }
    .research-index nav :global(a[aria-current='location']) {
      color: var(--blue);
      animation: none;
    }
  }
</style>
