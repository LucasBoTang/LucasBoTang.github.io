---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/site/PageHeader/PageHeader.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import { profile } from '../data/profile';
---

<SiteLayout
  title="About — Bo Tang"
  description="Bo Tang's research on machine learning and mathematical optimization, and his background at MIT, the University of Toronto, and PNNL."
  page="about"
  opening="reveal"
>
  <div class="shell about-page">
    <PageHeader title="About" description="Who I am and what I work on." />
    <section
      class="about-row about-section page-grid"
      aria-labelledby="research-heading"
      data-reveal="unit"
    >
      <h2 class="section-label" id="research-heading">
        Research
      </h2>
      <div class="about-prose">
        <p>
          My research lies at the intersection of machine learning and mathematical optimization. I
          focus on large-scale optimization on modern computing hardware, learning to optimize, and
          learning for decision-making.
        </p>
        <p>
          I investigate how optimization algorithms can make effective use of modern hardware,
          particularly GPUs, to solve larger problems more efficiently. My work on learning to
          optimize explores how learning can guide and accelerate the solution of complex
          optimization problems. In decision-focused learning, I study how predictive models can be
          trained for the quality of the decisions they inform.
        </p>
        <p>
          I aim to bring together algorithms, AI, and modern hardware to make optimization more
          useful in practice. Faster and more scalable methods can support planning with more
          realistic models and enable timely decisions as conditions change. By building these
          advances into open-source computational infrastructure, I hope to broaden where
          optimization can be used and improve the decisions it supports.
        </p>
      </div>
    </section>
    <section
      class="about-row about-section page-grid"
      aria-labelledby="background-heading"
      data-reveal="unit"
    >
      <h2 class="section-label" id="background-heading">
        Background
      </h2>
      <div class="about-prose">
        <p>
          I am a postdoctoral associate at the MIT Sloan School of Management, working with{' '}
          <a class="text-link text-link--inline" href={profile.supervisor.url}>
            <span class="link-label">{profile.supervisor.name}</span>
          </a>
          {'.'}
        </p>
        <p>
          I received my PhD in Operations Research from the University of Toronto in 2025, advised
          by{' '}
          <a class="text-link text-link--inline" href={profile.doctoralAdvisor.url}>
            <span class="link-label">{profile.doctoralAdvisor.name}</span>
          </a>
          {'.'}
        </p>
        <p>
          In 2023, I was a research intern at Pacific Northwest National Laboratory, where I studied
          learning-based correction methods for mixed-integer nonlinear optimization.
        </p>
      </div>
    </section>
    <section
      class="about-row about-section page-grid"
      aria-labelledby="cv-heading"
      data-reveal="unit"
    >
      <h2 class="section-label" id="cv-heading">
        CV
      </h2>
      <div class="about-prose">
        <ArrowLink href={profile.cv} download>
          Download <span class="about-cv-file-type">(PDF)</span>
        </ArrowLink>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  /* Each section opens with a rule, the label a step under it on column 1 and the prose beside it
     on column 6; sections stand 160px apart, as they do on every page. */
  .about-section {
    align-items: baseline;
    border-top: var(--rule-line);
    padding-top: var(--step-24);
  }
  .about-section + .about-section {
    margin-top: var(--step-160);
  }
  h2 {
    grid-column: var(--zone-side);
  }
  .about-prose {
    grid-column: var(--zone-main);
  }
  p {
    margin: 0;
    color: var(--muted);
  }
  .about-prose p + p {
    margin-top: var(--step-24);
  }
  .about-cv-file-type {
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .about-section {
      row-gap: var(--step-24);
    }
    .about-section + .about-section {
      margin-top: var(--step-96);
    }
  }
</style>
