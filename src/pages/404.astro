---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/site/PageHeader/PageHeader.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import { routes } from '../data/navigation';
---

<SiteLayout title="Page not found — Bo Tang" description="This page could not be found.">
  <div class="shell">
    <PageHeader
      title="Page not found"
      description="The address may have changed, or the page may no longer exist."
    />
    <div class="page-grid">
      <div class="not-found-action">
        <ArrowLink href={routes.home}>Back to home</ArrowLink>
      </div>
    </div>
  </div>
</SiteLayout>

<style>
  .not-found-action {
    grid-column: var(--zone-main);
  }
</style>
